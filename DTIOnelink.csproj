<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Must stay generated: the generated assembly info is what lets the
         app find its `dotnet user-secrets` (the Brevo key) in Development. -->
    <UserSecretsId>81f52bae-6fbe-464d-9092-51da00906edb</UserSecretsId>
  </PropertyGroup>


  <PropertyGroup>
    <RootNamespace>DTIOneLink</RootNamespace>
    <AssemblyName>DTIOneLink</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Add when wiring up SQL Server via EF Core -->
    <!-- <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.*" /> -->
    <!-- <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.*" /> -->
  </ItemGroup>

  <!-- DTIOneLink.Tests is its own project nested in this folder; without this,
       the default **/*.cs glob below pulls its files into this project too. -->
  <ItemGroup>
    <Compile Remove="DTIOneLink.Tests/**/*.cs" />
    <Content Remove="DTIOneLink.Tests/**/*" />
    <None Remove="DTIOneLink.Tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.86.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

</Project>
