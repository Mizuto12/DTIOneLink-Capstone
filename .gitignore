# Build output (recreated by every build)
bin/
obj/
bin-verify/
verify-bin/
verify-obj/
.build-obj/
.build-output/
publish/

# Files users upload while using the app (proofs of work)
App_Data/ProofUploads/

# Data Protection key ring — generated locally (by tests) and on the host
# (on first run); machine-specific key material, never shared between them.
App_Data/keys/

# Editor / tool leftovers
.vs/
*.user
cookies.txt

# Production secrets are generated by the deploy workflow from GitHub secrets
appsettings.Production.json
App_Data/database-update-error.txt
