@model List<DTIOneLink.Models.TimeLog>
@{
    var userRole = Context.Session.GetString("UserRole");
    Layout = userRole == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : userRole == "Admin"
            ? "~/Views/Admin/AdminLayout.cshtml"
            : "~/Views/Employee/EmployeeLayout.cshtml";
    ViewData["Title"] = "Time Logs";
}

@section Styles {
    <link rel="stylesheet" href="~/css/time-logs.css" asp-append-version="true">
}

<div class="time-logs-page">

<div class="page-header">
    <h1>Time Logs</h1>
    <p class="page-subtitle">Your own sign-in and sign-out history.</p>
</div>

<div class="table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Time In</th>
                <th>Time Out</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="3">No time logs yet.</td>
                </tr>
            }
            else
            {
                @foreach (var log in Model)
                {
                    var timeIn = DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(log.TimeInUtc);
                    var timeOut = log.TimeOutUtc.HasValue
                        ? DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(log.TimeOutUtc.Value)
                        : (DateTime?)null;

                    <tr>
                        <td>@timeIn.ToString("MMM d, yyyy")</td>
                        <td>@timeIn.ToString("h:mm tt")</td>
                        <td>@(timeOut.HasValue ? timeOut.Value.ToString("h:mm tt") : "Still signed in")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

</div>
