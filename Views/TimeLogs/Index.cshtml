@model List<DTIOneLink.Models.TimeLog>
@{
    var userRole = Context.Session.GetString("UserRole");
    Layout = userRole == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : userRole == "Admin"
            ? "~/Views/Admin/AdminLayout.cshtml"
            : "~/Views/Employee/EmployeeLayout.cshtml";
    ViewData["Title"] = "Time Logs";
}

@section Styles {
    <link rel="stylesheet" href="~/css/time-logs.css" asp-append-version="true">
}

<main class="time-logs-page">

    <header class="page-header">
        <div class="header-left">
            <div class="icon-badge">
                <span class="material-symbols-outlined">schedule</span>
            </div>
            <div>
                <h1 class="page-title">Time Logs</h1>
                <p class="page-subtitle">Your own sign-in and sign-out history.</p>
            </div>
        </div>
    </header>

    <form class="time-logs-filter" method="get">
        <div class="field">
            <label for="filter-from">From</label>
            <input id="filter-from" name="from" type="date" value="@ViewBag.FromDate" max="@DateTime.Today.ToString("yyyy-MM-dd")">
        </div>
        <div class="field">
            <label for="filter-to">To</label>
            <input id="filter-to" name="to" type="date" value="@ViewBag.ToDate" max="@DateTime.Today.ToString("yyyy-MM-dd")">
        </div>
        <div class="filter-actions">
            <button class="btn btn-primary" type="submit">
                <span class="material-symbols-outlined">filter_list</span> Filter
            </button>
            @if (ViewBag.FromDate != null || ViewBag.ToDate != null)
            {
                <a class="btn btn-outline" href="@Url.Action("Index")">Clear</a>
            }
        </div>
    </form>

    @{
        var filterActive = ViewBag.FromDate != null || ViewBag.ToDate != null;
    }

    <section class="card">
        <div class="table-wrapper">
            <table>
                <colgroup>
                    <col style="width:34%">
                    <col style="width:33%">
                    <col style="width:33%">
                </colgroup>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Time In</th>
                        <th>Time Out</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr class="empty-row">
                            <td colspan="3" class="empty-state">
                                <span class="material-symbols-outlined">history</span>
                                @if (filterActive)
                                {
                                    <span>No time logs in this date range.</span>
                                    <a class="empty-state-clear" href="@Url.Action("Index")">Clear the filter</a>
                                }
                                else
                                {
                                    <span>No time logs yet.</span>
                                }
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model)
                        {
                            var timeIn = DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(log.TimeInUtc);
                            var timeOut = log.TimeOutUtc.HasValue
                                ? DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(log.TimeOutUtc.Value)
                                : (DateTime?)null;

                            <tr class="pill-row">
                                <td data-label="Date" class="title-cell">@timeIn.ToString("MMM d, yyyy")</td>
                                <td data-label="Time In">@timeIn.ToString("h:mm tt")</td>
                                <td data-label="Time Out">
                                    @if (timeOut.HasValue)
                                    {
                                        @timeOut.Value.ToString("h:mm tt")
                                    }
                                    else
                                    {
                                        <span class="badge badge-active">
                                            <span class="badge-dot"></span> Still signed in
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

</main>
