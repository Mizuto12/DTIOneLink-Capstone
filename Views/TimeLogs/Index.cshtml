@model List<DTIOneLink.Models.TimeLog>
@using DTIOneLink.Services
@{
    var userRole = Context.Session.GetString("UserRole");
    Layout = userRole == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : userRole == "Admin"
            ? "~/Views/Admin/AdminLayout.cshtml"
            : "~/Views/Employee/EmployeeLayout.cshtml";
    ViewData["Title"] = "Time Logs";

    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    // This page is primarily an audit trail of account access — when did
    // this account sign in and out — not a certified attendance record.
    // The session list below still computes no duration (per-session length,
    // daily/weekly/monthly totals): forensic precision, not "hours worked."
    // The separate, explicitly-labeled Daily Summary section further down
    // IS a deliberate exception — an informal, opt-in first-in/last-out
    // reference (Say, OPD, chat on 2026-10-23) — kept visually and
    // structurally distinct from the office's real DTR: no AM/PM split, no
    // computed Late/Undertime, no leave handling, since it can't tell an
    // absence from an approved leave day. FullTimestamp carries the exact
    // millisecond value, shown only on hover, for the same reason an audit
    // trail cares about exact timestamps — forensic precision, not "hours worked."
    string FullTimestamp(DateTime phTime) => phTime.ToString("MMM d, yyyy 'at' h:mm:ss.fff tt");

    // A session stays grouped under the day it started, but an overnight
    // session's time-out needs a visible marker — otherwise "11:05 PM ->
    // 9:48 AM" reads as a time-logic error instead of a timestamp that
    // crossed midnight. This flags which calendar date, not how long.
    string OvernightSuffix(DateTime timeInPh, DateTime timeOutPh) =>
        timeOutPh.Date > timeInPh.Date ? $" +{(timeOutPh.Date - timeInPh.Date).Days}d" : "";

    var today = TimeZoneHelper.PhilippineToday;
    string DateLabel(DateTime d) =>
        d == today ? "Today" :
        d == today.AddDays(-1) ? "Yesterday" :
        d.ToString("MMM d, yyyy");
    string Iso(DateTime d) => d.ToString("yyyy-MM-dd");

    // Each day's sessions, newest day first (logs already arrive newest
    // session first from the controller, so grouping preserves that order).
    var days = Model
        .Select(log => new
        {
            Log = log,
            TimeInPh = TimeZoneHelper.ToPhilippineTime(log.TimeInUtc),
            TimeOutPh = log.TimeOutUtc.HasValue ? TimeZoneHelper.ToPhilippineTime(log.TimeOutUtc.Value) : (DateTime?)null
        })
        .GroupBy(x => x.TimeInPh.Date)
        .Select(g => new
        {
            Date = g.Key,
            Sessions = g.ToList(),
            HasActive = g.Any(x => x.TimeOutPh == null),
        })
        .ToList();

    string PageUrl(int p) => Url.Action("Index", new { from = ViewBag.FromDate, to = ViewBag.ToDate, page = p }) ?? "";

    // Daily Summary rows — earliest sign-in and latest sign-out per day,
    // built from the same `days` grouping above. A day with an open
    // (still-active) session has no "latest time out" yet, shown as such
    // rather than guessed at. Hours Logged sums each session's own elapsed
    // time (an in-progress session counts up to now), matching the running
    // total already shown elsewhere on this page for an active day.
    var nowPh = TimeZoneHelper.ToPhilippineTime(DateTime.UtcNow);
    string FormatHours(TimeSpan span)
    {
        var totalMinutes = Math.Max(0, (int)span.TotalMinutes);
        return $"{totalMinutes / 60}h {totalMinutes % 60}m";
    }
    var dailySummaries = days.Select(day =>
    {
        var earliestIn = day.Sessions.Min(x => x.TimeInPh);
        var latestOut = day.HasActive ? (DateTime?)null : day.Sessions.Max(x => x.TimeOutPh!.Value);
        var totalSpan = day.Sessions.Aggregate(TimeSpan.Zero, (sum, x) => sum + ((x.TimeOutPh ?? nowPh) - x.TimeInPh));
        return new { day.Date, EarliestIn = earliestIn, LatestOut = latestOut, StillActive = day.HasActive, Total = totalSpan };
    }).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/time-logs.css" asp-append-version="true">
}

<main class="time-logs-page">

    <div class="time-logs-toolbar">
        <form class="time-logs-filter" method="get">
            <div class="field">
                <label for="filter-from">From</label>
                <input id="filter-from" name="from" type="date" value="@ViewBag.FromDate" max="@Iso(today)">
            </div>
            <div class="field">
                <label for="filter-to">To</label>
                <input id="filter-to" name="to" type="date" value="@ViewBag.ToDate" max="@Iso(today)">
            </div>
            <div class="filter-actions">
                <button class="btn btn-primary" type="submit">
                    <span class="material-symbols-outlined">filter_list</span> Filter
                </button>
                @if (ViewBag.FromDate != null || ViewBag.ToDate != null)
                {
                    <a class="btn btn-outline" href="@Url.Action("Index")">Clear</a>
                }
            </div>
        </form>
        @if (dailySummaries.Any())
        {
            <button type="button" class="btn btn-outline" id="toggle-daily-summary" aria-expanded="false">
                <span class="material-symbols-outlined">assessment</span> Daily Summary
            </button>
        }
    </div>

    @if (dailySummaries.Any())
    {
        <section class="daily-summary-card card" id="daily-summary" hidden>
            <div class="daily-summary-head">
                <div>
                    <h2>Daily Summary</h2>
                    <p class="daily-summary-note">
                        Informal reference only — earliest sign-in and latest sign-out per day, not a certified
                        attendance record. A day with no entry here may mean absence, approved leave, or offline
                        work; this page has no way to tell those apart.
                    </p>
                </div>
                <button type="button" class="btn btn-outline" id="export-daily-summary">
                    <span class="material-symbols-outlined">download</span> Export CSV
                </button>
            </div>
            <div class="daily-summary-table-wrap">
                <table class="daily-summary-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Earliest Time In</th>
                            <th>Latest Time Out</th>
                            <th>Total Hours Logged</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in dailySummaries)
                        {
                            <tr data-date="@Iso(s.Date)"
                                data-earliest-in="@s.EarliestIn.ToString("yyyy-MM-dd HH:mm")"
                                data-latest-out="@(s.LatestOut.HasValue ? s.LatestOut.Value.ToString("yyyy-MM-dd HH:mm") : "")"
                                data-hours="@s.Total.TotalHours.ToString("0.00")">
                                <td>@DateLabel(s.Date)</td>
                                <td>@s.EarliestIn.ToString("h:mm tt")</td>
                                <td>
                                    @if (s.LatestOut.HasValue)
                                    {
                                        @s.LatestOut.Value.ToString("h:mm tt")
                                    }
                                    else
                                    {
                                        <span class="badge badge-active"><span class="badge-dot"></span> Still signed in</span>
                                    }
                                </td>
                                <td>@FormatHours(s.Total)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @{
        var filterActive = ViewBag.FromDate != null || ViewBag.ToDate != null;
    }

    @if (!Model.Any())
    {
        <section class="card">
            <div class="empty-state">
                <span class="material-symbols-outlined">history</span>
                @if (filterActive)
                {
                    <span>No time logs in this date range.</span>
                    <a class="empty-state-clear" href="@Url.Action("Index")">Clear the filter</a>
                }
                else
                {
                    <span>No time logs yet.</span>
                }
            </div>
        </section>
    }
    else
    {
        const int visibleCap = 5;
        <div class="day-stack">
            @foreach (var day in days)
            {
                <section class="day-card" data-day-card data-cap="@visibleCap">
                    <div class="day-card__head">
                        <span class="day-card__date-group">
                            <span class="day-card__date">@DateLabel(day.Date)</span>
                            @if (day.HasActive)
                            {
                                <span class="live-pill">LIVE</span>
                            }
                        </span>
                        <span class="day-card__meta">
                            @day.Sessions.Count session@(day.Sessions.Count == 1 ? "" : "s")
                        </span>
                    </div>
                    @for (var i = 0; i < day.Sessions.Count; i++)
                    {
                        var s = day.Sessions[i];
                        <div class="session-row"@(i >= visibleCap ? Html.Raw(" hidden data-extra-session") : null)>
                            <span class="time" title="@FullTimestamp(s.TimeInPh)">@s.TimeInPh.ToString("h:mm tt")</span>
                            <span class="arrow material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                            @if (s.TimeOutPh.HasValue)
                            {
                                var overnight = OvernightSuffix(s.TimeInPh, s.TimeOutPh.Value);
                                <span class="time" title="@FullTimestamp(s.TimeOutPh.Value)">@s.TimeOutPh.Value.ToString("h:mm tt")</span>
                                @if (overnight != "")
                                {
                                    <span class="overnight-tag" title="Signed out @s.TimeOutPh.Value.ToString("MMM d") — crossed midnight">@overnight</span>
                                }
                            }
                            else
                            {
                                <span class="badge badge-active">
                                    <span class="badge-dot"></span> Still signed in
                                </span>
                            }
                        </div>
                    }
                    @if (day.Sessions.Count > visibleCap)
                    {
                        <button type="button" class="show-more-row" data-show-more>
                            <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
                            <span data-show-more-label>Show @(day.Sessions.Count - visibleCap) more sessions</span>
                        </button>
                    }
                </section>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="pagination">
                <div class="pagination-controls">
                    @if (page > 1)
                    {
                        <a class="page-nav" href="@PageUrl(page - 1)" aria-label="Previous page">
                            <span class="material-symbols-outlined">chevron_left</span>
                        </a>
                    }
                    else
                    {
                        <span class="page-nav" aria-disabled="true">
                            <span class="material-symbols-outlined">chevron_left</span>
                        </span>
                    }
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        @if (p == page)
                        {
                            <span class="page-btn is-active" aria-current="page">@p</span>
                        }
                        else
                        {
                            <a class="page-btn" href="@PageUrl(p)">@p</a>
                        }
                    }
                    @if (page < totalPages)
                    {
                        <a class="page-nav" href="@PageUrl(page + 1)" aria-label="Next page">
                            <span class="material-symbols-outlined">chevron_right</span>
                        </a>
                    }
                    else
                    {
                        <span class="page-nav" aria-disabled="true">
                            <span class="material-symbols-outlined">chevron_right</span>
                        </span>
                    }
                </div>
                <span class="pagination-status">Page @(page) of @totalPages</span>
            </div>
        }
    }

</main>

@section Scripts {
    <script src="~/js/time-logs.js" asp-append-version="true" defer></script>
}
