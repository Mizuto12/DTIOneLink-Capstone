@model DTIOneLink.Models.RecordTimelineViewModel
@{
    var userRole = Context.Session.GetString("UserRole");
    Layout = userRole == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : userRole == "Admin"
            ? "~/Views/Admin/AdminLayout.cshtml"
            : "~/Views/Employee/EmployeeLayout.cshtml";
    ViewData["Title"] = "Record History";
}

@section Styles {
    <link rel="stylesheet" href="~/css/records.css" asp-append-version="true">
}

<main class="records-page">

    <section class="card">
        <p class="page-eyebrow">@Model.Code</p>
        <h2 class="card-title">@Model.Title</h2>
        <p class="card-desc">Current status: <span class="badge">@Model.CurrentStatus</span></p>
    </section>

    <section class="card">
        @if (!Model.Events.Any())
        {
            <p class="card-desc">
                No disposal-status changes yet — this record hasn't moved off Retention since this
                history started being tracked. Status changes made before this feature shipped are
                not shown here; nothing is backfilled or guessed at.
            </p>
        }
        else
        {
            <ol class="timeline">
                @foreach (var ev in Model.Events)
                {
                    <li class="timeline-item">
                        <span class="timeline-item__dot" aria-hidden="true"></span>
                        <div class="timeline-item__type">@ev.EventType</div>
                        <div class="timeline-item__meta">
                            @DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(ev.OccurredAt).ToString("MMM d, yyyy, h:mm tt")
                            @if (!string.IsNullOrWhiteSpace(ev.ActorName))
                            {
                                <text> — by @ev.ActorName</text>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ev.AuthorityReference))
                        {
                            <div class="timeline-item__detail">Authority reference: @ev.AuthorityReference</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(ev.Notes))
                        {
                            <div class="timeline-item__detail timeline-item__detail--muted">@ev.Notes</div>
                        }
                    </li>
                }
            </ol>
        }
    </section>

    <a asp-controller="Records" asp-action="Index" class="btn btn-outline page-back">
        <span class="material-symbols-outlined">arrow_back</span> Back to Records
    </a>
</main>
