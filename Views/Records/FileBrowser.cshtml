@model List<DTIOneLink.Models.RecordAttachmentViewModel>
@{
    var userRole = Context.Session.GetString("UserRole");
    Layout = userRole == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : userRole == "Admin"
            ? "~/Views/Admin/AdminLayout.cshtml"
            : "~/Views/Employee/EmployeeLayout.cshtml";
    ViewData["Title"] = "Record Files";

    static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / (1024.0 * 1024):0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";
}

@section Styles {
    <link rel="stylesheet" href="~/css/records.css" asp-append-version="true">
}

<main class="records-page">

    <section class="card">
        <div class="card-header-left">
            <div class="icon-badge">
                <span class="material-symbols-outlined">folder_open</span>
            </div>
            <div>
                <h2 class="card-title">Record Files</h2>
                <p class="card-desc">
                    Every document attached to a record you can see — the same visibility rule as the
                    Records table itself. A locked card means that record's Access Control is Confidential.
                </p>
            </div>
        </div>
    </section>

    <section class="card">
        @if (!Model.Any())
        {
            <p class="card-desc">No files have been attached to any record you can see yet.</p>
        }
        else
        {
            <div class="file-grid">
                @foreach (var item in Model)
                {
                    <div class="file-card">
                        <span class="material-symbols-outlined file-card__lock @(item.IsLocked ? "is-locked" : "")" aria-hidden="true"
                              title="@(item.IsLocked ? "Confidential record" : "Not confidential")">
                            @(item.IsLocked ? "lock" : "lock_open")
                        </span>
                        <div class="file-card__code">@item.RecordCode</div>
                        <div class="file-card__title">@item.RecordTitle</div>
                        <div class="file-card__name">@item.FileName</div>
                        <div class="file-card__meta">
                            @FormatSize(item.FileSizeBytes) · @item.UploadedAt.ToString("MMM d, yyyy")
                            @if (!string.IsNullOrWhiteSpace(item.UploadedByName))
                            {
                                <text> · @item.UploadedByName</text>
                            }
                        </div>
                        <a asp-controller="Records" asp-action="DownloadAttachment" asp-route-id="@item.AttachmentId"
                           class="btn btn-outline file-card__download">
                            <span class="material-symbols-outlined">download</span> Download
                        </a>
                    </div>
                }
            </div>
        }
    </section>

    <a asp-controller="Records" asp-action="Index" class="btn btn-outline page-back">
        <span class="material-symbols-outlined">arrow_back</span> Back to Records
    </a>
</main>
