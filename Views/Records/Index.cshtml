@{
    var userRole = Context.Session.GetString("UserRole");
    Layout = userRole == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : userRole == "Admin"
            ? "~/Views/Admin/AdminLayout.cshtml"
            : "~/Views/Employee/EmployeeLayout.cshtml";
    ViewData["Title"] = "Records Management";
    ViewData["LiveRefresh"] = true; // auto-refresh when data changes (live-refresh.js)
}

@section Styles {
    <link rel="stylesheet" href="~/css/records.css" asp-append-version="true">
}

<main class="records-page">

  <!-- Page Header -->
  <header class="page-header">
    <div class="header-actions">
      <button class="btn btn-outline" type="button">
        <span class="material-symbols-outlined">download</span> Export List
      </button>
      <button class="btn btn-primary" type="button">
        <span class="material-symbols-outlined">print</span> Print Log
      </button>
    </div>
  </header>

  <!-- Add New Entry Card -->
  <section class="card">
    <div class="card-header">
      <div class="card-header-left">
        <div class="icon-badge">
          <span class="material-symbols-outlined">description</span>
        </div>
        <div>
          <h2 class="card-title">Add New Entry</h2>
          <p class="card-desc">Fill in the details to archive a new document</p>
        </div>
      </div>
      <span class="badge">NEW RECORD</span>
    </div>

    <form id="new-entry-form">
      @Html.AntiForgeryToken()
      <div class="form-grid">
        <div class="field">
          <label for="code">Code</label>
          <input id="code" name="code" type="text" placeholder="# e.g. DTI-REC-01" required>
        </div>
        <div class="field">
          <label for="title">Title of Record</label>
          <input id="title" data-capitalize="title" name="title" type="text" placeholder="e.g. Business Registration Logs" required>
        </div>
        <div class="field">
          <label for="medium">Medium</label>
          <select id="medium" name="medium" required data-other-input="medium-other">
            <option value="" disabled selected>Select Medium</option>
            <option value="Hard Copy">Hard Copy</option>
            <option value="Electronic">Electronic</option>
            <option value="Hard Copy/Electronic">Hard Copy/Electronic</option>
            <option value="__other__">Other / Specify</option>
          </select>
          <input id="medium-other" data-capitalize="title" name="mediumOther" type="text" class="other-input" maxlength="50"
                 placeholder="Type the Medium" aria-label="Specify medium"
                 pattern=".*\S.*" title="Please type a value." hidden>
        </div>
        <div class="field">
          <label for="location">Physical File Location</label>
          <input id="location" data-capitalize="title" name="location" type="text" placeholder="e.g. Archive Room A, Cabinet 3, Drawer 2" required>
        </div>
      </div>

      <div class="form-row-actions">
        <div class="field">
          <label for="period">Period Covered</label>
          <input id="period" name="period" type="text" placeholder="e.g. 2023-2024" required>
        </div>
        <div class="field">
          <label for="filing">Filing System</label>
          <select id="filing" name="filing" required data-other-input="filing-other">
            <option value="" disabled selected>Select Filing System</option>
            <option value="Alphabetical/Numerical">Alphabetical/Numerical</option>
            <option value="Chronological">Chronological</option>
            <option value="Per Transaction">Per Transaction</option>
            <option value="Per Activity/Project">Per Activity/Project</option>
            <option value="Per Batch">Per Batch</option>
            <option value="Per Bureau/Office/FG">Per Bureau/Office/FG</option>
            <option value="Per Location">Per Location</option>
            <option value="__other__">Other / Specify</option>
          </select>
          <input id="filing-other" data-capitalize="title" name="filingOther" type="text" class="other-input" maxlength="50"
                 placeholder="Type the Filing System" aria-label="Specify filing system"
                 pattern=".*\S.*" title="Please type a value." hidden>
        </div>
        <div class="field">
          <label for="access">Access Control</label>
          <select id="access" name="access" required data-other-input="access-other">
            <option value="" disabled selected>Select Access Control</option>
            <option value="Confidential">Confidential</option>
            <option value="Public Record">Public Record</option>
            <option value="Exclusive">Exclusive</option>
            <option value="DTI Only">DTI Only</option>
            <option value="__other__">Other / Specify</option>
          </select>
          <input id="access-other" data-capitalize="title" name="accessOther" type="text" class="other-input" maxlength="50"
                 placeholder="e.g. Public upon request" aria-label="Specify access control"
                 pattern=".*\S.*" title="Please type a value." hidden>
        </div>
        <button class="commit-btn" type="submit">
          <span class="material-symbols-outlined">save</span> Save Entry
        </button>
      </div>

      <div class="field" style="max-width: 260px; margin-top: 16px;">
        <label for="retention">Retention Period</label>
        <input id="retention" name="retention" type="text" placeholder="e.g. 5 Years" required>
      </div>
    </form>
  </section>

  <!-- Recent Submissions Card -->
  <section class="card">
    <div class="card-header">
      <div class="card-header-left">
        <div class="icon-badge green">
          <span class="material-symbols-outlined">inventory_2</span>
        </div>
        <div>
          <h2 class="card-title">Current Masterlist</h2>
          <p class="card-desc">Records added since your last saved masterlist.</p>
        </div>
      </div>
      <div class="card-header-right">
        <span class="badge" id="entry-count-badge">Showing 0 of 0 entries</span>
        <button class="btn btn-primary" type="button" id="save-masterlist-btn" disabled>
          <span class="material-symbols-outlined">save</span> <span id="save-masterlist-label">Save Masterlist</span>
        </button>
      </div>
    </div>

    <!-- Shown while adding records to a saved masterlist ("Add Records"). -->
    <div class="open-masterlist-banner" id="open-masterlist-banner" hidden>
      <span class="material-symbols-outlined">edit_note</span>
      <div class="open-masterlist-text">
        You are adding records to <strong id="open-masterlist-name"></strong>.
        Its saved records are shown below. Add your new records, then click <strong>Update Masterlist</strong>.
      </div>
      <button class="btn btn-outline" type="button" id="stop-adding-btn">Stop Adding</button>
    </div>

    <!-- Search / filter toolbar — filtering happens on the server -->
    <form class="records-toolbar" id="records-filter" role="search" autocomplete="off">
      <div class="field toolbar-search">
        <label for="filter-q">Search</label>
        <input id="filter-q" name="q" type="search" maxlength="100" placeholder="Search Code, Title, Location, or Period">
      </div>
      <div class="field">
        <label for="filter-medium">Medium</label>
        <select id="filter-medium" name="medium">
          <option value="">All</option>
          <option value="Hard Copy">Hard Copy</option>
          <option value="Electronic">Electronic</option>
          <option value="Hard Copy/Electronic">Hard Copy/Electronic</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="field">
        <label for="filter-access">Access Control</label>
        <select id="filter-access" name="access">
          <option value="">All</option>
          <option value="Confidential">Confidential</option>
          <option value="Public Record">Public Record</option>
          <option value="Exclusive">Exclusive</option>
          <option value="DTI Only">DTI Only</option>
          <option value="other">Other</option>
        </select>
      </div>
      @if (ViewBag.CanManageRecords == true)
      {
        <div class="field">
          <label for="filter-retention">Retention</label>
          <select id="filter-retention" name="retention">
            <option value="">All</option>
            <option value="overdue">Retention Ended (Red)</option>
            <option value="due-soon">Ends Within 6 Months (Yellow)</option>
            <option value="not-computed">No End Date</option>
          </select>
        </div>
      }
      <div class="toolbar-actions">
        <button class="btn btn-primary" type="submit">
          <span class="material-symbols-outlined">search</span> Search
        </button>
        <button class="btn btn-outline" type="reset">Clear</button>
      </div>
    </form>

    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Code</th>
            <th>Title of Record</th>
            <th>Medium</th>
            <th>Physical File Location</th>
            <th>Period Covered</th>
            <th>Filing System</th>
            <th>Access Control</th>
            <th>Retention Period</th>
          </tr>
        </thead>
        <tbody id="submissions-body" aria-busy="true">
          @* Placeholders until records.js loads the real rows. *@
          @for (var i = 0; i < 3; i++)
          {
            <tr class="skeleton-row" aria-hidden="true">
              @for (var c = 0; c < 8; c++)
              {
                <td><span class="skeleton"></span></td>
              }
            </tr>
          }
        </tbody>
      </table>
    </div>

    <!-- Shown only when a row is highlighted: explains the reminder colours. -->
    <p class="retention-legend" id="retention-legend" hidden>
      <span class="legend-item"><span class="legend-swatch due-soon"></span> Retention ends within 6 months</span>
      <span class="legend-item"><span class="legend-swatch ended"></span> Retention period has ended — review for disposal</span>
    </p>

    <!-- Pagination -->
    <div class="pagination">
      <div class="pagination-controls">
        <button class="page-nav" type="button" id="prev-page-btn" aria-label="Previous page">
          <span class="material-symbols-outlined">chevron_left</span>
        </button>
        <div class="pagination-controls" id="page-numbers"></div>
        <button class="page-nav" type="button" id="next-page-btn" aria-label="Next page">
          <span class="material-symbols-outlined">chevron_right</span>
        </button>
      </div>
      <div class="pagination-status" id="pagination-status">Page 1 of 1</div>
    </div>
  </section>

  <!-- Saved Masterlists Card -->
  <section class="card">
    <div class="card-header">
      <div class="card-header-left">
        <div class="icon-badge">
          <span class="material-symbols-outlined">folder_open</span>
        </div>
        <div>
          <h2 class="card-title">Saved Masterlists</h2>
          <p class="card-desc">Excel files you have saved. Click Download to get a copy again.</p>
        </div>
      </div>
    </div>
    <ul class="masterlist-list" id="masterlist-list" aria-busy="true">
      @* Placeholders until records.js loads the saved list. *@
      @for (var i = 0; i < 2; i++)
      {
        <li class="masterlist-skeleton" aria-hidden="true">
          <div><span class="skeleton skeleton-title"></span><span class="skeleton skeleton-meta"></span></div>
        </li>
      }
    </ul>
  </section>

  <!-- Save Masterlist form (opened by the Save Masterlist button) -->
  <dialog class="masterlist-dialog" id="masterlist-dialog" aria-labelledby="masterlist-dialog-title">
    <form method="dialog" id="masterlist-form">
      <h2 class="card-title" id="masterlist-dialog-title">Save Masterlist</h2>
      <p class="card-desc" id="masterlist-dialog-summary"></p>

      <div class="signatory-grid">
        <div class="field">
          <label for="ml-prepared-name">Prepared by</label>
          <input id="ml-prepared-name" data-capitalize="title" name="preparedByName" type="text" maxlength="100" placeholder="Full Name">
          <input id="ml-prepared-position" data-capitalize="title" name="preparedByPosition" type="text" maxlength="100" placeholder="Position" aria-label="Prepared by position">
        </div>
        <div class="field">
          <label for="ml-reviewed-name">Reviewed by</label>
          <input id="ml-reviewed-name" data-capitalize="title" name="reviewedByName" type="text" maxlength="100" placeholder="Full Name">
          <input id="ml-reviewed-position" data-capitalize="title" name="reviewedByPosition" type="text" maxlength="100" placeholder="Position" aria-label="Reviewed by position">
        </div>
        <div class="field">
          <label for="ml-noted-name">Noted by</label>
          <input id="ml-noted-name" data-capitalize="title" name="notedByName" type="text" maxlength="100" placeholder="Full Name">
          <input id="ml-noted-position" data-capitalize="title" name="notedByPosition" type="text" maxlength="100" placeholder="Position" aria-label="Noted by position">
        </div>
      </div>

      <div class="dialog-actions">
        <button class="btn btn-outline" type="button" id="masterlist-cancel-btn">Cancel</button>
        <button class="btn btn-primary" type="submit" id="masterlist-confirm-btn">
          <span class="material-symbols-outlined">download</span> Save and Download
        </button>
      </div>
    </form>
  </dialog>

  <!-- Questions and error messages (filled in by showNotice in records.js) -->
  <dialog class="notice-dialog" id="notice-dialog" aria-labelledby="notice-title" aria-describedby="notice-message">
    <span class="notice-icon material-symbols-outlined" id="notice-icon" aria-hidden="true"></span>
    <h2 class="notice-title" id="notice-title"></h2>
    <p class="notice-file" id="notice-file" hidden></p>
    <p class="notice-message" id="notice-message"></p>
    <ul class="notice-steps" id="notice-steps" hidden></ul>
    <p class="notice-note" id="notice-note" hidden></p>
    <div class="notice-actions">
      <button class="btn btn-outline" type="button" id="notice-cancel">Cancel</button>
      <button class="btn btn-primary" type="button" id="notice-ok">OK</button>
    </div>
  </dialog>

</main>

@section Scripts {
    <script src="~/js/records.js" asp-append-version="true" defer></script>
}
