@{
    var userRole = Context.Session.GetString("UserRole");
    Layout = userRole == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : userRole == "Admin"
            ? "~/Views/Admin/AdminLayout.cshtml"
            : "~/Views/Employee/EmployeeLayout.cshtml";
    ViewData["Title"] = "Records Management";
}

@section Styles {
    <link rel="stylesheet" href="~/css/records.css" asp-append-version="true">
}

<main class="records-page">

  <!-- Page Header -->
  <header class="page-header">
    <div class="header-actions">
      <button class="btn btn-outline" type="button">
        <span class="material-symbols-outlined">download</span> Export List
      </button>
      <button class="btn btn-primary" type="button">
        <span class="material-symbols-outlined">print</span> Print Log
      </button>
    </div>
  </header>

  <!-- Add New Entry Card -->
  <section class="card">
    <div class="card-header">
      <div class="card-header-left">
        <div class="icon-badge">
          <span class="material-symbols-outlined">description</span>
        </div>
        <div>
          <h2 class="card-title">Add New Entry</h2>
          <p class="card-desc">Fill in the details to archive a new document</p>
        </div>
      </div>
      <span class="badge">NEW RECORD</span>
    </div>

    <form id="new-entry-form">
      @Html.AntiForgeryToken()
      <div class="form-grid">
        <div class="field">
          <label for="code">Code</label>
          <input id="code" name="code" type="text" placeholder="# e.g. DTI-REC-01" required>
        </div>
        <div class="field">
          <label for="title">Title of Record</label>
          <input id="title" name="title" type="text" placeholder="e.g. Business Registration Logs" required>
        </div>
        <div class="field">
          <label for="medium">Medium</label>
          <select id="medium" name="medium" required data-other-input="medium-other">
            <option value="" disabled selected>Select medium</option>
            <option value="Hard Copy">Hard Copy</option>
            <option value="Electronic">Electronic</option>
            <option value="Hard Copy/Electronic">Hard Copy/Electronic</option>
            <option value="__other__">Other / Specify</option>
          </select>
          <input id="medium-other" name="mediumOther" type="text" class="other-input" maxlength="50"
                 placeholder="Type the medium" aria-label="Specify medium"
                 pattern=".*\S.*" title="Please type a value." hidden>
        </div>
        <div class="field">
          <label for="location">Location</label>
          <input id="location" name="location" type="text" placeholder="e.g. Archive Room A" required>
        </div>
      </div>

      <div class="form-row-actions">
        <div class="field">
          <label for="period">Period Covered</label>
          <input id="period" name="period" type="text" placeholder="e.g. 2023-2024" required>
        </div>
        <div class="field">
          <label for="filing">Filing System</label>
          <select id="filing" name="filing" required data-other-input="filing-other">
            <option value="" disabled selected>Select filing system</option>
            <option value="Alphabetical/Numerical">Alphabetical/Numerical</option>
            <option value="Chronological">Chronological</option>
            <option value="Per Transaction">Per Transaction</option>
            <option value="Per Activity/Project">Per Activity/Project</option>
            <option value="Per Batch">Per Batch</option>
            <option value="Per Bureau/Office/FG">Per Bureau/Office/FG</option>
            <option value="Per Location">Per Location</option>
            <option value="__other__">Other / Specify</option>
          </select>
          <input id="filing-other" name="filingOther" type="text" class="other-input" maxlength="50"
                 placeholder="Type the filing system" aria-label="Specify filing system"
                 pattern=".*\S.*" title="Please type a value." hidden>
        </div>
        <div class="field">
          <label for="access">Access Control</label>
          <select id="access" name="access" required data-other-input="access-other">
            <option value="" disabled selected>Select access control</option>
            <option value="Confidential">Confidential</option>
            <option value="Public Record">Public Record</option>
            <option value="Exclusive">Exclusive</option>
            <option value="DTI Only">DTI Only</option>
            <option value="__other__">Other / Specify</option>
          </select>
          <input id="access-other" name="accessOther" type="text" class="other-input" maxlength="50"
                 placeholder="e.g. Public upon request" aria-label="Specify access control"
                 pattern=".*\S.*" title="Please type a value." hidden>
        </div>
        <button class="commit-btn" type="submit">
          <span class="material-symbols-outlined">save</span> Save Entry
        </button>
      </div>

      <div class="field" style="max-width: 260px; margin-top: 16px;">
        <label for="retention">Retention Period</label>
        <input id="retention" name="retention" type="text" placeholder="e.g. 5 Years" required>
      </div>
    </form>
  </section>

  <!-- Recent Submissions Card -->
  <section class="card">
    <div class="card-header">
      <div class="card-header-left">
        <div class="icon-badge green">
          <span class="material-symbols-outlined">inventory_2</span>
        </div>
        <div>
          <h2 class="card-title">Recent Submissions</h2>
        </div>
      </div>
      <span class="badge" id="entry-count-badge">Showing 0 of 0 entries</span>
    </div>

    <!-- Search / filter toolbar — filtering happens on the server -->
    <form class="records-toolbar" id="records-filter" role="search" autocomplete="off">
      <div class="field toolbar-search">
        <label for="filter-q">Search</label>
        <input id="filter-q" name="q" type="search" maxlength="100" placeholder="Code, title, location, or period">
      </div>
      <div class="field">
        <label for="filter-medium">Medium</label>
        <select id="filter-medium" name="medium">
          <option value="">All</option>
          <option value="Hard Copy">Hard Copy</option>
          <option value="Electronic">Electronic</option>
          <option value="Hard Copy/Electronic">Hard Copy/Electronic</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="field">
        <label for="filter-access">Access Control</label>
        <select id="filter-access" name="access">
          <option value="">All</option>
          <option value="Confidential">Confidential</option>
          <option value="Public Record">Public Record</option>
          <option value="Exclusive">Exclusive</option>
          <option value="DTI Only">DTI Only</option>
          <option value="other">Other</option>
        </select>
      </div>
      @if (ViewBag.CanManageRecords == true)
      {
        <div class="field">
          <label for="filter-retention">Retention</label>
          <select id="filter-retention" name="retention">
            <option value="">All</option>
            <option value="overdue">Retention ended (red)</option>
            <option value="due-soon">Ends within 6 months (yellow)</option>
            <option value="not-computed">No end date</option>
          </select>
        </div>
      }
      <div class="toolbar-actions">
        <button class="btn btn-primary" type="submit">
          <span class="material-symbols-outlined">search</span> Search
        </button>
        <button class="btn btn-outline" type="reset">Clear</button>
      </div>
    </form>

    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Code</th>
            <th>Title of Record</th>
            <th>Medium</th>
            <th>Location</th>
            <th>Period Covered</th>
            <th>Filing System</th>
            <th>Access Control</th>
            <th>Retention Period</th>
          </tr>
        </thead>
        <tbody id="submissions-body">
          <tr class="empty-row" id="empty-row">
            <td colspan="8" class="empty-state">No records yet. Fill in the form above and commit to add one.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Shown only when a row is highlighted: explains the reminder colours. -->
    <p class="retention-legend" id="retention-legend" hidden>
      <span class="legend-item"><span class="legend-swatch due-soon"></span> Retention ends within 6 months</span>
      <span class="legend-item"><span class="legend-swatch ended"></span> Retention period has ended — review for disposal</span>
    </p>

    <!-- Pagination -->
    <div class="pagination">
      <div class="pagination-controls">
        <button class="page-nav" type="button" id="prev-page-btn" aria-label="Previous page">
          <span class="material-symbols-outlined">chevron_left</span>
        </button>
        <div class="pagination-controls" id="page-numbers"></div>
        <button class="page-nav" type="button" id="next-page-btn" aria-label="Next page">
          <span class="material-symbols-outlined">chevron_right</span>
        </button>
      </div>
      <div class="pagination-status" id="pagination-status">Page 1 of 1</div>
    </div>
  </section>

</main>

@section Scripts {
    <script src="~/js/records.js" defer></script>
}
