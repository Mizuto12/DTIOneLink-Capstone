@using DTIOneLink.Helpers
@{
    Layout = null;
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    bool IsActive(string c) =>
        string.Equals(current, c, StringComparison.OrdinalIgnoreCase);
}
@{
    var sessFullName = Context.Session.GetString("FullName");
    var sessRole     = Context.Session.GetString("UserRole");
    var sessEmail    = Context.Session.GetString("UserEmail");
    var sessDept     = Context.Session.GetString("UserDepartment");

    var displayName  = string.IsNullOrWhiteSpace(sessFullName) ? "USER" : sessFullName.ToUpper();
    // Same initials as the User Management list (e.g. "Bong Palitao" -> "BP").
    var userInitials = DisplayHelpers.GetInitials(sessFullName, Context.Session.GetString("LoginUsername"));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DTI Laguna OneLink</title>
    <link rel="icon" type="image/png" href="~/images/dti-logo.png" asp-append-version="true" />

    
    <link rel="preload" href="/fonts/material-symbols/MaterialSymbolsOutlined.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/css/fonts.css" asp-append-version="true" />
    @* Hide icons until their font is ready (see fonts.css); give up after 10s. *@
    <script>
        (function (root) {
            root.classList.add("icons-loading");
            var ready = function () { root.classList.remove("icons-loading"); };
            if (!document.fonts || !document.fonts.load) { ready(); return; }
            document.fonts.load("24px 'Material Symbols Outlined'").then(ready, ready);
            setTimeout(ready, 10000);
        })(document.documentElement);
    </script>
    <link rel="stylesheet" href="~/css/adminlayout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-live-refresh="@(ViewData["LiveRefresh"] is true ? "" : null)">

    <!-- ══════════════ TOPBAR ══════════════ -->
    <header class="topbar">
        <div class="topbar-left">
            @* Phones and tablets: opens the sidebar as a slide-out menu (adminlayout.js). *@
            <button type="button" class="menu-btn" id="menuBtn" aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <div class="topbar-search">
                <span class="material-symbols-outlined search-icon">search</span>
                <input type="text" placeholder="Search tasks or records..." />
            </div>
        </div>

        <div class="topbar-right">
            <!-- Notification bell -->
            <div class="notif-wrapper">
                <button class="notif-btn" id="notifBtn" data-user-id="@Context.Session.GetInt32("UserId")" aria-label="Notifications" aria-haspopup="true" aria-expanded="false">
                    <span class="material-symbols-outlined">notifications</span>
                    <span class="notif-badge hidden" id="notifBadge">0</span>
                </button>

                <div class="notif-panel" id="notifPanel" role="menu" aria-label="Notifications">
                    <div class="notif-panel-header">
                        <span>Notifications</span>
                        <button class="notif-mark-all" id="markAllRead" type="button">Mark all read</button>
                    </div>
                    <div class="notif-panel-body" id="notifList" aria-busy="true">
                        @* Placeholders until adminlayout.js loads the real list. *@
                        <div class="notif-item is-skeleton" aria-hidden="true">
                            <span class="skeleton skeleton-circle"></span>
                            <div class="notif-body"><span class="skeleton"></span><span class="skeleton skeleton-short"></span></div>
                        </div>
                        <div class="notif-item is-skeleton" aria-hidden="true">
                            <span class="skeleton skeleton-circle"></span>
                            <div class="notif-body"><span class="skeleton"></span><span class="skeleton skeleton-short"></span></div>
                        </div>
                        <div class="notif-item is-skeleton" aria-hidden="true">
                            <span class="skeleton skeleton-circle"></span>
                            <div class="notif-body"><span class="skeleton"></span><span class="skeleton skeleton-short"></span></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="topbar-divider"></div>
            <div class="topbar-user" id="profileTrigger">
                <div class="user-info">
                    <span class="user-name">@displayName</span>
                </div>
                <div class="avatar-wrapper">
                    <div class="user-avatar">
                        <span class="avatar-initials">@userInitials</span>
                    </div>
                    <span class="material-symbols-outlined profile-chevron">expand_more</span>
                </div>
            </div>

            <div class="profile-dropdown" id="profileDropdown">
                <div class="profile-dropdown-header">
                    <div class="user-avatar user-avatar-lg">
                        <span class="avatar-initials">@userInitials</span>
                    </div>
                    <div>
                        <div class="profile-dd-name">@displayName</div>
                        @if (!string.IsNullOrWhiteSpace(sessEmail))
                        {
                            <div class="profile-dd-email">@sessEmail</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(sessDept))
                        {
                            <div class="profile-dd-dept">@sessDept</div>
                        }
                    </div>
                </div>
                <div class="profile-dropdown-divider"></div>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:4px;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="profile-logout-btn">
                        <span class="material-symbols-outlined">logout</span>
                        <span>Sign Out</span>
                    </button>
                </form>
            </div>
        </div>
    </header>

    <!-- ══════════════ SIDEBAR ══════════════ -->
    <aside class="sidebar" id="sidebar">

        <!-- Brand block: logo + DTI (Anton) + OneLink (Open Sauce) -->
        <div class="sidebar-brand">
            <img src="~/images/dti-logo.png" asp-append-version="true"
                 alt="DTI Laguna Provincial Office"
                 class="sidebar-logo" />
            <div class="brand-text">
                <span class="brand-dti">DTI  Laguna</span>
                <span class="brand-onelink">
                <span class="word-one">One</span><span class="word-link">Link</span>
                </span>
            </div>
        </div>

        <nav class="sidebar-nav">

            <a asp-controller="Dashboard" asp-action="AdminDashboard"
               class="nav-item @(IsActive("Dashboard") ? "active" : "")">
                <span class="material-symbols-outlined"
                      style="@(IsActive("Dashboard") ? "font-variation-settings:'FILL' 1;" : "")">dashboard</span>
                <span>Dashboard</span>
            </a>

            <a asp-controller="Tasks" asp-action="Index"
               class="nav-item @(IsActive("Tasks") ? "active" : "")">
                <span class="material-symbols-outlined">assignment</span>
                <span>Task Management</span>
            </a>

            <a asp-controller="Records" asp-action="Index"
               class="nav-item @(IsActive("Records") ? "active" : "")">
                <span class="material-symbols-outlined">folder_open</span>
                <span>Records Management</span>
            </a>

            <a asp-controller="Reports" asp-action="Index"
               class="nav-item @(IsActive("Reports") ? "active" : "")">
                <span class="material-symbols-outlined">assessment</span>
                <span>Reports</span>
            </a>

            <a asp-controller="UserManagement" asp-action="Index"
               class="nav-item @(IsActive("UserManagement") ? "active" : "")">
                <span class="material-symbols-outlined">group</span>
                <span>User Management</span>
            </a>

            <a asp-controller="TimeLogs" asp-action="Index"
               class="nav-item @(IsActive("TimeLogs") ? "active" : "")">
                <span class="material-symbols-outlined">schedule</span>
                <span>Time Logs</span>
            </a>

        </nav>
    </aside>

    <div class="sidebar-scrim" id="sidebarScrim" hidden></div>

    <!-- ══════════════ MAIN CONTENT ══════════════ -->
    <main class="main-content">
        @RenderBody()
    </main>

    <script src="~/js/adminlayout.js" asp-append-version="true"></script>
    <script src="~/lib/microsoft-signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/live-refresh.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>