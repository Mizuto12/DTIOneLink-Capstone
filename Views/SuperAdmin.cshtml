@model DTIOneLink.Models.SuperAdminDashboardViewModel
@using DTIOneLink.Services
@{
    Layout = "~/Views/SuperAdmin/SuperAdminLayout.cshtml";
    ViewData["Title"] = "Super Admin Dashboard";
    ViewData["LiveRefresh"] = true; // auto-refresh when data changes (live-refresh.js)

    // Summary cards: label, count, icon, color tone.
    var cards = new[]
    {
        (Label: "Total Tasks", Value: Model.TotalTasks,                 Icon: "assignment",             Tone: "total"),
        (Label: "To Do",       Value: Model.TodoCount,                  Icon: "radio_button_unchecked", Tone: "todo"),
        (Label: "In Progress", Value: Model.InProgressCount,            Icon: "autorenew",              Tone: "progress"),
        (Label: "For Review",  Value: Model.ForReviewCount,             Icon: "fact_check",             Tone: "review"),
        (Label: "Returned",    Value: Model.ReturnedForCorrectionCount, Icon: "undo",                   Tone: "returned"),
        (Label: "Completed",   Value: Model.CompletedCount,             Icon: "check_circle",           Tone: "completed"),
        (Label: "Overdue",     Value: Model.OverdueCount,               Icon: "warning",                Tone: "overdue"),
        (Label: "At Risk",     Value: Model.AtRiskCount,                Icon: "schedule",               Tone: "risk"),
    };

    // Kanban columns, in the order work moves through the office.
    var columns = new[]
    {
        (Status: TaskWorkflow.Pending,               Title: "To Do",       Tone: "todo"),
        (Status: TaskWorkflow.InProgress,            Title: "In Progress", Tone: "progress"),
        (Status: TaskWorkflow.ForReview,             Title: "For Review",  Tone: "review"),
        (Status: TaskWorkflow.ReturnedForCorrection, Title: "Returned",    Tone: "returned"),
        (Status: TaskWorkflow.Completed,             Title: "Completed",   Tone: "completed"),
    };

    // Division filter chips: short label shown, full name used for matching.
    var divisions = new[]
    {
        (Short: "OPD", Name: "Office of the Provincial Director"),
        (Short: "BDD", Name: "Business Development Division"),
        (Short: "CPD", Name: "Consumer Protection Division"),
        (Short: "FAU", Name: "Financial and Administrative Unit"),
    };
    string ShortDivision(string name) => divisions.FirstOrDefault(d => d.Name == name).Short ?? "";

    string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Where(w => char.IsLetter(w[0])).Take(2).Select(w => char.ToUpper(w[0])));

    var today = TimeZoneHelper.PhilippineToday;
    string DueText(DateTime due)
    {
        var days = (due.Date - today).Days;
        return days switch
        {
            < -1 => $"{-days} days late",
            -1 => "1 day late",
            0 => "Due today",
            1 => "Due tomorrow",
            _ => $"Due {due:MMM d}"
        };
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/superadmin.css" asp-append-version="true" />
}

<div class="sa-dashboard">

    <!-- ── Summary cards ─────────────────────────────────── -->
    <section class="sa-cards" aria-label="Task summary">
        @foreach (var c in cards)
        {
            <div class="sa-card sa-tone-@c.Tone">
                <span class="sa-card__icon material-symbols-outlined" aria-hidden="true">@c.Icon</span>
                <div>
                    <p class="sa-card__value">@c.Value</p>
                    <p class="sa-card__label">@c.Label</p>
                </div>
            </div>
        }
    </section>

    <!-- ── Status distribution ───────────────────────────── -->
    <section class="sa-section">
        <div class="sa-section__head">
            <h4 class="sa-section__title">Status Distribution</h4>
            @if (Model.TotalTasks > 0)
            {
                <span class="sa-pill">Completion rate: <strong>@Model.OverallEfficiencyPercent%</strong></span>
            }
        </div>
        @if (Model.TotalTasks == 0)
        {
            <div class="sa-empty-state">No tasks recorded yet.</div>
        }
        else
        {
            <div class="sa-status-bar">
                <div class="sa-seg sa-tone-todo" style="width:@(Model.TodoPercent)%;" title="To Do @Model.TodoPercent%"></div>
                <div class="sa-seg sa-tone-progress" style="width:@(Model.InProgressPercent)%;" title="In Progress @Model.InProgressPercent%"></div>
                <div class="sa-seg sa-tone-review" style="width:@(Model.ForReviewPercent)%;" title="For Review @Model.ForReviewPercent%"></div>
                <div class="sa-seg sa-tone-returned" style="width:@(Model.ReturnedForCorrectionPercent)%;" title="Returned @Model.ReturnedForCorrectionPercent%"></div>
                <div class="sa-seg sa-tone-completed" style="width:@(Model.CompletedPercent)%;" title="Completed @Model.CompletedPercent%"></div>
            </div>
            <div class="sa-status-legend">
                <span><span class="sa-dot sa-tone-todo"></span>To Do <strong>@Model.TodoCount</strong> (@Model.TodoPercent%)</span>
                <span><span class="sa-dot sa-tone-progress"></span>In Progress <strong>@Model.InProgressCount</strong> (@Model.InProgressPercent%)</span>
                <span><span class="sa-dot sa-tone-review"></span>For Review <strong>@Model.ForReviewCount</strong> (@Model.ForReviewPercent%)</span>
                <span><span class="sa-dot sa-tone-returned"></span>Returned <strong>@Model.ReturnedForCorrectionCount</strong> (@Model.ReturnedForCorrectionPercent%)</span>
                <span><span class="sa-dot sa-tone-completed"></span>Completed <strong>@Model.CompletedCount</strong> (@Model.CompletedPercent%)</span>
            </div>
        }
    </section>

    <!-- ── Kanban board (every assignment, office-wide) ──── -->
    <section class="sa-section" id="saBoard">
        <div class="sa-section__head">
            <div>
                <h4 class="sa-section__title">Task Board</h4>
                <p class="sa-section__sub">Every assignment across the office, grouped by status. Click a card to open the task.</p>
            </div>
            <div class="sa-chips" role="group" aria-label="Show division">
                <button type="button" class="sa-chip is-active" data-division="" aria-pressed="true">All divisions</button>
                @foreach (var d in divisions)
                {
                    <button type="button" class="sa-chip" data-division="@d.Name" aria-pressed="false" title="@d.Name">@d.Short</button>
                }
            </div>
        </div>

        <div class="sa-board">
            @foreach (var col in columns)
            {
                var items = Model.WorkItems.Where(i => i.Status == col.Status)
                    .OrderByDescending(i => i.IsOverdue).ThenBy(i => i.DueDate).ToList();
                if (col.Status == TaskWorkflow.Completed)
                {
                    items = items.OrderByDescending(i => i.DueDate).ToList(); // most recent first
                }
                <div class="sa-col sa-tone-@col.Tone">
                    <div class="sa-col__head">
                        <span class="sa-dot sa-tone-@col.Tone"></span>
                        <h5 class="sa-col__title">@col.Title</h5>
                        <span class="sa-col__count" data-count>@items.Count</span>
                    </div>
                    <div class="sa-col__cards">
                        @foreach (var i in items)
                        {
                            <a class="sa-kcard @(i.IsOverdue ? "is-overdue" : "")" data-division="@i.Division"
                               asp-controller="Dashboard" asp-action="Details" asp-route-id="@i.TaskId">
                                <div class="sa-kcard__top">
                                    @if (!string.IsNullOrEmpty(ShortDivision(i.Division)))
                                    {
                                        <span class="sa-tag" title="@i.Division">@ShortDivision(i.Division)</span>
                                    }
                                    @if (i.IsOverdue)
                                    {
                                        <span class="sa-tag sa-tag--overdue">Overdue</span>
                                    }
                                    else if (i.IsAtRisk)
                                    {
                                        <span class="sa-tag sa-tag--risk">At risk</span>
                                    }
                                </div>
                                <p class="sa-kcard__name">@i.TaskName</p>
                                <div class="sa-kcard__progress" title="@i.Progress% done">
                                    <div class="sa-kcard__bar"><div style="width:@(i.Progress)%;"></div></div>
                                    <span>@i.Progress%</span>
                                </div>
                                <div class="sa-kcard__foot">
                                    <span class="sa-person">
                                        <span class="sa-avatar">@Initials(i.AssigneeName)</span>
                                        <span class="sa-person__name">@i.AssigneeName</span>
                                    </span>
                                    <span class="sa-due @(i.IsOverdue ? "is-late" : "")">
                                        @(col.Status == TaskWorkflow.Completed ? $"Due {i.DueDate:MMM d}" : DueText(i.DueDate))
                                    </span>
                                </div>
                            </a>
                        }
                        <p class="sa-col__empty" hidden="@(items.Any() ? "hidden" : null)">Nothing here</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ── Overdue tasks ─────────────────────────────────── -->
    <section class="sa-section">
        <div class="sa-section__head">
            <h4 class="sa-section__title">Overdue Tasks <span class="sa-count sa-count--danger">@Model.OverdueCount</span></h4>
        </div>
        @if (!Model.OverdueItems.Any())
        {
            <div class="sa-empty-state sa-empty-state--good">
                <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
                Nothing overdue. Every task is on schedule.
            </div>
        }
        else
        {
            <div class="sa-table-wrap">
                <table class="sa-table">
                    <thead>
                        <tr>
                            <th>Task</th>
                            <th>Assignee</th>
                            <th>Division</th>
                            <th>Due Date</th>
                            <th>Progress</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.OverdueItems)
                        {
                            <tr>
                                <td><a class="sa-link" asp-controller="Dashboard" asp-action="Details" asp-route-id="@t.TaskId">@t.TaskName</a></td>
                                <td>
                                    <span class="sa-person">
                                        <span class="sa-avatar">@Initials(t.AssigneeName)</span>
                                        <span>@t.AssigneeName</span>
                                    </span>
                                </td>
                                <td class="td--muted" title="@t.Division">@(ShortDivision(t.Division) is { Length: > 0 } s ? s : "—")</td>
                                <td>
                                    <span class="td--overdue">@t.DueDate.ToString("MMM d, yyyy")</span>
                                    <span class="sa-late">@DueText(t.DueDate)</span>
                                </td>
                                <td>
                                    <div class="sa-kcard__progress sa-progress--table">
                                        <div class="sa-kcard__bar"><div style="width:@(t.Progress)%;"></div></div>
                                        <span>@t.Progress%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- ── Employee workload & productivity ──────────────── -->
    <section class="sa-section">
        <div class="sa-section__head">
            <div>
                <h4 class="sa-section__title">Employee Workload &amp; Productivity</h4>
                <p class="sa-section__sub">Efficiency is the share of each person's assignments that are completed.</p>
            </div>
        </div>
        @if (!Model.EmployeeWorkloads.Any())
        {
            <div class="sa-empty-state">No assigned tasks yet.</div>
        }
        else
        {
            string Num(int n, string extra = "") => n == 0 ? "td--zero" : extra;
            <div class="sa-table-wrap">
                <table class="sa-table sa-table--numbers">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Assigned</th>
                            <th>To Do</th>
                            <th>In Progress</th>
                            <th>For Review</th>
                            <th>Returned</th>
                            <th>Completed</th>
                            <th>Overdue</th>
                            <th>At Risk</th>
                            <th>Efficiency</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in Model.EmployeeWorkloads)
                        {
                            <tr>
                                <td>
                                    <span class="sa-person">
                                        <span class="sa-avatar">@Initials(w.FullName)</span>
                                        <span class="td--strong">@w.FullName</span>
                                    </span>
                                </td>
                                <td class="td--strong">@w.TotalAssigned</td>
                                <td class="@Num(w.ToDo)">@w.ToDo</td>
                                <td class="@Num(w.InProgress)">@w.InProgress</td>
                                <td class="@Num(w.ForReview)">@w.ForReview</td>
                                <td class="@Num(w.ReturnedForCorrection)">@w.ReturnedForCorrection</td>
                                <td class="@Num(w.Completed)">@w.Completed</td>
                                <td class="@Num(w.Overdue, "td--danger-count")">@w.Overdue</td>
                                <td class="@Num(w.AtRisk, "td--risk-count")">@w.AtRisk</td>
                                <td>
                                    <div class="sa-kcard__progress sa-progress--table sa-progress--green">
                                        <div class="sa-kcard__bar"><div style="width:@(w.EfficiencyPercent)%;"></div></div>
                                        <span>@w.EfficiencyPercent%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

</div>

@section Scripts {
    <script src="~/js/superadmin-dashboard.js" asp-append-version="true"></script>
}
