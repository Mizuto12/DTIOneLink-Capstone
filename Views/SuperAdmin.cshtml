@model DTIOneLink.Models.SuperAdminDashboardViewModel
@{
    Layout = "~/Views/SuperAdmin/SuperAdminLayout.cshtml";
    ViewData["Title"] = "Super Admin Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/superadmin.css" asp-append-version="true" />
}

<div class="sa-dashboard">

    <!-- ── Summary Cards ─────────────────────────────────── -->
    <section class="sa-cards">
        <div class="sa-card">
            <p class="sa-card__label">Total Tasks</p>
            <p class="sa-card__value">@Model.TotalTasks</p>
        </div>
        <div class="sa-card">
            <p class="sa-card__label">To Do</p>
            <p class="sa-card__value">@Model.TodoCount</p>
        </div>
        <div class="sa-card">
            <p class="sa-card__label">In Progress</p>
            <p class="sa-card__value sa-card__value--inprogress">@Model.InProgressCount</p>
        </div>
        <div class="sa-card">
            <p class="sa-card__label">Completed</p>
            <p class="sa-card__value sa-card__value--completed">@Model.CompletedCount</p>
        </div>
        <div class="sa-card">
            <p class="sa-card__label">Overdue</p>
            <p class="sa-card__value sa-card__value--overdue">@Model.OverdueCount</p>
        </div>
    </section>

    <!-- ── Status Distribution ───────────────────────────── -->
    <section class="sa-section">
        <h4 class="sa-section__title">Status Distribution</h4>
        @if (Model.TotalTasks == 0)
        {
            <div class="sa-empty-state">No tasks recorded yet.</div>
        }
        else
        {
            <div class="sa-status-bar">
                <div class="sa-status-bar__segment--todo" style="width:@(Model.TodoPercent)%;" title="To Do @Model.TodoPercent%"></div>
                <div class="sa-status-bar__segment--inprogress" style="width:@(Model.InProgressPercent)%;" title="In Progress @Model.InProgressPercent%"></div>
                <div class="sa-status-bar__segment--completed" style="width:@(Model.CompletedPercent)%;" title="Completed @Model.CompletedPercent%"></div>
            </div>
            <div class="sa-status-legend">
                <span><span class="sa-status-legend__dot sa-status-legend__dot--todo"></span>To Do — @Model.TodoCount (@Model.TodoPercent%)</span>
                <span><span class="sa-status-legend__dot sa-status-legend__dot--inprogress"></span>In Progress — @Model.InProgressCount (@Model.InProgressPercent%)</span>
                <span><span class="sa-status-legend__dot sa-status-legend__dot--completed"></span>Completed — @Model.CompletedCount (@Model.CompletedPercent%)</span>
                <span class="sa-status-legend__efficiency">Overall Efficiency: @Model.OverallEfficiencyPercent%</span>
            </div>
        }
    </section>

    <!-- ── Overdue Tasks ─────────────────────────────────── -->
    <section class="sa-section">
        <h4 class="sa-section__title">Overdue Tasks (@Model.OverdueCount)</h4>
        @if (!Model.OverdueTasks.Any())
        {
            <div class="sa-empty-state">Nothing overdue.</div>
        }
        else
        {
            <table class="sa-table">
                <thead>
                    <tr>
                        <th>Task</th>
                        <th>Assignee</th>
                        <th>Due Date</th>
                        <th>Progress</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.OverdueTasks)
                    {
                        <tr>
                            <td>@t.TaskName</td>
                            <td class="td--muted">@(t.Assignee?.FullName ?? "Unassigned")</td>
                            <td class="td--overdue">@t.DueDate.ToString("MMM d, yyyy")</td>
                            <td>@t.Progress%</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <!-- ── Employee Workload & Productivity ──────────────── -->
    <section class="sa-section">
        <h4 class="sa-section__title">Employee Workload &amp; Productivity</h4>
        @if (!Model.EmployeeWorkloads.Any())
        {
            <div class="sa-empty-state">No assigned tasks yet.</div>
        }
        else
        {
            <table class="sa-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Assigned</th>
                        <th>To Do</th>
                        <th>In Progress</th>
                        <th>Completed</th>
                        <th>Overdue</th>
                        <th>Efficiency</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in Model.EmployeeWorkloads)
                    {
                        <tr>
                            <td class="td--strong">@w.FullName</td>
                            <td>@w.TotalAssigned</td>
                            <td>@w.ToDo</td>
                            <td>@w.InProgress</td>
                            <td>@w.Completed</td>
                            <td class="@(w.Overdue > 0 ? "td--danger-count" : "")">@w.Overdue</td>
                            <td class="td--strong">@w.EfficiencyPercent%</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}