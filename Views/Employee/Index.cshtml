@model IEnumerable<DTIOneLink.Models.TaskItem>
@using DTIOneLink.Services
@{
    Layout = "~/Views/Employee/employeelayout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["LiveRefresh"] = true; // auto-refresh when data changes (live-refresh.js)

    // Employee workspace (Canva pages 1–2): To Do and In Progress boards, a
    // compact task calendar that expands in place, and "My progress".
    // The task list comes from EmployeeController.Index (only tasks this
    // person is assigned to). On a shared task they see only their own
    // status and progress, never a co-assignee's.
    var tasks = Model?.ToList() ?? new List<DTIOneLink.Models.TaskItem>();
    var viewerId = Context.Session.GetInt32("UserId");
    var today = TimeZoneHelper.PhilippineToday;

    DTIOneLink.Models.TaskAssignment? Mine(DTIOneLink.Models.TaskItem t) =>
        t.Assignments?.FirstOrDefault(a => a.UserId == viewerId);

    // One of the five workflow statuses (older free-text values mapped by keyword).
    string StatusOf(DTIOneLink.Models.TaskItem t)
    {
        var s = TaskWorkflow.Normalize(Mine(t)?.Status ?? t.Status);
        if (s is TaskWorkflow.Pending or TaskWorkflow.InProgress or TaskWorkflow.ForReview
            or TaskWorkflow.ReturnedForCorrection or TaskWorkflow.Completed) return s;
        if (s.Contains("complet") || s == "done") return TaskWorkflow.Completed;
        if (s.Contains("review")) return TaskWorkflow.ForReview;
        if (s.Contains("return")) return TaskWorkflow.ReturnedForCorrection;
        if (s.Contains("progress") || s.Contains("ongoing")) return TaskWorkflow.InProgress;
        return TaskWorkflow.Pending;
    }
    int ProgressOf(DTIOneLink.Models.TaskItem t) => Mine(t)?.Progress ?? t.Progress;
    string? PersonOf(DTIOneLink.Models.TaskItem t) => Mine(t)?.User?.FullName ?? t.Assignee?.FullName;
    bool IsOverdue(DTIOneLink.Models.TaskItem t) => TaskWorkflow.IsOverdue(StatusOf(t), t.DueDate);
    bool IsAtRisk(DTIOneLink.Models.TaskItem t) =>
        TaskWorkflow.DelayRisk(StatusOf(t), ProgressOf(t), t.CreatedAt, t.DueDate) is { AtRisk: true };

    var statusInfo = new Dictionary<string, (string Label, string Tone)>
    {
        [TaskWorkflow.Pending] = ("To Do", "todo"),
        [TaskWorkflow.InProgress] = ("In Progress", "progress"),
        [TaskWorkflow.ForReview] = ("For Review", "review"),
        [TaskWorkflow.ReturnedForCorrection] = ("Returned", "returned"),
        [TaskWorkflow.Completed] = ("Completed", "completed"),
    };

    var divisionShort = new Dictionary<string, string>
    {
        ["Business Development Division"] = "BDD",
        ["Consumer Protection Division"] = "CPD",
        ["Financial and Administrative Unit"] = "FAU",
        ["Office of the Provincial Director"] = "OPD",
    };
    string? DivisionOf(DTIOneLink.Models.TaskItem t)
    {
        var dept = t.OwningDepartment ?? t.ParentTask?.OwningDepartment;
        return dept != null && divisionShort.TryGetValue(dept, out var s) ? s : null;
    }

    string TitleCase(string? s) => string.IsNullOrWhiteSpace(s) ? "" : char.ToUpper(s.Trim()[0]) + s.Trim().Substring(1).ToLowerInvariant();

    string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(p => char.IsLetter(p[0])).ToArray();
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}".ToUpper() : name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    string DueText(DateTime due)
    {
        var days = (due.Date - today).Days;
        return days switch
        {
            < -1 => $"{-days} days late",
            -1 => "1 day late",
            0 => "Due today",
            1 => "Due tomorrow",
            _ => "Due " + DTIOneLink.Helpers.DisplayHelpers.FormalMonthDay(due)
        };
    }

    // Boards shown on the dashboard (the full five-status board is Task Management).
    var boards = new[]
    {
        (Key: TaskWorkflow.Pending,    Empty: "Nothing waiting to start."),
        (Key: TaskWorkflow.InProgress, Empty: "Nothing in progress."),
    };

    // My progress: the employee's own task counts only — no percentages or
    // scores (staff ratings are tracked in DTI's PGS Dashboard, not here).
    var total = tasks.Count;
    var progressStats = new[]
    {
        (Label: "Completed",   Value: tasks.Count(t => StatusOf(t) == TaskWorkflow.Completed), Tone: "completed"),
        (Label: "In Progress", Value: tasks.Count(t => StatusOf(t) == TaskWorkflow.InProgress), Tone: "progress"),
        (Label: "For Review",  Value: tasks.Count(t => StatusOf(t) == TaskWorkflow.ForReview), Tone: "review"),
        (Label: "Returned",    Value: tasks.Count(t => StatusOf(t) == TaskWorkflow.ReturnedForCorrection), Tone: "returned"),
        (Label: "Overdue",     Value: tasks.Count(IsOverdue), Tone: "overdue"),
    };

    // Calendar data: this employee's active tasks only (completed work isn't
    // listed by day), with just what the calendar shows.
    var calendarItems = tasks.Where(t => StatusOf(t) != TaskWorkflow.Completed).Select(t =>
    {
        var status = StatusOf(t);
        var info = statusInfo[status];
        var assignedUtc = Mine(t)?.AssignedAt ?? t.CreatedAt;
        return new
        {
            id = t.Id,
            title = t.ParentTask?.TaskName ?? t.TaskName,
            subtask = t.ParentTask != null ? t.TaskName : null,
            due = t.DueDate.ToString("yyyy-MM-dd"),
            assigned = TimeZoneHelper.ToPhilippineTime(assignedUtc).ToString("yyyy-MM-dd"),
            status = info.Label,
            tone = IsOverdue(t) ? "overdue" : info.Tone,
            overdue = IsOverdue(t),
            priority = TitleCase(t.Priority),
            priorityKey = (t.Priority ?? "").Trim().ToLowerInvariant(),
            progress = ProgressOf(t),
            url = Url.Action("Details", "Dashboard", new { id = t.Id })
        };
    }).ToList();
    var calendarJson = System.Text.Json.JsonSerializer.Serialize(calendarItems);
}

@section Styles {
    <link rel="stylesheet" href="~/css/employee-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/completion-trend.css" asp-append-version="true" />
}

<div class="ed" id="employeeDashboard" data-today="@today.ToString("yyyy-MM-dd")">

    <!-- ── Workspace: boards + calendar preview + my progress ───────── -->
    <div class="ed-workspace" id="edWorkspace">

        <div class="ed-boards">
            @foreach (var b in boards)
            {
                var info = statusInfo[b.Key];
                var boardTasks = tasks.Where(t => StatusOf(t) == b.Key)
                    .OrderByDescending(IsOverdue)
                    .ThenBy(t => t.DueDate)
                    .ToList();
                <section class="ed-col ed-tone-@info.Tone" aria-labelledby="edCol-@info.Tone">
                    <header class="ed-col__head">
                        <span class="ed-col__dot" aria-hidden="true"></span>
                        <h2 class="ed-col__title" id="edCol-@info.Tone">@info.Label</h2>
                        <span class="ed-col__count">@boardTasks.Count</span>
                    </header>
                    <div class="ed-col__cards">
                        @if (!boardTasks.Any())
                        {
                            <p class="ed-empty">@b.Empty</p>
                        }
                        @foreach (var task in boardTasks)
                        {
                            var overdue = IsOverdue(task);
                            var atRisk = IsAtRisk(task);
                            var progress = ProgressOf(task);
                            var division = DivisionOf(task);
                            var priorityKey = (task.Priority ?? "").Trim().ToLowerInvariant();
                            <a class="ed-card" href="@Url.Action("Details", "Dashboard", new { id = task.Id })">
                                <span class="ed-card__tags">
                                    <span class="ed-card__dot @(overdue ? "is-overdue" : atRisk ? "is-risk" : "")" aria-hidden="true"></span>
                                    @if (division != null)
                                    {
                                        <span class="ed-tag ed-tag--division">@division</span>
                                    }
                                    @if (priorityKey is "high" or "medium" or "low")
                                    {
                                        <span class="ed-prio ed-prio--@priorityKey">@TitleCase(task.Priority)</span>
                                    }
                                    @if (overdue)
                                    {
                                        <span class="ed-card__status is-overdue">Overdue</span>
                                    }
                                    else if (atRisk)
                                    {
                                        <span class="ed-card__status is-risk">At risk</span>
                                    }
                                </span>
                                <span class="ed-card__title">@task.TaskName</span>
                                <span class="ed-card__progress" title="@progress% done">
                                    <span class="ed-bar"><span style="width:@progress%;"></span></span>
                                    <span class="ed-card__pct">@progress%</span>
                                </span>
                                <span class="ed-card__foot">
                                    <span class="ed-person">
                                        <span class="ed-avatar" aria-hidden="true">@Initials(PersonOf(task))</span>
                                        <span class="ed-person__name">@(PersonOf(task) ?? "Unassigned")</span>
                                    </span>
                                    <span class="ed-due @(overdue ? "is-late" : "")">@DueText(task.DueDate)</span>
                                </span>
                            </a>
                        }
                    </div>
                </section>
            }
        </div>

        <div class="ed-rule" aria-hidden="true"></div>

        <aside class="ed-side" aria-label="Progress, calendar, records, and trend">
            <!-- My progress: leads the sidebar — the number worth checking
                 first, before the calendar or anything else. -->
            <section class="ed-progress" aria-labelledby="edProgressTitle">
                <div class="ed-progress__head">
                    <span class="ed-progress__badge" aria-hidden="true"><span class="material-symbols-outlined">fact_check</span></span>
                    <h2 class="ed-progress__title" id="edProgressTitle">My progress</h2>
                </div>
                <div class="ed-progress__hero">
                    <span class="ed-progress__hero-num">@total</span>
                    <span class="ed-progress__hero-label">task@(total == 1 ? "" : "s") assigned to you</span>
                </div>
                <dl class="ed-progress__stats">
                    @foreach (var s in progressStats.Where(s => s.Tone != "overdue"))
                    {
                        <div class="ed-stat ed-tone-@s.Tone">
                            <dt><span class="ed-stat__dot" aria-hidden="true"></span>@s.Label</dt>
                            <dd>@s.Value</dd>
                        </div>
                    }
                    @{ var overdueStat = progressStats.First(s => s.Tone == "overdue"); }
                    <div class="ed-stat ed-stat--overdue">
                        <dt><span class="material-symbols-outlined" aria-hidden="true">warning</span>@overdueStat.Label</dt>
                        <dd>@overdueStat.Value</dd>
                    </div>
                </dl>
                <a class="ed-progress__cta" asp-controller="Employee" asp-action="TaskManagement">
                    Open Task Management
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                </a>
            </section>

            <!-- Task calendar: blue dot = a task due that day; the list under it is
                 the selected day's To Do tasks (employee-dashboard.js). -->
            <section class="ed-progress ed-calpanel" aria-labelledby="edCalTitle">
                <div class="ed-progress__head">
                    <div>
                        <span class="ed-progress__badge" aria-hidden="true"><span class="material-symbols-outlined">calendar_today</span></span>
                        <h2 class="ed-progress__title" id="edCalTitle">Task calendar</h2>
                    </div>
                    <button type="button" class="ed-link" id="edCalExpand" aria-controls="edCalendar" aria-expanded="false">
                        Expand
                        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                    </button>
                </div>
                <div class="ed-cal" data-cal="compact">
                    <div class="ed-cal__head">
                        <button type="button" class="ed-cal__nav" data-step="-1" aria-label="Previous month">
                            <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                        </button>
                        <div class="ed-cal__pickers">
                            <select class="ed-cal__month" aria-label="Month"></select>
                            <select class="ed-cal__year" aria-label="Year"></select>
                        </div>
                        <button type="button" class="ed-cal__nav" data-step="1" aria-label="Next month">
                            <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                        </button>
                    </div>
                    <div class="ed-cal__weekdays" aria-hidden="true"><span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span></div>
                    <div class="ed-cal__grid"></div>
                    <div class="ed-cal__foot">
                        <button type="button" class="ed-cal__today">Today</button>
                    </div>
                </div>
                <div class="ed-day-panel" data-panel="compact" aria-live="polite"></div>
            </section>

            <!-- Records overview: same component already on SuperAdmin's
                 rail (records-overview.js, RecordsController.Overview),
                 scoped here to the records this employee has personally
                 logged — Employee doesn't manage/approve, so it's the same
                 "own records" scope Admin's own dashboard widget uses. -->
            <section class="ed-progress" aria-label="Records overview" id="recordsOverview">
                <div class="ed-progress__head">
                    <span class="ed-progress__badge" aria-hidden="true"><span class="material-symbols-outlined">folder_open</span></span>
                    <div>
                        <h2 class="ed-progress__title">Records overview</h2>
                        <p class="ed-progress__sub">Records you've logged.</p>
                    </div>
                </div>
                <div class="records-overview__cards" id="recordsOverviewCards" aria-busy="true">
                    @for (var i = 0; i < 4; i++)
                    {
                        <div class="ro-card ro-card--skeleton" aria-hidden="true">
                            <span class="ro-card__icon skeleton skeleton-circle"></span>
                            <div>
                                <span class="skeleton ro-skel-value"></span>
                                <span class="skeleton ro-skel-label"></span>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- Completion Trend: this employee's own weekly approved-submission
                 count. Filled in by completion-trend.js
                 (DashboardController.GetCompletionTrend). -->
            <section class="ed-progress" aria-labelledby="edTrendTitle">
                <div class="ed-progress__head">
                    <span class="ed-progress__badge" aria-hidden="true"><span class="material-symbols-outlined">assessment</span></span>
                    <div>
                        <h2 class="ed-progress__title" id="edTrendTitle">Completion trend</h2>
                        <p class="ed-progress__sub" id="completionTrendSub">Tasks you completed per week, last 8 weeks.</p>
                    </div>
                </div>
                <div class="ct-widget">
                    <div class="ct-chart ct-skeleton" id="completionTrendChart" aria-busy="true" aria-label="Completion trend chart"></div>
                </div>
                <span class="visually-hidden" id="completionTrendScope">You</span>
            </section>
        </aside>
    </div>

    <!-- Expanded view (opened with "Expand"): calendar on one half, the
         selected day's work on the other; shown in place of the layout above. -->
    <section class="ed-expanded" id="edCalendar" aria-label="Task calendar, expanded" hidden>
        <div class="ed-expanded__bar">
            <button type="button" class="ed-btn" id="edCalClose">
                <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                Back to dashboard
            </button>
        </div>
        <div class="ed-expanded__body">
            <div class="ed-cal ed-cal--large" data-cal="large">
                <div class="ed-cal__head">
                    <button type="button" class="ed-cal__nav" data-step="-1" aria-label="Previous month">
                        <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                    </button>
                    <div class="ed-cal__pickers">
                        <select class="ed-cal__month" aria-label="Month"></select>
                        <select class="ed-cal__year" aria-label="Year"></select>
                    </div>
                    <button type="button" class="ed-cal__nav" data-step="1" aria-label="Next month">
                        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                    </button>
                </div>
                <div class="ed-cal__weekdays" aria-hidden="true"><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span></div>
                <div class="ed-cal__grid"></div>
                <div class="ed-cal__foot">
                    <button type="button" class="ed-cal__today">Today</button>
                </div>
            </div>
            <div class="ed-day-panel ed-day-panel--large" data-panel="large" aria-live="polite"></div>
        </div>
    </section>
</div>

@* Real task data for the calendar (this employee's tasks only). *@
<script type="application/json" id="edTaskData">@Html.Raw(calendarJson)</script>

@section Scripts {
    <script src="~/js/employee-dashboard.js" asp-append-version="true"></script>
    <script src="~/js/completion-trend.js" asp-append-version="true" defer></script>
    <script src="~/js/records-overview.js" asp-append-version="true" defer></script>
}
