@model DTIOneLink.Models.TaskItem
@{
    // Shared by Details.cshtml (its own page) and SubmitProof.cshtml (as the
    // real page dimmed behind the Submit Proof modal) — same content either
    // way, just rendered inert in the second case.
    var role = Context.Session.GetString("UserRole");
    var isElevated = role == "Admin" || role == "Supervisor" || role == "SuperAdmin";

    var task = Model;
    var taskCode = $"TASK-{task.Id:D4}";
    var previewableExtensions = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { ".pdf", ".jpg", ".jpeg", ".png" };

    var status = (task.Status ?? "pending").Trim().ToLowerInvariant();
    var isOverdue = DTIOneLink.Services.TaskWorkflow.IsOverdue(status, task.DueDate);
    var today = DTIOneLink.Services.TimeZoneHelper.PhilippineToday;

   (string CssClass, string Label) StatusInfo()
{
    if (isOverdue) return ("overdue", "Overdue");
    return status switch
    {
        "in-progress" => ("in-progress", "In Progress"),
        "for-review" => ("for-review", "For Review"),
        "returned-for-correction" => ("returned", "Returned for Correction"),
        "completed" => ("completed", "Completed"),
        _ => ("todo", "To Do")
    };
}
    var (statusClass, statusLabel) = StatusInfo();

    string PriorityClass(string? priority) => (priority ?? "medium").Trim().ToLowerInvariant() switch
    {
        "high" => "high",
        "low" => "low",
        _ => "medium"
    };

    string PriorityLabel(string? priority)
    {
        var p = (priority ?? "medium").Trim().ToLowerInvariant();
        return char.ToUpperInvariant(p[0]) + p.Substring(1) + " Priority";
    }

        // Null for tasks created before CreatedByUserId existed — shown as
    // "Unknown" rather than guessed at.
    var creatorName = task.CreatedBy?.FullName;
    var creatorLabel = string.IsNullOrWhiteSpace(creatorName)
        ? "Unknown"
        : creatorName;

    // The signed-in user's own assignment on this task (null if they aren't
    // an assignee). The progress ring/slider edits only this row, and only
    // while it is To Do / In Progress — the same rules EmployeeController.UpdateProgress
    // enforces on the server.
    var viewerId = Context.Session.GetInt32("UserId");
    var myAssignment = viewerId.HasValue
        ? task.Assignments?.FirstOrDefault(a => a.UserId == viewerId.Value)
        : null;
    var myAssignmentStatus = (myAssignment?.Status ?? "").Trim().ToLowerInvariant();
    var canEditProgress = myAssignment != null
        && (myAssignmentStatus == "pending" || myAssignmentStatus == "in-progress");
    var sliderProgress = canEditProgress ? myAssignment!.Progress : task.Progress;

    // An Employee on a shared task sees only their own part of it: their own
    // name and progress, never a co-assignee's. Admins see the whole task.
    var isEmployeeView = !isElevated && myAssignment != null;
    var shownAssignee = isEmployeeView ? Context.Session.GetString("FullName") : task.Assignee?.FullName;
    var shownProgress = isEmployeeView ? myAssignment!.Progress : task.Progress;

    // Whether proof can be submitted right now, and how far from unlocked —
    // computed once here so the progress hero can show it as a headline
    // instead of a footnote under a greyed-out button.
    var minProgress = DTIOneLink.Services.TaskWorkflow.MinProgressToSubmitProof;
    var canSubmitProofNow = DTIOneLink.Services.TaskWorkflow.CanSubmitProof(status, sliderProgress);
    var pointsToUnlock = Math.Max(0, minProgress - sliderProgress);

    // How overdue, or how much runway is left — a concrete number the
    // "Overdue" badge alone doesn't give you.
    var daysLate = isOverdue ? (today - task.DueDate.Date).Days : 0;
    var daysLeft = !isOverdue ? (task.DueDate.Date - today).Days : 0;

    // Assignees may permanently delete a task once it is fully Completed.
    // EmployeeController.Delete re-checks all of this on the server.
    var canDeleteTask = myAssignment != null
        && status == "completed"
        && task.TaskLevel != DTIOneLink.Services.TaskLevels.Main;

    string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "NA";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
    }

    // Progress ring geometry: r=58, circumference = 2*pi*58.
    const double ringCircumference = 364.425;
    var ringOffset = ringCircumference * (1 - (sliderProgress / 100.0));
    var ringOffsetStr = ringOffset.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    var currentUserInitials = GetInitials(Context.Session.GetString("FullName"));
}

<div class="task-details">
    <nav class="td-breadcrumb" aria-label="Breadcrumb">
        @if (isElevated)
        {
            <a asp-controller="Tasks" asp-action="Index">Task Management</a>
        }
        else
        {
            <a asp-controller="Employee" asp-action="TaskManagement">Task Management</a>
        }
        <span>/</span>
        <span class="td-breadcrumb-current">@taskCode</span>
    </nav>

    @if (TempData["ErrorMessage"] is string detailsError)
    {
        <div class="td-alert error" role="alert">
            <span class="material-symbols-outlined">error</span>
            <span>@detailsError</span>
        </div>
    }

    <div class="td-grid">
        <!-- Left column: Task Details card + Comments card, stacked -->
        <div class="td-main-column">

            <!-- Task Details card -->
            <div class="td-panel">
                <section class="td-header">
                    <div class="td-header-row">
                        <div class="td-icon-badge" aria-hidden="true">
                            <span class="material-symbols-outlined">task_alt</span>
                        </div>
                        <div class="td-header-text">
                            <div class="td-eyebrow">
                                <button type="button" class="td-code-btn" id="copyTaskCode" data-code="@taskCode" title="Copy task code">
                                    @taskCode
                                </button>
                            </div>
                            <h2 class="td-title">@task.TaskName</h2>
                            <div class="td-badges">
                                <span class="td-badge @statusClass" id="tdStatusBadge">
                                    <span class="td-badge-dot"></span> <span id="tdStatusBadgeText">@statusLabel</span>
                                </span>
                                <span class="td-badge priority-@PriorityClass(task.Priority)">
                                    <span class="td-badge-dot"></span> @PriorityLabel(task.Priority)
                                </span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Due Date pairs with a concrete "how overdue / how much
                     runway" fact instead of repeating the Overdue badge or
                     the Progress number a second and third time. -->
                <section class="td-meta-grid">
                    <div class="td-meta-tile @(isOverdue ? "is-danger" : "")">
                        <span class="td-meta-icon material-symbols-outlined" aria-hidden="true">calendar_today</span>
                        <div>
                            <h3>Due Date</h3>
                            <p>@DTIOneLink.Helpers.DisplayHelpers.FormalDate(task.DueDate)</p>
                        </div>
                    </div>
                    <div class="td-meta-tile @(isOverdue ? "is-danger" : "")">
                        <span class="td-meta-icon material-symbols-outlined" aria-hidden="true">schedule</span>
                        <div>
                            @if (isOverdue)
                            {
                                <h3>Days Late</h3>
                                <p>@daysLate day@(daysLate == 1 ? "" : "s")</p>
                            }
                            else
                            {
                                <h3>Days Left</h3>
                                <p>@daysLeft day@(daysLeft == 1 ? "" : "s")</p>
                            }
                        </div>
                    </div>
                </section>

                <section class="td-progress-section">
                    <div class="td-progress-hero">
                        <svg class="td-progress-ring" viewBox="0 0 140 140" aria-hidden="true">
                            <circle class="td-progress-ring-track" cx="70" cy="70" r="58"></circle>
                            <circle class="td-progress-ring-arc" id="tdProgressRingArc" cx="70" cy="70" r="58"
                                    style="stroke-dasharray:@(ringCircumference.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)); stroke-dashoffset:@ringOffsetStr;"></circle>
                            <text class="td-progress-ring-value" id="tdProgressRingValue" x="70" y="64" text-anchor="middle">@(sliderProgress)%</text>
                            <text class="td-progress-ring-label" x="70" y="85" text-anchor="middle">@(canEditProgress ? "your progress" : "progress")</text>
                        </svg>
                        <div class="td-progress-hero-body">
                            @if (canEditProgress)
                            {
                                @* Assignee's own progress: drag (or use arrow keys) and it
                                   saves automatically when released. *@
                                <div class="td-unlock-gate" id="tdUnlockGate" @(canSubmitProofNow ? "hidden" : null)>
                                    <span class="material-symbols-outlined" aria-hidden="true">lock</span>
                                    <span id="tdUnlockGateText">@pointsToUnlock points to go to unlock Submit Proof</span>
                                </div>
                                <p class="td-progress-hero-hint">Proof can be submitted once progress reaches @(minProgress)%, or any time once the task is returned for correction.</p>
                                <input type="range"
                                       class="td-progress-range"
                                       id="tdProgressRange"
                                       min="0" max="100" step="1"
                                       value="@sliderProgress"
                                       style="--pct: @(sliderProgress)%"
                                       data-task-id="@task.Id"
                                       data-overdue="@(isOverdue ? "true" : "false")"
                                       data-min-progress="@minProgress"
                                       aria-labelledby="tdProgressLabel"
                                       aria-valuetext="@(sliderProgress) percent" />
                                <span id="tdProgressLabel" class="visually-hidden">Your progress</span>
                                <p class="td-progress-hint" id="tdProgressHint" aria-live="polite">
                                    Drag the slider to update your progress. It saves automatically.
                                </p>
                            }
                            else
                            {
                                <p class="td-progress-hero-hint">This reflects @(isEmployeeView ? "your" : (shownAssignee ?? "the assignee") + "'s") current progress on this task.</p>
                            }
                        </div>
                    </div>
                </section>

                @if (myAssignment != null && myAssignment.ChecklistItems.Any())
                {
                    <section class="td-description">
                        <h3>Checklist</h3>
                        <p class="td-progress-hero-hint">Your progress above is set by this checklist, not the slider.</p>
                        <ul class="td-checklist-list">
                            @foreach (var item in myAssignment.ChecklistItems.OrderBy(i => i.Id))
                            {
                                <li class="td-checklist-item">
                                    <form asp-controller="Employee" asp-action="ToggleChecklistItem" method="post"
                                          data-checklist-toggle-form class="td-checklist-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <label class="td-checklist-label">
                                            <input type="checkbox" checked="@(item.IsDone ? "checked" : null)"
                                                   @(canEditProgress ? "" : "disabled")
                                                   onchange="this.form.submit()" />
                                            <span class="@(item.IsDone ? "is-done" : "")">@item.Label</span>
                                        </label>
                                    </form>
                                </li>
                            }
                        </ul>
                    </section>
                }

                <section class="td-description">
                    <h3>Description</h3>
                    @if (string.IsNullOrWhiteSpace(task.Description))
                    {
                        <p class="td-empty">No description provided.</p>
                    }
                    else
                    {
                        <p>@task.Description</p>
                    }
                </section>
                @{
                    // Was task.AssigneeId (the legacy single-assignee column),
                    // which only ever reflects the "primary" assignee — on a
                    // multi-assignee task (e.g. Whole Office) a genuinely
                    // assigned co-assignee, including an Admin assigned this
                    // way, isn't necessarily that primary one, so Submit
                    // Proof stayed hidden for them. myAssignment (above) is
                    // the real, per-user TaskAssignments lookup already used
                    // for the progress slider; reusing it here instead.
                    var isAssignee = myAssignment != null;
                }
                <div class="td-actions">
                    <button type="button" class="btn btn-secondary" id="tdBackButton">
                        <span class="material-symbols-outlined">arrow_back</span>
                        Back
                    </button>
                    @if (isAssignee)
                    {
                        @if (status == "pending" || status == "in-progress")
                        {
                            var myProgress = myAssignment?.Progress ?? task.Progress;
                            var canSubmitProof = DTIOneLink.Services.TaskWorkflow.CanSubmitProof(status, myProgress);
                            @* Same element either way — JS flips the lock state live as the
                               progress slider moves (data-min-progress), instead of needing
                               a page reload once the threshold is crossed. *@
                            <div class="td-submit-gate" id="tdSubmitGate" data-min-progress="@minProgress">
                                <a asp-controller="Employee" asp-action="SubmitProof" asp-route-id="@task.Id"
                                   id="tdSubmitProofBtn"
                                   class="btn btn-primary @(canSubmitProof ? "" : "is-locked")"
                                   aria-disabled="@(canSubmitProof ? "false" : "true")"
                                   tabindex="@(canSubmitProof ? "0" : "-1")"
                                   title="@(canSubmitProof ? "" : $"Reach at least {minProgress}% progress to submit proof.")">
                                    <span class="material-symbols-outlined">upload</span>
                                    Submit Proof
                                </a>
                            </div>
                        }
                        @if (status == "returned-for-correction")
                        {
                            <a asp-controller="Employee" asp-action="SubmitProof" asp-route-id="@task.Id" class="btn btn-primary">
                                <span class="material-symbols-outlined">upload</span>
                                Resubmit
                            </a>
                        }
                    }
                    @if (canDeleteTask)
                    {
                        <form asp-controller="Employee" asp-action="Delete" method="post" class="td-delete-form" id="tdDeleteForm"
                              data-task-name="@task.TaskName">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@task.Id" />
                            <button type="submit" class="btn btn-danger">
                                <span class="material-symbols-outlined">delete</span>
                                Delete Task
                            </button>
                        </form>
                    }
                </div>
            </div>
            <!-- /Task Details card -->

            <!-- Comments card -->
            <div class="td-panel td-comments-card">
    <section class="td-comments">
        <h3>
            Comments
            @{ var commentCount = task.Comments?.Count ?? 0; }
            <span class="td-comments-count">(@commentCount)</span>
        </h3>

        @{
            var comments = task.Comments?.OrderByDescending(c => c.CreatedAt).ToList() ?? new();
        }
        @if (comments.Any())
        {
            <ul class="td-comment-list">
                @foreach (var comment in comments)
                {
                    var commentTime = DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(comment.CreatedAt);
                    <li>
                        <div class="avatar-initials-sm" aria-hidden="true">@GetInitials(comment.Author?.FullName)</div>
                        <div class="td-comment-body">
                            <div class="td-comment-header">
                                <span class="td-comment-author">@(comment.Author?.FullName ?? "Unknown")</span>
                                <span class="td-comment-date">@commentTime.ToString("MMM d, yyyy, h:mm tt")</span>
                            </div>
                            <p class="td-comment-text">@comment.Text</p>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="td-empty">No comments yet.</p>
        }

        <form asp-controller="Employee" asp-action="AddComment" method="post" class="td-comment-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="taskId" value="@task.Id" />
            <div class="avatar-initials-sm" aria-hidden="true">@currentUserInitials</div>
            <div class="td-comment-form-body">
                <textarea name="text" class="td-comment-input" placeholder="Write a comment..." rows="2" maxlength="1000" required>@TempData["CommentDraft"]</textarea>
                <button type="submit" class="btn btn-primary td-comment-submit">
                    <span class="material-symbols-outlined">send</span>
                    Comment
                </button>
            </div>
        </form>
    </section>
</div>
            <!-- /Comments card -->

        </div>
        <!-- /Left column -->

        <!-- Sidebar -->
        <aside class="td-sidebar">
            <h3 class="td-sidebar-title">Task Overview</h3>

            <div class="td-overview-assignee">
                <div class="avatar-initials-lg">@GetInitials(shownAssignee)</div>
                <div>
                    <div class="td-overview-name">@(shownAssignee ?? "Unassigned")</div>
                    <div class="td-overview-role">Assignee</div>
                </div>
            </div>

            <dl class="td-overview-list">
                <div>
                    <dt>Priority</dt>
                    <dd>@PriorityLabel(task.Priority)</dd>
                </div>
                <div>
                    <dt>Task Progress</dt>
                    <dd id="tdMetaProgress">@task.Progress%</dd>
                </div>
                <div>
                    <dt>Created</dt>
                    <dd>@task.CreatedAt.ToString("MMM d, yyyy")</dd>
                </div>
                 <div>
                    <dt>Created by</dt>
                    <dd>@creatorLabel</dd>
                </div>
            </dl>

                       @{
                // Chronological order, newest first — including task creation,
                // which used to always render first regardless of its actual
                // date, so a task created a month before its newest activity
                // still showed "Created this task" above everything else.
                var activityEntries = (task.Activities ?? new List<DTIOneLink.Models.TaskActivity>())
                    .Select(a => new
                    {
                        When = DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(a.OccurredAt),
                        User = a.PerformedBy?.FullName ?? "Unknown",
                        Details = (string?)a.Details,
                        Dot = a.ActivityType switch
                        {
                            "validated" => a.Details.StartsWith("Submission approved") ? "approved" : "returned",
                            "proof-submitted" => "submitted",
                            "status-changed" => "status",
                            _ => "default"
                        },
                        Download = a.RelatedSubmission
                    })
                    .Append(new
                    {
                        When = DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(task.CreatedAt),
                        User = creatorLabel,
                        Details = (string?)"Created this task.",
                        Dot = "default",
                        Download = (DTIOneLink.Models.TaskSubmission?)null
                    })
                    .OrderByDescending(e => e.When)
                    .ToList();
            }
            <div class="td-activity">
                <h3 class="td-sidebar-subtitle">Activity History</h3>
                <div class="td-timeline-scroll" id="tdTimelineScroll">
                    <ul class="td-timeline" id="tdTimeline">
                        @foreach (var entry in activityEntries)
                        {
                            <li class="td-timeline-item">
                                <span class="td-timeline-dot @entry.Dot"></span>
                                <div class="td-timeline-content">
                                    <div class="td-timeline-header">
                                        <span class="td-activity-user">@entry.User</span>
                                        <span class="td-activity-date">@entry.When.ToString("MMM d, h:mm tt")</span>
                                    </div>
                                    <p class="td-activity-details">@entry.Details</p>
                                    @if (entry.Download != null)
                                    {
                                        var downloadExt = System.IO.Path.GetExtension(entry.Download.ProofFileName);
                                        if (previewableExtensions.Contains(downloadExt))
                                        {
                                            <a asp-controller="Employee" asp-action="PreviewProof" asp-route-submissionId="@entry.Download.Id" class="td-timeline-download" target="_blank" rel="noopener">
                                                Preview @entry.Download.ProofFileName
                                            </a>
                                        }
                                        <a asp-controller="Employee" asp-action="DownloadProof" asp-route-submissionId="@entry.Download.Id" class="td-timeline-download">
                                            @entry.Download.ProofFileName
                                        </a>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </aside>
        <!-- /Sidebar -->

    </div>
</div>
