@model DTIOneLink.Models.TaskItem
@{
    ViewData["Title"] = "Task Details";

    var role = Context.Session.GetString("UserRole");
    var isElevated = role == "Admin" || role == "Supervisor" || role == "SuperAdmin";

    Layout = role == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : isElevated
            ? "~/Views/Admin/AdminLayout.cshtml"
            : "~/Views/Employee/employeelayout.cshtml";

    var task = Model;
    var taskCode = $"TASK-{task.Id:D4}";

    var status = (task.Status ?? "pending").Trim().ToLowerInvariant();
    var isOverdue = status != "completed" && task.DueDate.Date < DateTime.UtcNow.Date;

   (string CssClass, string Label) StatusInfo()
{
    if (isOverdue) return ("overdue", "Overdue");
    return status switch
    {
        "in-progress" => ("in-progress", "In Progress"),
        "for-review" => ("for-review", "For Review"),
        "returned-for-correction" => ("returned", "Returned for Correction"),
        "completed" => ("completed", "Completed"),
        _ => ("todo", "To Do")
    };
}
    var (statusClass, statusLabel) = StatusInfo();

    string PriorityClass(string? priority) => (priority ?? "medium").Trim().ToLowerInvariant() switch
    {
        "high" => "high",
        "low" => "low",
        _ => "medium"
    };

    string PriorityLabel(string? priority)
    {
        var p = (priority ?? "medium").Trim().ToLowerInvariant();
        return char.ToUpperInvariant(p[0]) + p.Substring(1) + " Priority";
    }

        // Null for tasks created before CreatedByUserId existed — shown as
    // "Unknown" rather than guessed at.
    var creatorName = task.CreatedBy?.FullName;
    var creatorLabel = string.IsNullOrWhiteSpace(creatorName)
        ? "Unknown"
        : creatorName;

    // The signed-in user's own assignment on this task (null if they aren't
    // an assignee). The progress slider edits only this row, and only while
    // it is To Do / In Progress — the same rules EmployeeController.UpdateProgress
    // enforces on the server.
    var viewerId = Context.Session.GetInt32("UserId");
    var myAssignment = viewerId.HasValue
        ? task.Assignments?.FirstOrDefault(a => a.UserId == viewerId.Value)
        : null;
    var myAssignmentStatus = (myAssignment?.Status ?? "").Trim().ToLowerInvariant();
    var canEditProgress = myAssignment != null
        && (myAssignmentStatus == "pending" || myAssignmentStatus == "in-progress");
    var sliderProgress = canEditProgress ? myAssignment!.Progress : task.Progress;

    // Assignees may permanently delete a task once it is fully Completed.
    // EmployeeController.Delete re-checks all of this on the server.
    var canDeleteTask = myAssignment != null
        && status == "completed"
        && task.TaskLevel != DTIOneLink.Services.TaskLevels.Main;

    string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "NA";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
    }
}

@* This view renders ONLY the page content — the chosen layout above
   already provides <html>/<head>/<body>, the sidebar, and the top nav.

   Shared by two entry points:
     - EmployeeController.Details  (Employee Kanban board)
     - DashboardController.Details (Admin/Employee dashboard's Gantt + Kanban,
       and now the SuperAdmin office-wide task view)
   All three pass the same TaskItem. Layout, breadcrumb target, and which
   action buttons render are all resolved by session role above/below —
   no other content differs between the audiences.

   NOTE: The original mockup for this page also showed Reporter, Category,
   a Subtasks checklist, Attachments, a Comments thread, and an Activity
   Log. Comments and Activity History are now real (TaskComment /
   TaskActivity). Subtasks/Attachments/Category/Reporter are still not
   backed by any model. *@

@section Styles {
    <link rel="stylesheet" href="~/css/employeetaskdetails.css" asp-append-version="true" />
}

<div class="task-details">
    <nav class="td-breadcrumb" aria-label="Breadcrumb">
        @if (isElevated)
        {
            <a asp-controller="Tasks" asp-action="Index">Task Management</a>
        }
        else
        {
            <a asp-controller="Employee" asp-action="TaskManagement">Task Management</a>
        }
        <span>/</span>
        <span class="td-breadcrumb-current">@taskCode</span>
    </nav>

    @if (TempData["ErrorMessage"] is string detailsError)
    {
        <div class="td-alert error" role="alert">
            <span class="material-symbols-outlined">error</span>
            <span>@detailsError</span>
        </div>
    }

    <div class="td-grid">
        <!-- Left column: Task Details card + Comments card, stacked -->
        <div class="td-main-column">

            <!-- Task Details card -->
            <div class="td-panel">
                <section class="td-header">
                    <div class="td-eyebrow">
                        <button type="button" class="td-code-btn" id="copyTaskCode" data-code="@taskCode" title="Copy task code">
                            @taskCode
                        </button>
                    </div>
                    <h2 class="td-title">@task.TaskName</h2>
                    <div class="td-badges">
                        <span class="td-badge @statusClass" id="tdStatusBadge">
                            <span class="td-badge-dot"></span> <span id="tdStatusBadgeText">@statusLabel</span>
                        </span>
                        <span class="td-badge priority-@PriorityClass(task.Priority)">
                            <span class="td-badge-dot"></span> @PriorityLabel(task.Priority)
                        </span>
                        <span class="td-badge assignee">
                            <span class="td-badge-dot"></span> Assigned to @(task.Assignee?.FullName ?? "Unassigned")
                        </span>
                    </div>
                </section>

                <section class="td-meta-grid">
                    <div>
                        <h3>Created</h3>
                        <p>@task.CreatedAt.ToString("MMM d, yyyy")</p>
                    </div>
                    <div>
                        <h3>Created By</h3>
                        <p>@creatorLabel</p>
                    </div>
                    <div>
                        <h3>Due Date</h3>
                        <p>@task.DueDate.ToString("MMM d, yyyy")</p>
                    </div>
                    <div>
                        <h3>Progress</h3>
                        <p id="tdMetaProgress">@task.Progress%</p>
                    </div>
                    <div>
                        <h3>Status</h3>
                        <p id="tdMetaStatus">@statusLabel</p>
                    </div>
                </section>

                <section class="td-progress-section">
                    @if (canEditProgress)
                    {
                        @* Assignee's own progress: drag (or use arrow keys) and it
                           saves automatically when released. *@
                        <div class="td-progress-head">
                            <h3 id="tdProgressLabel">Progress</h3>
                            <span class="td-progress-value" id="tdProgressValue">@(sliderProgress)%</span>
                        </div>
                        <input type="range"
                               class="td-progress-range"
                               id="tdProgressRange"
                               min="0" max="100" step="1"
                               value="@sliderProgress"
                               style="--pct: @(sliderProgress)%"
                               data-task-id="@task.Id"
                               data-overdue="@(isOverdue ? "true" : "false")"
                               aria-labelledby="tdProgressLabel"
                               aria-valuetext="@(sliderProgress) percent" />
                        <p class="td-progress-hint" id="tdProgressHint" aria-live="polite">
                            Drag the slider to update your progress. It saves automatically.
                        </p>
                    }
                    else
                    {
                        <h3>Progress</h3>
                        <div class="td-progress-track">
                            <div class="td-progress-fill" style="width: @(task.Progress)%"></div>
                        </div>
                    }
                </section>

                <section class="td-description">
                    <h3>Description</h3>
                    @if (string.IsNullOrWhiteSpace(task.Description))
                    {
                        <p class="td-empty">No description provided.</p>
                    }
                    else
                    {
                        <p>@task.Description</p>
                    }
                </section>
                @{
                    var currentUserId = Context.Session.GetInt32("UserId");
                    var isAssignee = currentUserId.HasValue && currentUserId.Value == task.AssigneeId;
                }
                <div class="td-actions">
                    <button type="button" class="btn btn-secondary" id="tdBackButton">
                        <span class="material-symbols-outlined">arrow_back</span>
                        Back
                    </button>
                    @if (isAssignee)
                    {
                        @if (status == "pending" || status == "in-progress")
                        {
                            <a asp-controller="Employee" asp-action="SubmitProof" asp-route-id="@task.Id" class="btn btn-primary">
                                <span class="material-symbols-outlined">upload</span>
                                Submit Proof
                            </a>
                        }
                        @if (status == "returned-for-correction")
                        {
                            <a asp-controller="Employee" asp-action="SubmitProof" asp-route-id="@task.Id" class="btn btn-primary">
                                <span class="material-symbols-outlined">refresh</span>
                                Resubmit
                            </a>
                        }
                    }
                    @if (canDeleteTask)
                    {
                        <form asp-controller="Employee" asp-action="Delete" method="post" class="td-delete-form" id="tdDeleteForm"
                              data-task-name="@task.TaskName">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@task.Id" />
                            <button type="submit" class="btn btn-danger">
                                <span class="material-symbols-outlined">delete</span>
                                Delete Task
                            </button>
                        </form>
                    }
                </div>
            </div>
            <!-- /Task Details card -->

            <!-- Comments card -->
            <div class="td-panel td-comments-card">
    <section class="td-comments">
        <h3>Comments</h3>

        @{
            var comments = task.Comments?.OrderByDescending(c => c.CreatedAt).ToList() ?? new();
        }
        @if (comments.Any())
        {
            <ul class="td-comment-list">
                @foreach (var comment in comments)
                {
                    var commentTime = DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(comment.CreatedAt);
                    <li>
                        <div class="td-comment-header">
                            <span class="td-comment-author">@(comment.Author?.FullName ?? "Unknown")</span>
                            <span class="td-comment-date">@commentTime.ToString("MMM d, yyyy, h:mm tt")</span>
                        </div>
                        <p class="td-comment-text">@comment.Text</p>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="td-empty">No comments yet.</p>
        }

        <form asp-controller="Employee" asp-action="AddComment" method="post" class="td-comment-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="taskId" value="@task.Id" />
            <textarea name="text" class="td-comment-input" placeholder="Write a comment..." rows="3" required></textarea>
            <button type="submit" class="btn btn-primary td-comment-submit">
                <span class="material-symbols-outlined">send</span>
                Post
            </button>
        </form>
    </section>
</div>
            <!-- /Comments card -->

        </div>
        <!-- /Left column -->

        <!-- Sidebar -->
        <aside class="td-sidebar">
            <h3 class="td-sidebar-title">Task Overview</h3>

            <div class="td-overview-assignee">
                <div class="avatar-initials-lg">@GetInitials(task.Assignee?.FullName)</div>
                <div>
                    <div class="td-overview-name">@(task.Assignee?.FullName ?? "Unassigned")</div>
                    <div class="td-overview-role">Assignee</div>
                </div>
            </div>

            <dl class="td-overview-list">
                <div>
                    <dt>Status</dt>
                    <dd>@statusLabel</dd>
                </div>
                <div>
                    <dt>Priority</dt>
                    <dd>@PriorityLabel(task.Priority)</dd>
                </div>
                <div>
                    <dt>Due date</dt>
                    <dd>@task.DueDate.ToString("MMM d, yyyy")</dd>
                </div>
                <div>
                    <dt>Created</dt>
                    <dd>@task.CreatedAt.ToString("MMM d, yyyy")</dd>
                </div>
                 <div>
                    <dt>Created by</dt>
                    <dd>@creatorLabel</dd>
                </div>
            </dl>

                       @{
                var activities = task.Activities?.OrderByDescending(a => a.OccurredAt).ToList() ?? new();
            }
            <div class="td-activity">
                <h3 class="td-sidebar-subtitle">Activity History</h3>
                <ul class="td-timeline">
                    @* Synthetic first entry, rendered from TaskItem itself
                       rather than TaskActivity — task creation predates the
                       activity log, so there's no logged row for it. Always
                       shown, since a task always has a creation event. *@
                    <li class="td-timeline-item">
                        <span class="td-timeline-dot default"></span>
                        <div class="td-timeline-content">
                            <div class="td-timeline-header">
                                <span class="td-activity-user">@creatorLabel</span>
                                <span class="td-activity-date">
                                    @DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(task.CreatedAt).ToString("MMM d, yyyy, h:mm tt")
                                </span>
                            </div>
                            <p class="td-activity-details">Created this task.</p>
                        </div>
                    </li>
                    @foreach (var activity in activities)
                    {
                        var localTime = DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(activity.OccurredAt);
                        var dotClass = activity.ActivityType switch
                        {
                            "validated" => activity.Details.StartsWith("Submission approved") ? "approved" : "returned",
                            "proof-submitted" => "submitted",
                            "status-changed" => "status",
                            _ => "default"
                        };
                        <li class="td-timeline-item">
                            <span class="td-timeline-dot @dotClass"></span>
                            <div class="td-timeline-content">
                                <div class="td-timeline-header">
                                    <span class="td-activity-user">@(activity.PerformedBy?.FullName ?? "Unknown")</span>
                                    <span class="td-activity-date">@localTime.ToString("MMM d, yyyy, h:mm tt")</span>
                                </div>
                                <p class="td-activity-details">@activity.Details</p>
                                @if (activity.RelatedSubmission != null)
                                {
                                    <a asp-controller="Employee" asp-action="DownloadProof" asp-route-submissionId="@activity.RelatedSubmission.Id" class="td-timeline-download">
                                        @activity.RelatedSubmission.ProofFileName
                                    </a>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </aside>
        <!-- /Sidebar -->

    </div>
</div>

@section Scripts {
    <script src="~/js/employeetaskdetails.js" asp-append-version="true"></script>
}