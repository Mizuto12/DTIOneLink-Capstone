@model DTIOneLink.Models.TaskItem
@{
    ViewData["Title"] = "Submit Proof of Completion";
    Layout = "~/Views/Employee/employeelayout.cshtml";
    var task = Model;
    var taskCode = $"TASK-{task.Id:D4}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/employeetaskdetails.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tasks-create.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employeetaskproof.css" asp-append-version="true" />
}

<!-- ── The real Task Details page, behind the form ───── -->
@* inert: it can't be clicked or tabbed into while the dialog is open. *@
<div class="task-list-behind" inert aria-hidden="true">
    <partial name="~/Views/Employee/_TaskDetails.cshtml" model="task" />
</div>

<!-- ── Submit Proof Modal (native dialog, opened by employeesubmitproof.js) ── -->
<dialog class="modal-overlay" id="submitProofModal" aria-labelledby="tpModalTitle"
        data-close-url="@Url.Action("Details", "Employee", new { id = task.Id })">
    <div class="modal">

        <!-- Header -->
        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="tpModalTitle">Submit Proof — @taskCode</h2>
                <p class="modal-sub">@task.TaskName</p>
            </div>
            <a asp-controller="Employee" asp-action="Details" asp-route-id="@task.Id" class="modal-close" aria-label="Close">
                <span class="material-symbols-outlined">close</span>
            </a>
        </div>

        <!-- Body -->
        <div class="modal-body">
            <div class="task-proof">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="tp-alert error">
                        <ul>
                            @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@modelError.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-controller="Employee" asp-action="SubmitProof" method="post" enctype="multipart/form-data" id="tpForm" data-task-id="@task.Id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@task.Id" />

                    <section class="tp-field">
                        <label for="tpFile">Proof file</label>
                        <input type="file" id="tpFile" name="ProofFile"
                               accept=".pdf,.docx,.xlsx,.jpg,.jpeg,.png" />
                        <p class="tp-hint">PDF, DOCX, XLSX, JPG, or PNG. Max size 10 MB.</p>
                    </section>

                    <section class="tp-field">
                        <label for="tpRemarks">Remarks</label>
                        <textarea id="tpRemarks" name="Remarks" rows="4"
                                  placeholder="Describe what was completed..."></textarea>
                    </section>

                    <p class="tp-hint" id="tpStatusHint" aria-live="polite"></p>
                </form>
            </div>
        </div>

        <!-- Footer -->
        <div class="modal-footer">
            <a asp-controller="Employee" asp-action="Details" asp-route-id="@task.Id" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-create" id="tpSubmitBtn" form="tpForm">
                <span class="material-symbols-outlined">upload</span>
                Submit for Review
            </button>
        </div>

    </div>
</dialog>

@section Scripts {
    <script src="~/js/employeesubmitproof.js" asp-append-version="true"></script>
}
