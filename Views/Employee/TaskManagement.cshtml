@model IEnumerable<DTIOneLink.Models.TaskItem>
@{
    ViewData["Title"] = "Task Management";
    ViewData["LiveRefresh"] = true; // auto-refresh when data changes (live-refresh.js)
    Layout = "~/Views/Employee/EmployeeLayout.cshtml";

    var role = Context.Session.GetString("UserRole");
    var isElevated = role == "Admin" || role == "Supervisor";
    var currentUserId = Context.Session.GetInt32("UserId");
    var today = DTIOneLink.Services.TimeZoneHelper.PhilippineToday;

    var tasks = (Model ?? Enumerable.Empty<DTIOneLink.Models.TaskItem>()).ToList();

    // Elevated viewers (Admin/Supervisor) see the task's overall/aggregate
    // status here, since they aren't themselves doing the work. A regular
    // employee sees THEIR OWN assignment's status/progress — on a shared
    // task, one assignee finishing doesn't move another assignee's card,
    // and vice versa.
    string EffectiveStatus(DTIOneLink.Models.TaskItem t) => isElevated
        ? (t.Status ?? "pending")
        : (t.Assignments.FirstOrDefault(a => a.UserId == currentUserId)?.Status ?? t.Status ?? "pending");

    int EffectiveProgress(DTIOneLink.Models.TaskItem t) => isElevated
        ? t.Progress
        : (t.Assignments.FirstOrDefault(a => a.UserId == currentUserId)?.Progress ?? t.Progress);

    string AssigneeDisplay(DTIOneLink.Models.TaskItem t) => t.Assignments.Count > 1
        ? $"{t.Assignments.Count} assignees"
        : (t.Assignee?.FullName ?? "Unassigned");

    string PriorityClass(string? priority) => (priority ?? "medium").Trim().ToLowerInvariant() switch
    {
        "high" => "high",
        "low" => "low",
        _ => "medium"
    };

    string PriorityLabel(string? priority)
    {
        var p = (priority ?? "medium").Trim().ToLowerInvariant();
        var label = char.ToUpperInvariant(p[0]) + p.Substring(1);
        return $"{label} Priority";
    }

    string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "NA";
        }

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        }

        return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
    }

    // Same conditions EmployeeController.Delete enforces: the viewer holds
    // an assignment, the WHOLE task is Completed (not just their own part),
    // and it isn't an OPD main task. The server re-checks all of this.
    bool CanDelete(DTIOneLink.Models.TaskItem t) =>
        currentUserId.HasValue
        && t.Assignments.Any(a => a.UserId == currentUserId.Value)
        && string.Equals(t.Status, "completed", StringComparison.OrdinalIgnoreCase)
        && t.TaskLevel != DTIOneLink.Services.TaskLevels.Main;

    (string Label, string Css) StatusPill(string status) => status switch
    {
        "pending" => ("To Do", "todo"),
        "in-progress" => ("In Progress", "in-progress"),
        "for-review" => ("For Review", "for-review"),
        "returned-for-correction" => ("Returned", "returned"),
        "completed" => ("Completed", "completed"),
        _ => ("To Do", "todo")
    };

    string FormatDueDate(DateTime dueDate) => DTIOneLink.Helpers.DisplayHelpers.FormalMonthDay(dueDate);

    // ---- Group by what actually needs attention, not by workflow column ----
    // "Needs Your Action": every Returned task (always needs a resubmit),
    // plus — separately — the single most-overdue task whose progress the
    // viewer can still edit (pending/in-progress). That one task is then
    // left out of the Overdue group below so it isn't shown twice; a
    // Returned task is never duplicated below either, since resubmitting
    // is the only thing to do with it regardless of its due date.
    var returnedTasks = tasks.Where(t => EffectiveStatus(t) == "returned-for-correction")
        .OrderBy(t => t.DueDate)
        .ToList();

    var editableOverdue = tasks
        .Where(t => (EffectiveStatus(t) == "pending" || EffectiveStatus(t) == "in-progress") && t.DueDate.Date < today)
        .OrderBy(t => t.DueDate)
        .ToList();
    var spotlightOverdue = editableOverdue.FirstOrDefault();

    var completedTasks = tasks.Where(t => EffectiveStatus(t) == "completed").ToList();

    var groupableTasks = tasks
        .Where(t => EffectiveStatus(t) != "completed" && EffectiveStatus(t) != "returned-for-correction")
        .Where(t => spotlightOverdue == null || t.Id != spotlightOverdue.Id)
        .OrderBy(t => t.DueDate)
        .ToList();

    var overdueGroup = groupableTasks.Where(t => t.DueDate.Date < today).ToList();
    var thisWeekGroup = groupableTasks.Where(t => t.DueDate.Date >= today && t.DueDate.Date <= today.AddDays(7)).ToList();
    var laterGroup = groupableTasks.Where(t => t.DueDate.Date > today.AddDays(7)).ToList();

    var hasAnyAction = returnedTasks.Any() || spotlightOverdue != null;
    var hasAnything = hasAnyAction || overdueGroup.Any() || thisWeekGroup.Any() || laterGroup.Any() || completedTasks.Any();

    var deletableCompletedCount = completedTasks.Count(CanDelete);
    var keptCompletedCount = completedTasks.Count - deletableCompletedCount;
}

@* This view renders ONLY the page content — employeelayout.cshtml already
   provides <html>/<head>/<body>, the sidebar, and the top nav. *@

@section Styles {
    <link rel="stylesheet" href="~/css/employeetask.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notice-dialog.css" asp-append-version="true" />
}

<div class="task-management">
    @if (TempData["SuccessMessage"] is string tmSuccess)
    {
        <div class="tm-alert success" role="status">
            <span class="material-symbols-outlined">check_circle</span>
            <span>@tmSuccess</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is string tmError)
    {
        <div class="tm-alert error" role="alert">
            <span class="material-symbols-outlined">error</span>
            <span>@tmError</span>
        </div>
    }

    @if (!hasAnything)
    {
        <div class="tm-empty-page">
            <span class="material-symbols-outlined">task_alt</span>
            <p>No tasks yet.</p>
        </div>
    }
    else
    {
        @if (hasAnyAction)
        {
            <section class="action-strip" aria-label="Needs your action">
                <div class="action-strip__head">
                    <span class="material-symbols-outlined">warning</span>
                    <h3>Needs Your Action (@(returnedTasks.Count + (spotlightOverdue != null ? 1 : 0)))</h3>
                </div>
                <div class="action-strip__grid">
                    @foreach (var task in returnedTasks)
                    {
                        <div class="action-card">
                            <div class="action-card__tag">
                                <span class="material-symbols-outlined">edit</span>
                                <span>Returned for correction</span>
                            </div>
                            <div class="action-card__title">@task.TaskName</div>
                            <div class="action-card__foot">
                                <span class="action-card__meta">@(AssigneeDisplay(task)) · @PriorityLabel(task.Priority)</span>
                                <a class="action-btn" asp-controller="Employee" asp-action="SubmitProof" asp-route-id="@task.Id">
                                    <span class="material-symbols-outlined">upload</span>Resubmit
                                </a>
                            </div>
                        </div>
                    }
                    @if (spotlightOverdue != null)
                    {
                        var daysLate = (today - spotlightOverdue.DueDate.Date).Days;
                        <div class="action-card">
                            <div class="action-card__tag action-card__tag--overdue">
                                <span class="material-symbols-outlined">warning</span>
                                <span>Most overdue · @daysLate day@(daysLate == 1 ? "" : "s")</span>
                            </div>
                            <div class="action-card__title">@spotlightOverdue.TaskName</div>
                            <div class="action-card__foot">
                                <span class="action-card__meta">@(EffectiveProgress(spotlightOverdue))% done · @PriorityLabel(spotlightOverdue.Priority)</span>
                                <a class="action-btn" asp-controller="Employee" asp-action="Details" asp-route-id="@spotlightOverdue.Id">
                                    <span class="material-symbols-outlined">edit</span>Update Progress
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        @if (overdueGroup.Any())
        {
            <section class="due-panel due-panel--overdue">
                <div class="due-panel__head">
                    <span class="material-symbols-outlined">warning</span>
                    <h3>Overdue</h3>
                    <span class="due-panel__count due-panel__count--overdue">@overdueGroup.Count</span>
                </div>
                @foreach (var task in overdueGroup)
                {
                    var (label, css) = StatusPill(EffectiveStatus(task));
                    var daysLate = (today - task.DueDate.Date).Days;
                    <div class="due-row" data-href="@Url.Action("Details", "Employee", new { id = task.Id })" role="link" tabindex="0" aria-label="Open @task.TaskName">
                        <div class="avatar-initials">@GetInitials(task.Assignee?.FullName)</div>
                        <div class="due-row__main">
                            <div class="due-row__title">@task.TaskName</div>
                            <div class="due-row__meta">@(AssigneeDisplay(task)) · Due @FormatDueDate(task.DueDate) (@daysLate day@(daysLate == 1 ? "" : "s") ago)</div>
                        </div>
                        <span class="priority-badge @PriorityClass(task.Priority)">@PriorityLabel(task.Priority)</span>
                        <span class="status-pill @css">@label@(css == "in-progress" ? $" · {EffectiveProgress(task)}%" : "")</span>
                    </div>
                }
            </section>
        }

        @if (thisWeekGroup.Any())
        {
            <section class="due-panel">
                <div class="due-panel__head">
                    <span class="material-symbols-outlined">calendar_today</span>
                    <h3>Due This Week</h3>
                    <span class="due-panel__count">@thisWeekGroup.Count</span>
                </div>
                @foreach (var task in thisWeekGroup)
                {
                    var (label, css) = StatusPill(EffectiveStatus(task));
                    <div class="due-row" data-href="@Url.Action("Details", "Employee", new { id = task.Id })" role="link" tabindex="0" aria-label="Open @task.TaskName">
                        <div class="avatar-initials">@GetInitials(task.Assignee?.FullName)</div>
                        <div class="due-row__main">
                            <div class="due-row__title">@task.TaskName</div>
                            <div class="due-row__meta">@(AssigneeDisplay(task)) · Due @FormatDueDate(task.DueDate)</div>
                        </div>
                        <span class="priority-badge @PriorityClass(task.Priority)">@PriorityLabel(task.Priority)</span>
                        <span class="status-pill @css">@label@(css == "in-progress" ? $" · {EffectiveProgress(task)}%" : "")</span>
                    </div>
                }
            </section>
        }

        @if (laterGroup.Any())
        {
            <section class="due-panel">
                <div class="due-panel__head">
                    <span class="material-symbols-outlined">schedule</span>
                    <h3>Later</h3>
                    <span class="due-panel__count">@laterGroup.Count</span>
                </div>
                @foreach (var task in laterGroup)
                {
                    var (label, css) = StatusPill(EffectiveStatus(task));
                    <div class="due-row" data-href="@Url.Action("Details", "Employee", new { id = task.Id })" role="link" tabindex="0" aria-label="Open @task.TaskName">
                        <div class="avatar-initials">@GetInitials(task.Assignee?.FullName)</div>
                        <div class="due-row__main">
                            <div class="due-row__title">@task.TaskName</div>
                            <div class="due-row__meta">@(AssigneeDisplay(task)) · Due @FormatDueDate(task.DueDate)</div>
                        </div>
                        <span class="priority-badge @PriorityClass(task.Priority)">@PriorityLabel(task.Priority)</span>
                        <span class="status-pill @css">@label@(css == "in-progress" ? $" · {EffectiveProgress(task)}%" : "")</span>
                    </div>
                }
            </section>
        }

        @if (completedTasks.Any())
        {
            <section class="due-panel due-panel--completed">
                <div class="due-panel__head">
                    <span class="material-symbols-outlined" data-weight="fill">check_circle</span>
                    <h3>Completed</h3>
                    <span class="due-panel__count due-panel__count--completed">@completedTasks.Count</span>
                    <div class="column-menu">
                        <button type="button" class="column-menu-btn" id="completedMenuBtn"
                                aria-haspopup="true" aria-expanded="false" aria-controls="completedMenu"
                                title="More options" aria-label="Completed options">
                            <span class="material-symbols-outlined">more_horiz</span>
                        </button>
                        <div class="column-menu-panel" id="completedMenu" role="menu" hidden>
                            @if (deletableCompletedCount > 0)
                            {
                                <form asp-controller="Employee" asp-action="DeleteAllCompleted" method="post"
                                      class="delete-all-form" data-count="@deletableCompletedCount">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="column-menu-item danger" role="menuitem">
                                        <span class="material-symbols-outlined">delete_sweep</span>
                                        Delete all completed tasks (@deletableCompletedCount)
                                    </button>
                                </form>
                            }
                            else
                            {
                                <p class="column-menu-note">No completed tasks can be deleted right now.</p>
                            }
                            @if (keptCompletedCount > 0)
                            {
                                <p class="column-menu-note">
                                    @keptCompletedCount @(keptCompletedCount == 1 ? "task" : "tasks") will be kept —
                                    for example, shared tasks still waiting on other assignees.
                                </p>
                            }
                        </div>
                    </div>
                </div>
                @foreach (var task in completedTasks)
                {
                    <div class="due-row is-completed" data-href="@Url.Action("Details", "Employee", new { id = task.Id })" role="link" tabindex="0" aria-label="Open @task.TaskName">
                        <div class="avatar-initials">@GetInitials(task.Assignee?.FullName)</div>
                        <div class="due-row__main">
                            <div class="due-row__title">@task.TaskName</div>
                            <div class="due-row__meta">@(AssigneeDisplay(task)) · Was due @FormatDueDate(task.DueDate)</div>
                        </div>
                        <span class="priority-badge @PriorityClass(task.Priority)">@PriorityLabel(task.Priority)</span>
                        @if (CanDelete(task))
                        {
                            <form asp-controller="Employee" asp-action="Delete" method="post"
                                  class="task-delete-form" data-task-name="@task.TaskName">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@task.Id" />
                                <button type="submit" class="task-delete-btn"
                                        title="Delete task" aria-label="Delete @task.TaskName">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </form>
                        }
                    </div>
                }
            </section>
        }
    }
</div>

<partial name="_NoticeDialog" />

@section Scripts {
    <script src="~/js/notice-dialog.js" asp-append-version="true"></script>
    <script src="~/js/employeetask.js" asp-append-version="true"></script>
}
