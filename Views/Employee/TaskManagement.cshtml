@model IEnumerable<DTIOneLink.Models.TaskItem>
@{
    ViewData["Title"] = "Task Management";
    Layout = "~/Views/Employee/EmployeeLayout.cshtml";

    var role = Context.Session.GetString("UserRole");
    var isElevated = role == "Admin" || role == "Supervisor";
    var currentUserId = Context.Session.GetInt32("UserId");

    var tasks = Model ?? Enumerable.Empty<DTIOneLink.Models.TaskItem>();

    // Elevated viewers (Admin/Supervisor) see the task's overall/aggregate
    // status here, since they aren't themselves doing the work. A regular
    // employee sees THEIR OWN assignment's status/progress — on a shared
    // task, one assignee finishing doesn't move another assignee's card,
    // and vice versa.
    string EffectiveStatus(DTIOneLink.Models.TaskItem t) => isElevated
        ? (t.Status ?? "pending")
        : (t.Assignments.FirstOrDefault(a => a.UserId == currentUserId)?.Status ?? t.Status ?? "pending");

    int EffectiveProgress(DTIOneLink.Models.TaskItem t) => isElevated
        ? t.Progress
        : (t.Assignments.FirstOrDefault(a => a.UserId == currentUserId)?.Progress ?? t.Progress);

    string AssigneeDisplay(DTIOneLink.Models.TaskItem t) => t.Assignments.Count > 1
        ? $"{t.Assignments.Count} assignees"
        : (t.Assignee?.FullName ?? "Unassigned");

    var todoTasks = tasks.Where(t => EffectiveStatus(t) == "pending").ToList();
    var inProgressTasks = tasks.Where(t => EffectiveStatus(t) == "in-progress").ToList();
    var forReviewTasks = tasks.Where(t => EffectiveStatus(t) == "for-review").ToList();
    var rejectedTasks = tasks.Where(t => EffectiveStatus(t) == "returned-for-correction").ToList();
    var completedTasks = tasks.Where(t => EffectiveStatus(t) == "completed").ToList();

    string PriorityClass(string? priority) => (priority ?? "medium").Trim().ToLowerInvariant() switch
    {
        "high" => "high",
        "low" => "low",
        _ => "medium"
    };

    string PriorityLabel(string? priority)
    {
        var p = (priority ?? "medium").Trim().ToLowerInvariant();
        var label = char.ToUpperInvariant(p[0]) + p.Substring(1);
        return $"{label} Priority";
    }

    string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "NA";
        }

        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        }

        return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
    }

    string FormatDueDate(DateTime dueDate)
    {
        var today = DateTime.UtcNow.Date;
        if (dueDate.Date == today) return "Today";
        if (dueDate.Date == today.AddDays(1)) return "Tomorrow";
        return dueDate.ToString("MMM d");
    }
}

@* This view renders ONLY the page content — employeelayout.cshtml already
   provides <html>/<head>/<body>, the sidebar, and the top nav. *@

@section Styles {
    <link rel="stylesheet" href="~/css/employeetask.css" asp-append-version="true" />
}

<div class="task-management">
    <div class="workspace-header">
        <div class="header-actions">
            <button type="button" class="btn btn-secondary" data-action="filter">
                <span class="material-symbols-outlined">filter_list</span>
                Filter
            </button>
            @if (isElevated)
            {
                <button type="button" class="btn btn-primary" data-action="new-task"
                        data-url="@Url.Action("Create", "Tasks")">
                    <span class="material-symbols-outlined">add</span>
                    New Task
                </button>
            }
        </div>
    </div>

    <!-- Kanban Board -->
    <div class="kanban-board">

        <!-- Column: To Do -->
        <div class="kanban-column">
            <div class="column-header">
                <div class="column-header-left">
                    <span class="status-dot todo"></span>
                    <h3 class="column-title">To Do</h3>
                    <span class="column-count">@todoTasks.Count</span>
                </div>
                <button type="button" class="column-menu-btn">
                    <span class="material-symbols-outlined">more_horiz</span>
                </button>
            </div>

            @if (!todoTasks.Any())
            {
                <div class="column-empty">No tasks yet.</div>
            }
            else
            {
                @foreach (var task in todoTasks)
                {
                    <div class="task-card" data-href="@Url.Action("Details", "Employee", new { id = task.Id })"
                         role="link" tabindex="0" aria-label="Open @task.TaskName">
                        <div class="task-card-top">
                            <span class="priority-badge @PriorityClass(task.Priority)">@PriorityLabel(task.Priority)</span>
                            <button type="button" class="task-edit-btn" title="Edit task">
                                <span class="material-symbols-outlined">edit</span>
                            </button>
                        </div>
                        <h4 class="task-title">@task.TaskName</h4>
                        <div class="task-footer">
                            <div class="task-assignee">
                                <div class="avatar-initials">@GetInitials(task.Assignee?.FullName)</div>
                                <span class="assignee-name">@AssigneeDisplay(task)</span>
                            </div>
                            <div class="task-due">
                                <span class="material-symbols-outlined">calendar_today</span>
                                <span class="due-label">@FormatDueDate(task.DueDate)</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Column: In Progress -->
        <div class="kanban-column">
            <div class="column-header">
                <div class="column-header-left">
                    <span class="status-dot in-progress"></span>
                    <h3 class="column-title">In Progress</h3>
                    <span class="column-count">@inProgressTasks.Count</span>
                </div>
                <button type="button" class="column-menu-btn">
                    <span class="material-symbols-outlined">more_horiz</span>
                </button>
            </div>

            @if (!inProgressTasks.Any())
            {
                <div class="column-empty">No tasks yet.</div>
            }
            else
            {
                @foreach (var task in inProgressTasks)
                {
                    <div class="task-card in-progress" data-href="@Url.Action("Details", "Employee", new { id = task.Id })"
                         role="link" tabindex="0" aria-label="Open @task.TaskName">
                        <div class="task-card-top">
                            <span class="priority-badge @PriorityClass(task.Priority)">@PriorityLabel(task.Priority)</span>
                            <button type="button" class="task-edit-btn" title="Edit task">
                                <span class="material-symbols-outlined">edit</span>
                            </button>
                        </div>
                        <h4 class="task-title">@task.TaskName</h4>
                        <div class="task-progress-track">
                            <div class="task-progress-fill" style="width: @(EffectiveProgress(task))%"></div>
                        </div>
                        <div class="task-footer">
                            <div class="task-assignee">
                                <div class="avatar-initials">@GetInitials(task.Assignee?.FullName)</div>
                                <span class="assignee-name">@AssigneeDisplay(task)</span>
                            </div>
                            <div class="task-due">
                                <span class="material-symbols-outlined">calendar_today</span>
                                <span class="due-label">@FormatDueDate(task.DueDate)</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Column: For Review -->
        <div class="kanban-column">
            <div class="column-header">
                <div class="column-header-left">
                    <span class="status-dot for-review"></span>
                    <h3 class="column-title">For Review</h3>
                    <span class="column-count">@forReviewTasks.Count</span>
                </div>
                <button type="button" class="column-menu-btn">
                    <span class="material-symbols-outlined">more_horiz</span>
                </button>
            </div>

            @if (!forReviewTasks.Any())
            {
                <div class="column-empty">No tasks yet.</div>
            }
            else
            {
                @foreach (var task in forReviewTasks)
                {
                    <div class="task-card for-review" data-href="@Url.Action("Details", "Employee", new { id = task.Id })"
                         role="link" tabindex="0" aria-label="Open @task.TaskName">
                        <div class="task-card-top">
                            <span class="priority-badge @PriorityClass(task.Priority)">@PriorityLabel(task.Priority)</span>
                        </div>
                        <h4 class="task-title">@task.TaskName</h4>
                        <div class="task-footer">
                            <div class="task-assignee">
                                <div class="avatar-initials">@GetInitials(task.Assignee?.FullName)</div>
                                <span class="assignee-name">@AssigneeDisplay(task)</span>
                            </div>
                            <div class="task-due">
                                <span class="due-label">Awaiting review</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Column: Rejected -->
        <div class="kanban-column">
            <div class="column-header">
                <div class="column-header-left">
                    <span class="status-dot rejected"></span>
                    <h3 class="column-title">Rejected</h3>
                    <span class="column-count">@rejectedTasks.Count</span>
                </div>
                <button type="button" class="column-menu-btn">
                    <span class="material-symbols-outlined">more_horiz</span>
                </button>
            </div>

            @if (!rejectedTasks.Any())
            {
                <div class="column-empty">No tasks yet.</div>
            }
            else
            {
                @foreach (var task in rejectedTasks)
                {
                    <div class="task-card rejected" data-href="@Url.Action("Details", "Employee", new { id = task.Id })"
                         role="link" tabindex="0" aria-label="Open @task.TaskName">
                        <div class="task-card-top">
                            <span class="priority-badge @PriorityClass(task.Priority)">@PriorityLabel(task.Priority)</span>
                            <span class="material-symbols-outlined task-rejected-icon">refresh</span>
                        </div>
                        <h4 class="task-title">@task.TaskName</h4>
                        <div class="task-footer">
                            <div class="task-assignee">
                                <div class="avatar-initials">@GetInitials(task.Assignee?.FullName)</div>
                                <span class="assignee-name">@AssigneeDisplay(task)</span>
                            </div>
                            <div class="task-due">
                                <span class="due-label">Needs resubmission</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Column: Completed -->
        <div class="kanban-column">
            <div class="column-header">
                <div class="column-header-left">
                    <span class="status-dot completed"></span>
                    <h3 class="column-title">Completed</h3>
                    <span class="column-count">@completedTasks.Count</span>
                </div>
                <button type="button" class="column-menu-btn">
                    <span class="material-symbols-outlined">more_horiz</span>
                </button>
            </div>

            @if (!completedTasks.Any())
            {
                <div class="column-empty">No tasks yet.</div>
            }
            else
            {
                @foreach (var task in completedTasks)
                {
                    <div class="task-card completed" data-href="@Url.Action("Details", "Employee", new { id = task.Id })"
                         role="link" tabindex="0" aria-label="Open @task.TaskName">
                        <div class="task-card-top">
                            <span class="priority-badge @PriorityClass(task.Priority)">@PriorityLabel(task.Priority)</span>
                            <span class="material-symbols-outlined task-complete-icon" data-weight="fill">check_circle</span>
                        </div>
                        <h4 class="task-title">@task.TaskName</h4>
                        <div class="task-footer">
                            <div class="task-assignee">
                                <div class="avatar-initials">@GetInitials(task.Assignee?.FullName)</div>
                                <span class="assignee-name">@AssigneeDisplay(task)</span>
                            </div>
                            <div class="task-due">
                                <span class="due-label">Due @FormatDueDate(task.DueDate)</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/employeetask.js" asp-append-version="true"></script>
}
