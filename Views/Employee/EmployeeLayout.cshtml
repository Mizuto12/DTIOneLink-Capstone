@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsActive(string c) =>
        string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase);
    bool IsActiveAction(string c, string a) =>
        string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    @await Html.PartialAsync("_AppHeadAssets")
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-live-refresh="@(ViewData["LiveRefresh"] is true ? "" : null)">

    @await Html.PartialAsync("_AppTopbar")

    <!-- ══════════════ SIDEBAR ══════════════ -->
    <aside class="sidebar" id="sidebar">

        @await Html.PartialAsync("_SidebarBrand")

        <nav class="sidebar-nav">

            <a asp-controller="Employee" asp-action="Index"
               class="nav-item @(IsActiveAction("Employee", "Index") ? "active" : "")">
                <span class="material-symbols-outlined">dashboard</span>
                <span>Dashboard</span>
            </a>

            <a asp-controller="Employee" asp-action="TaskManagement"
               class="nav-item @(IsActive("Employee") && !IsActiveAction("Employee", "Index") ? "active" : "")">
                <span class="material-symbols-outlined">assignment</span>
                <span>Task Management</span>
            </a>

            <a asp-controller="Records" asp-action="Index"
               class="nav-item @(IsActive("Records") ? "active" : "")">
                <span class="material-symbols-outlined">folder_open</span>
                <span>Records Management</span>
            </a>

            <a asp-controller="Reports" asp-action="Index"
               class="nav-item @(IsActive("Reports") ? "active" : "")">
                <span class="material-symbols-outlined">assessment</span>
                <span>Reports</span>
            </a>

            <a asp-controller="TimeLogs" asp-action="Index"
               class="nav-item @(IsActive("TimeLogs") ? "active" : "")">
                <span class="material-symbols-outlined">schedule</span>
                <span>Time Logs</span>
            </a>

        </nav>
    </aside>

    <div class="sidebar-scrim" id="sidebarScrim" hidden></div>

    <!-- ══════════════ MAIN CONTENT ══════════════ -->
    <main class="main-content">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_AppScripts")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
