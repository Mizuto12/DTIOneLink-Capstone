@model IEnumerable<DTIOneLink.Models.ErrorLog>
@{
    Layout = "~/Views/SuperAdmin/SuperAdminLayout.cshtml";
    ViewData["Title"] = "Error Logs";
}

@* Diagnostic-only page: self-contained styling, not part of the main
   design system — this exists so an unhandled exception can be read
   without server/host log access (shared hosting, no IT staff). *@
<style>
    .error-log-page { padding: 24px 0; font-family: 'Inter', system-ui, sans-serif; }
    .error-log-page h2 { margin: 0 0 4px; }
    .error-log-page .error-log-sub { color: #6b7280; margin: 0 0 24px; font-size: 14px; }
    .error-log-page .error-log-empty { padding: 40px; text-align: center; color: #6b7280; }
    .error-log-entry {
        border: 1px solid #e2e6f0;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 12px;
        background: #fff;
    }
    .error-log-entry summary {
        cursor: pointer;
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        align-items: baseline;
        font-size: 14px;
    }
    .error-log-entry .el-time { color: #6b7280; font-size: 13px; }
    .error-log-entry .el-type { font-weight: 700; color: #ba1a1a; }
    .error-log-entry .el-path { font-family: monospace; font-size: 13px; }
    .error-log-entry .el-message { margin: 10px 0 0; font-size: 14px; }
    .error-log-entry .el-meta { margin: 6px 0 0; font-size: 12px; color: #6b7280; }
    .error-log-entry pre {
        margin: 10px 0 0;
        padding: 12px;
        background: #0b1c30;
        color: #e5eeff;
        border-radius: 8px;
        font-size: 12px;
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-word;
    }
</style>

<div class="error-log-page">
    <h2>Error Logs</h2>
    <p class="error-log-sub">The most recent 100 unhandled exceptions, newest first.</p>

    @if (!Model.Any())
    {
        <div class="error-log-empty">No errors logged. 🎉</div>
    }
    else
    {
        @foreach (var log in Model)
        {
            <details class="error-log-entry">
                <summary>
                    <span class="el-time">@log.OccurredAtUtc.ToString("MMM d, yyyy, h:mm:ss tt") UTC</span>
                    <span class="el-type">@log.ExceptionType</span>
                    <span class="el-path">@log.Method @log.Path</span>
                </summary>
                <p class="el-message">@log.Message</p>
                <p class="el-meta">
                    User: @(log.UserId?.ToString() ?? "anonymous") (@(log.UserRole ?? "—"))
                </p>
                @if (!string.IsNullOrWhiteSpace(log.StackTrace))
                {
                    <pre>@log.StackTrace</pre>
                }
            </details>
        }
    }
</div>
