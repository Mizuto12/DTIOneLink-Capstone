@model DTIOneLink.Models.ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<h1 class="login-title change-password-title"><span class="navy">Forgot</span> <span class="accent">Password</span></h1>

@if (TempData["ForgotPasswordNotice"] is string notice)
{
    <p class="change-password-note" role="status">@notice</p>
}

<form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate class="change-password-form account-form">
    @Html.AntiForgeryToken()

    <p class="change-password-note">Enter the email you use to log in. We'll send you a link to reset your password.</p>

    <div class="field-group">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" class="text-input" autocomplete="username" placeholder="Enter your Email" autofocus />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <button type="submit" class="btn-login">SEND LINK</button>
</form>

<p class="field-hint account-help">No email yet? If you have never confirmed your email in DTI OneLink, ask your administrator to reset your password instead.</p>
<a asp-controller="Account" asp-action="Login" class="change-password-secondary">Back to login</a>
