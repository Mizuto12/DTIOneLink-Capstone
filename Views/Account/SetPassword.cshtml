@model DTIOneLink.Models.SetPasswordViewModel
@{
    // Shared by first sign-in (default/temporary password) and Forgot Password.
    // No current-password field: the emailed code already proved who this is.
    var isReset = ViewData["IsReset"] is true;
    Layout = "_AuthLayout";
    ViewData["Title"] = isReset ? "New Password" : "Set Your Password";
}

<h1 class="login-title change-password-title">
    @if (isReset)
    {
        <span class="navy">New</span> <span class="accent">Password</span>
    }
    else
    {
        <span class="navy">Set</span> <span class="accent">Password</span>
    }
</h1>

<form asp-controller="Account" asp-action="@(isReset ? "ResetPassword" : "SetPassword")" method="post" novalidate class="change-password-form account-form">
    @Html.AntiForgeryToken()

    <p class="change-password-note">
        Account: <strong>@ViewData["AccountName"]</strong><br />@ViewData["AccountEmail"]
        @if (!isReset)
        {
            <br /><span>You signed in with a default or temporary password. Choose your own to continue.</span>
        }
    </p>

    <div class="field-group">
        <label asp-for="NewPassword">New Password</label>
        <div class="input-wrapper">
            <input asp-for="NewPassword" class="text-input has-icon-right" autocomplete="new-password" />
            <partial name="_EyeToggle" />
        </div>
        <span class="field-hint">At least @DTIOneLink.Security.AccountDefaults.MinPasswordLength characters. A short phrase is easy to remember.</span>
        <span asp-validation-for="NewPassword" class="field-error"></span>
    </div>

    <div class="field-group">
        <label asp-for="ConfirmPassword">Confirm New Password</label>
        <div class="input-wrapper">
            <input asp-for="ConfirmPassword" class="text-input has-icon-right" autocomplete="new-password" />
            <partial name="_EyeToggle" />
        </div>
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <button type="submit" class="btn-login">SAVE</button>
</form>

@if (isReset)
{
    <a asp-controller="Account" asp-action="Login" class="change-password-secondary">Back to login</a>
}
else
{
    <form asp-controller="Account" asp-action="Logout" method="post" class="change-password-secondary-form">
        @Html.AntiForgeryToken()
        <button type="submit" class="change-password-secondary">Log out instead</button>
    </form>
}
