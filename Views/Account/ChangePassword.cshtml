@model DTIOneLink.Models.ChangePasswordViewModel
@{
    // Change Password from the profile menu (signed in).
    Layout = "_AuthLayout";
    ViewData["Title"] = "Change Password";
    var homeUrl = ViewData["HomeUrl"] as string ?? "/";
    var succeeded = ViewData["Succeeded"] is true;
}

<h1 class="login-title change-password-title"><span class="navy">Change</span> <span class="accent">Password</span></h1>

@if (succeeded)
{
    <div class="change-password-success" role="status">
        <p class="change-password-note">Your password has been changed. You were signed out on any other device. Use your new password the next time you log in.</p>
        <a href="@homeUrl" class="btn-login">CONTINUE</a>
    </div>
}
else
{
    <form asp-controller="Account" asp-action="ChangePassword" method="post" novalidate class="change-password-form account-form">
        @Html.AntiForgeryToken()

        <p class="change-password-note">
            Account: <strong>@Context.Session.GetString("FullName")</strong><br />@Context.Session.GetString("UserEmail")
        </p>

        <div class="field-group">
            <label asp-for="CurrentPassword">Current Password</label>
            <div class="input-wrapper">
                <input asp-for="CurrentPassword" class="text-input has-icon-right" autocomplete="current-password" />
                <partial name="_EyeToggle" />
            </div>
            <span asp-validation-for="CurrentPassword" class="field-error"></span>
        </div>

        <div class="field-group">
            <label asp-for="NewPassword">New Password</label>
            <div class="input-wrapper">
                <input asp-for="NewPassword" class="text-input has-icon-right" autocomplete="new-password" />
                <partial name="_EyeToggle" />
            </div>
            <span class="field-hint">At least @DTIOneLink.Security.AccountDefaults.MinPasswordLength characters. A short phrase is easy to remember.</span>
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>

        <div class="field-group">
            <label asp-for="ConfirmPassword">Confirm New Password</label>
            <div class="input-wrapper">
                <input asp-for="ConfirmPassword" class="text-input has-icon-right" autocomplete="new-password" />
                <partial name="_EyeToggle" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn-login">SAVE</button>
    </form>

    <a href="@homeUrl" class="change-password-secondary">Cancel</a>
}
