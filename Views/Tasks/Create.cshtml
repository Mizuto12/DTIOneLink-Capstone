@model DTIOneLink.Models.TaskCreateViewModel
@{
    Layout = Context.Session.GetString("UserRole") == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : "~/Views/Admin/AdminLayout.cshtml";
    ViewData["Title"] = "Create Task";
}
@section Styles {
    <link rel="stylesheet" href="~/css/tasks-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tasks-create.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/help-hint.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chip-recipient-input.css" asp-append-version="true" />
}

<!-- ── The real Task Management list, behind the form ───── -->
@* inert: it can't be clicked or tabbed into while the form is open. *@
@if (ViewBag.TaskList is DTIOneLink.Models.TaskIndexViewModel taskList)
{
    <div class="task-list-behind" inert aria-hidden="true">
        <partial name="_TaskList" model="taskList" />
    </div>
}

<!-- ── Create Task Modal (native dialog, opened by tasks-create.js) ──
     Laid out like composing an email: To (who it's sent to) / Subject
     (task name) / a toolbar for the metadata that doesn't have an email
     equivalent (priority, due date, repeat, review) / Body (description) /
     Subtasks kept visually secondary beneath the body, same as an
     attachments strip would be, since breaking the directive down isn't
     the primary thing being composed. -->
<dialog class="modal-overlay" id="createTaskModal" aria-labelledby="modalTitle"
        data-close-url="@Url.Action("Index", "Tasks")">
    <div class="modal">

        <!-- Header -->
        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="modalTitle">Create New Task</h2>
                <p class="modal-sub">Assign a new operational task to one or more team members.</p>
            </div>
            <a asp-controller="Tasks" asp-action="Index" class="modal-close" aria-label="Close">
                <span class="material-symbols-outlined">close</span>
            </a>
        </div>

        <!-- Body -->
        <div class="modal-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary">
                    <span class="material-symbols-outlined">error</span>
                    <div asp-validation-summary="All" class="validation-errors"></div>
                </div>
            }
            <form id="taskForm" asp-controller="Tasks" asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                @if (ViewBag.CanCreateMainTask == true)
                {
                    <!-- "To" — Task Type (how it's sent) and who it goes to,
                         merged into one compose-to-row: Task Type stays
                         visible always (it's the mode switch), the "Send To"
                         picker underneath hides for Whole Office, which has
                         no single recipient. Target Department is no longer
                         its own choice — picking who to send to already
                         determines the department (ValidateResponsibleAdminAsync
                         still checks this server-side either way), so there's
                         one decision here instead of two. -->
                    <div class="compose-to-row" id="composeToRow">
                        <span class="compose-to-row__label">To</span>
                        <div class="compose-to-row__fields">
                            <div class="field-group">
                                <span class="field-label">
                                    TASK TYPE <span class="required-star">*</span>
                                    <button type="button" class="help-hint" aria-label="What's the difference between task types?" aria-expanded="false"
                                            data-help-text="Direct Admin Task: one Admin does the work themselves. Department Directive: sent to a division, whose Admin then assigns it to employees. Whole Office: every active staff member gets and submits their own copy.">?</button>
                                </span>
                                <div class="priority-row" id="taskTypeRow">
                                    <label class="priority-option">
                                        <input type="radio" asp-for="TaskType" value="direct-admin" />
                                        <div class="priority-pill">
                                            <span class="material-symbols-outlined">badge</span>
                                            <span>Direct Admin</span>
                                        </div>
                                    </label>
                                    <label class="priority-option">
                                        <input type="radio" asp-for="TaskType" value="department-directive" />
                                        <div class="priority-pill">
                                            <span class="material-symbols-outlined">folder</span>
                                            <span>Department</span>
                                        </div>
                                    </label>
                                    <label class="priority-option">
                                        <input type="radio" asp-for="TaskType" value="whole-office" />
                                        <div class="priority-pill">
                                            <span class="material-symbols-outlined">groups</span>
                                            <span>Whole Office</span>
                                        </div>
                                    </label>
                                </div>
                                <span asp-validation-for="TaskType" class="field-error"></span>
                                <p class="modal-sub" style="margin-top:4px;">
                                    Only a Department Directive breaks into subtasks — a Direct Admin Task or Whole Office task is worked and submitted directly by its assignee(s), so there's nothing to break down.
                                </p>
                            </div>

                            <!-- Send To — Department Directive: one Admin (every
                                 active Admin, each already labeled with their own
                                 department). OwningDepartment (hidden) is filled in
                                 from whichever Admin is picked. -->
                            <div class="field-group" id="sendToGroup">
                                <label class="field-label" for="responsibleAdmin">SEND TO <span class="required-star">*</span></label>
                                <div class="select-wrap">
                                    <select class="pill-input" id="responsibleAdmin" asp-for="ResponsibleAdminUserId">
                                        <option value="">Select who this goes to</option>
                                        @foreach (var admin in (IEnumerable<DTIOneLink.Models.User>)ViewBag.ResponsibleAdmins)
                                        {
                                            <option value="@admin.Id" data-department="@admin.Department">@admin.FullName (@admin.Department)</option>
                                        }
                                    </select>
                                    <span class="material-symbols-outlined select-icon">expand_more</span>
                                </div>
                                <span asp-validation-for="ResponsibleAdminUserId" class="field-error"></span>
                                <input type="hidden" id="targetDepartment" asp-for="OwningDepartment" />
                            </div>

                            <!-- Send To — Direct Admin Task: one or more Admins,
                                 any department (picking across departments is the
                                 point). Each gets their own copy to work themselves,
                                 same as a multi-assignee employee task. A Gmail/
                                 Outlook-style "To" field: type a name or email,
                                 pick from the suggestions, selections become
                                 removable chips (chip-recipient-input.js). The
                                 hidden <input name="DirectAdminUserIds"> each chip
                                 carries is the only thing the server ever sees —
                                 same List<int> model binding as a native
                                 <select multiple> would have posted. -->
                            <div class="field-group" id="directAdminGroup" style="display:none">
                                <label class="field-label" for="directAdminChipText">SEND TO <span class="required-star">*</span></label>
                                <div class="chip-input" data-chip-input data-chip-name="DirectAdminUserIds"
                                     data-chip-options="directAdminOptionsData"
                                     data-chip-selected="@string.Join(",", Model.DirectAdminUserIds)">
                                    <div class="chip-input-chips" data-chip-chips></div>
                                    <input type="text" id="directAdminChipText" class="chip-input-text" data-chip-text
                                           placeholder="Type a name or email…" autocomplete="off"
                                           role="combobox" aria-expanded="false" aria-autocomplete="list" aria-haspopup="listbox" />
                                    <div class="chip-input-suggestions" data-chip-suggestions role="listbox" hidden></div>
                                </div>
                                <span asp-validation-for="DirectAdminUserIds" class="field-error"></span>
                                <script type="application/json" id="directAdminOptionsData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                    ((IEnumerable<DTIOneLink.Models.User>)ViewBag.ResponsibleAdmins)
                                        .Select(a => new { id = a.Id, name = a.FullName, email = a.Email, department = a.Department })))</script>
                            </div>

                            <p class="modal-sub" id="wholeOfficeNote" hidden>
                                Every active Division Chief and employee (@ViewBag.WholeOfficeCount people) gets this task and submits their own. You review each submission.
                            </p>
                        </div>
                    </div>
                }

                <!-- "Subject" — the task name. -->
                <div class="compose-subject">
                    <label class="compose-subject__label" for="taskName">Subject</label>
                    <div style="flex:1; min-width:0;">
                        <input class="compose-subject__input" id="taskName" asp-for="TaskName" type="text" data-capitalize="title"
                               autocomplete="off" placeholder="e.g. MSME Development Seminar Coordination" />
                        <span asp-validation-for="TaskName" class="field-error"></span>
                    </div>
                </div>

                <!-- Toolbar — the metadata an email has no equivalent for. -->
                <div class="compose-toolbar">
                    <div class="compose-toolbar__item">
                        <label class="field-label" for="dueDate">DUE DATE <span class="required-star">*</span></label>
                        <div class="select-wrap compose-toolbar__due">
                            <input class="pill-input" id="dueDate" asp-for="DueDate" type="datetime-local" />
                            <span class="material-symbols-outlined select-icon">calendar_today</span>
                        </div>
                        <span asp-validation-for="DueDate" class="field-error"></span>
                    </div>
                    <div class="compose-toolbar__item">
                        <label class="field-label" for="recurrence">REPEAT</label>
                        <div class="select-wrap compose-toolbar__repeat">
                            <select class="pill-input" id="recurrence" asp-for="Recurrence">
                                <option value="">Does Not Repeat</option>
                                <option value="daily">Every Day</option>
                                <option value="weekly">Every Week</option>
                                <option value="monthly">Every Month</option>
                                <option value="quarterly">Every Quarter</option>
                            </select>
                            <span class="material-symbols-outlined select-icon">expand_more</span>
                        </div>
                        <span asp-validation-for="Recurrence" class="field-error"></span>
                    </div>
                    <div class="compose-toolbar__item compose-toolbar__item--grow">
                        <span class="field-label">PRIORITY LEVEL <span class="required-star">*</span></span>
                        <div class="priority-row">
                            <label class="priority-option">
                                <input type="radio" asp-for="Priority" value="low" />
                                <div class="priority-pill">
                                    <span class="priority-dot dot-low"></span>
                                    <span>Low</span>
                                </div>
                            </label>
                            <label class="priority-option">
                                <input type="radio" asp-for="Priority" value="medium" checked />
                                <div class="priority-pill">
                                    <span class="priority-dot dot-medium"></span>
                                    <span>Medium</span>
                                </div>
                            </label>
                            <label class="priority-option">
                                <input type="radio" asp-for="Priority" value="high" />
                                <div class="priority-pill">
                                    <span class="priority-dot dot-high"></span>
                                    <span>High</span>
                                </div>
                            </label>
                        </div>
                        <span asp-validation-for="Priority" class="field-error"></span>
                    </div>
                    <div class="compose-toolbar__item">
                        <span class="field-label">&nbsp;</span>
                        <label class="compose-toolbar__review">
                            <input type="checkbox" asp-for="RequiresReview" />
                            Requires review before completion
                        </label>
                    </div>
                </div>
                <p class="modal-sub">
                    Unchecked: submitting proof completes the task directly — no Admin decision needed.
                    Can't be changed after the task is created.
                </p>

                <!-- "Body" — the task description. -->
                <div class="field-group">
                    <label class="field-label" for="description">TASK DESCRIPTION <span class="required-star">*</span></label>
                    <textarea class="compose-body__input" id="description" asp-for="Description" rows="5" data-capitalize="sentence"
                              placeholder="Describe the task scope, objectives, and any specific requirements..."></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>

                @if (ViewBag.CanCreateMainTask == true)
                {
                    <!-- Subtasks — optional, plain-text breakdown. Only applies to a
                         Department Directive; hidden via JS for Direct Admin Task and
                         ignored server-side if submitted anyway (see TasksController).
                         Kept visually secondary to the Subject/Body above it. -->
                    <div class="compose-subtasks" id="subtasksFieldGroup">
                        <p class="compose-subtasks__label">SUBTASKS (OPTIONAL)</p>
                        <div id="subtaskList" class="subtask-list"></div>
                        <button type="button" id="addSubtaskBtn" class="subtask-add-btn">
                            <span class="material-symbols-outlined">edit_note</span>
                            Add subtask
                        </button>
                        <p class="modal-sub" style="margin-top:8px;">Optional — break this down now, or add subtasks later.</p>
                    </div>
                }
            </form>
        </div>

        <!-- Footer -->
        <div class="modal-footer">
            <a asp-controller="Tasks" asp-action="Index" class="btn-cancel">Cancel</a>
            <button class="btn-create" id="createBtn" type="submit" form="taskForm">
                <span class="material-symbols-outlined"
                      style="font-variation-settings:'FILL' 1; font-size:20px;">edit_note</span>
                Create Task
            </button>
        </div>

    </div>
</dialog>

@section Scripts {
    <script src="~/js/help-hint.js" asp-append-version="true"></script>
    <script src="~/js/subtask-list.js" asp-append-version="true"></script>
    <script src="~/js/chip-recipient-input.js" asp-append-version="true"></script>
    <script src="~/js/tasks-create.js" asp-append-version="true"></script>
    <script>
        (function () {
            var typeRadios = document.querySelectorAll('input[name="TaskType"]');
            var subtasksGroup = document.getElementById('subtasksFieldGroup');
            if (!typeRadios.length || !subtasksGroup) return;

            function selectedType() {
                var checked = document.querySelector('input[name="TaskType"]:checked');
                return checked ? checked.value : '';
            }

            // Direct Admin: no subtasks, and "Send To" is the multi-select
            // Admin list instead of the single-admin dropdown. Whole Office:
            // no "Send To" picker of either kind or subtasks (it goes to
            // everyone) — the note explains that instead.
            function syncVisibility() {
                var type = selectedType();
                var wholeOffice = type === 'whole-office';
                var direct = type === 'direct-admin';
                subtasksGroup.style.display = direct || wholeOffice ? 'none' : '';
                var sendToGroup = document.getElementById('sendToGroup');
                if (sendToGroup) sendToGroup.style.display = (wholeOffice || direct) ? 'none' : '';
                var directAdminGroup = document.getElementById('directAdminGroup');
                if (directAdminGroup) directAdminGroup.style.display = direct ? '' : 'none';
                var note = document.getElementById('wholeOfficeNote');
                if (note) note.hidden = !wholeOffice;
            }

            typeRadios.forEach(function (radio) {
                radio.addEventListener('change', syncVisibility);
            });
            syncVisibility();

            // OwningDepartment is inferred from whichever Admin is picked —
            // there's no separate department choice anymore (each option
            // already carries its own department as data-department). Only
            // relevant for the single-admin "Send To" (Department Directive);
            // a Direct Admin Task's OwningDepartment is derived server-side
            // from whichever Admin was picked first, since this field isn't
            // shown for that type at all.
            var adminSelect = document.getElementById('responsibleAdmin');
            var departmentField = document.getElementById('targetDepartment');
            if (adminSelect && departmentField) {
                adminSelect.addEventListener('change', function () {
                    var chosen = adminSelect.options[adminSelect.selectedIndex];
                    departmentField.value = chosen ? (chosen.getAttribute('data-department') || '') : '';
                });
            }
        })();
    </script>
}
