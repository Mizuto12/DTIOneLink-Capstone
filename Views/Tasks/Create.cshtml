@model DTIOneLink.Models.TaskCreateViewModel
@{
    Layout = Context.Session.GetString("UserRole") == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : "~/Views/Admin/AdminLayout.cshtml";
    ViewData["Title"] = "Create Task";
}
@section Styles {
    <link rel="stylesheet" href="~/css/tasks-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tasks-create.css" asp-append-version="true" />
}

<!-- ── Validation Summary ────────────────────────────── -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="validation-summary">
        <span class="material-symbols-outlined">error</span>
        <div asp-validation-summary="All" class="validation-errors"></div>
    </div>
}

<!-- ── Dimmed background (Task Management list) ───────── -->
<div class="task-bg">

    <!-- Page header (dimmed) -->
    <div class="page-header">
        <div class="page-header-text">
            <h2 class="page-title">Task Management</h2>
            <p class="page-sub">Assign, track, and manage departmental workflows.</p>
        </div>
        <div class="page-actions">
            <a class="btn-primary-pill">
                <span class="material-symbols-outlined">add</span>
                CREATE TASK
            </a>
            <button class="btn-outline-pill">
                <span class="material-symbols-outlined">filter_list</span>
                FILTER
            </button>
        </div>
    </div>

    <!-- Empty table card (dimmed) -->
    <div class="glass-card">
        <div class="card-toolbar">
            <div class="search-wrap">
                <span class="material-symbols-outlined search-icon">search</span>
                <input type="text" class="search-input"
                       placeholder="Search tasks, assignees, or employee names..." />
            </div>
            <div class="toolbar-filters">
                <div class="filter-chip">
                    <span>Status: All</span>
                    <span class="material-symbols-outlined chip-icon">expand_more</span>
                </div>
                <div class="filter-chip">
                    <span>Sort: Newest</span>
                    <span class="material-symbols-outlined chip-icon">sort</span>
                </div>
            </div>
        </div>
        <div class="table-scroll">
            <table class="task-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Task Assignee</th>
                        <th>Due Date</th>
                        <th>Task Progress</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="7" class="empty-state">
                            <div class="empty-state-content">
                                <span class="material-symbols-outlined empty-icon">assignment</span>
                                <p class="empty-text">No tasks yet</p>
                                <p class="empty-sub">Create a task to get started.</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="pagination-bar">
            <span class="pagination-info">No tasks to display</span>
            <div class="pagination-btns">
                <button class="page-btn page-nav">
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>
                <button class="page-btn page-active">1</button>
                <button class="page-btn page-nav">
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </div>
        </div>
    </div>

</div>

<!-- ── Create Task Modal ───────────────────────────────── -->
<div class="modal-overlay" id="createTaskModal">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">

        <!-- Header -->
        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="modalTitle">Create New Task</h2>
                <p class="modal-sub">Assign a new operational task to one or more team members.</p>
            </div>
            <a asp-controller="Tasks" asp-action="Index" class="modal-close" aria-label="Close">
                <span class="material-symbols-outlined">close</span>
            </a>
        </div>

        <!-- Body -->
        <div class="modal-body">
            <form id="taskForm" asp-controller="Tasks" asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <!-- Task Name -->
                <div class="field-group">
                    <label class="field-label" for="taskName">TASK NAME <span class="required-star">*</span></label>
                    <input class="pill-input" id="taskName" asp-for="TaskName" type="text"
                           placeholder="e.g. MSME Development Seminar Coordination" />
                    <span asp-validation-for="TaskName" class="field-error"></span>
                </div>

                <!-- Description -->
                <div class="field-group">
                    <label class="field-label" for="description">TASK DESCRIPTION <span class="required-star">*</span></label>
                    <textarea class="pill-input" id="description" asp-for="Description" rows="4"
                              placeholder="Describe the task scope, objectives, and any specific requirements..."></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>

                               @if (ViewBag.CanCreateMainTask == true)
                {
                    <!-- Task Type -->
                    <div class="field-group">
                        <label class="field-label" for="taskType">TASK TYPE <span class="required-star">*</span></label>
                        <div class="select-wrap">
                            <select class="pill-input" id="taskType" asp-for="TaskType">
                                <option value="">Select task type</option>
                                <option value="direct-admin">Direct Admin Task — assigned straight to one Admin</option>
                                <option value="department-directive">Department Directive — sent to the department</option>
                                <option value="whole-office">Whole Office — everyone submits (e.g. Monthly CSF Report)</option>
                            </select>
                            <span class="material-symbols-outlined select-icon">expand_more</span>
                        </div>
                        <span asp-validation-for="TaskType" class="field-error"></span>
                        <p class="modal-sub" id="wholeOfficeNote" style="margin-top:4px;" hidden>
                            Every active Division Chief and employee (@ViewBag.WholeOfficeCount people) gets this task and submits their own. You review each submission.
                        </p>
                    </div>

                    <!-- Target Department -->
                    <div class="field-group" id="targetDepartmentGroup">
                        <label class="field-label" for="targetDepartment">TARGET DEPARTMENT <span class="required-star">*</span></label>
                        <div class="select-wrap">
                            <select class="pill-input" id="targetDepartment" asp-for="OwningDepartment">
                                <option value="">Select department</option>
                                @foreach (var dept in (string[])ViewBag.TargetDepartments)
                                {
                                    <option value="@dept">@dept</option>
                                }
                            </select>
                            <span class="material-symbols-outlined select-icon">expand_more</span>
                        </div>
                        <span asp-validation-for="OwningDepartment" class="field-error"></span>
                    </div>

                    <!-- Responsible Admin — every active Admin is rendered here once,
                         tagged with their own department; responsible-admin-lookup.js
                         hides the ones that don't match the selected Target Department.
                         No network call, so the list can never come back empty due to a
                         failed fetch. -->
                    <div class="field-group" id="responsibleAdminGroup">
                        <label class="field-label" for="responsibleAdmin">RESPONSIBLE ADMIN <span class="required-star">*</span></label>
                        <div class="select-wrap">
                            <select class="pill-input" id="responsibleAdmin" asp-for="ResponsibleAdminUserId" data-responsible-admin-select>
                                <option value="">Select responsible Admin</option>
                                @foreach (var admin in (IEnumerable<DTIOneLink.Models.User>)ViewBag.ResponsibleAdmins)
                                {
                                    <option value="@admin.Id" data-department="@admin.Department">@admin.FullName (@admin.Department)</option>
                                }
                            </select>
                            <span class="material-symbols-outlined select-icon">expand_more</span>
                        </div>
                        <p class="modal-sub" style="margin-top:4px;">Division Chief or Supervisor for the selected department.</p>
                        <span asp-validation-for="ResponsibleAdminUserId" class="field-error"></span>
                    </div>

                    <!-- Subtasks — optional, plain-text breakdown. Only applies to a
                         Department Directive; hidden via JS for Direct Admin Task and
                         ignored server-side if submitted anyway (see TasksController). -->
                    <div class="field-group" id="subtasksFieldGroup">
                        <label class="field-label">SUBTASKS</label>
                        <div id="subtaskList" class="subtask-list"></div>
                        <button type="button" id="addSubtaskBtn" class="subtask-add-btn">
                            <span class="material-symbols-outlined">add</span>
                            Add subtask
                        </button>
                        <p class="modal-sub" style="margin-top:4px;">Optional — break this down now, or add subtasks later.</p>
                    </div>
                }

                                             <!-- Due Date -->
                <div class="field-row">
                    <div class="field-group">
                        <label class="field-label" for="dueDate">DUE DATE <span class="required-star">*</span></label>
                        <div class="select-wrap">
                            <input class="pill-input" id="dueDate" asp-for="DueDate" type="date" />
                            <span class="material-symbols-outlined select-icon">calendar_today</span>
                        </div>
                        <span asp-validation-for="DueDate" class="field-error"></span>
                    </div>
                    <div class="field-group">
                        <label class="field-label" for="recurrence">REPEAT</label>
                        <div class="select-wrap">
                            <select class="pill-input" id="recurrence" asp-for="Recurrence">
                                <option value="">Does not repeat</option>
                                <option value="daily">Every day</option>
                                <option value="weekly">Every week</option>
                                <option value="monthly">Every month</option>
                                <option value="quarterly">Every quarter</option>
                            </select>
                            <span class="material-symbols-outlined select-icon">expand_more</span>
                        </div>
                        <p class="modal-sub" style="margin-top:4px;">On each due date, a new copy is sent out the same way as this task.</p>
                        <span asp-validation-for="Recurrence" class="field-error"></span>
                    </div>
                </div>
                <!-- Priority -->
                <div class="field-group">
                    <span class="field-label">PRIORITY LEVEL <span class="required-star">*</span></span>
                    <div class="priority-row">
                        <label class="priority-option">
                            <input type="radio" asp-for="Priority" value="low" />
                            <div class="priority-pill">
                                <span class="priority-dot dot-low"></span>
                                <span>Low</span>
                            </div>
                        </label>
                        <label class="priority-option">
                            <input type="radio" asp-for="Priority" value="medium" checked />
                            <div class="priority-pill">
                                <span class="priority-dot dot-medium"></span>
                                <span>Medium</span>
                            </div>
                        </label>
                        <label class="priority-option">
                            <input type="radio" asp-for="Priority" value="high" />
                            <div class="priority-pill">
                                <span class="priority-dot dot-high"></span>
                                <span>High</span>
                            </div>
                        </label>
                    </div>
                    <span asp-validation-for="Priority" class="field-error"></span>
                </div>


            </form>
        </div>

        <!-- Footer -->
        <div class="modal-footer">
            <a asp-controller="Tasks" asp-action="Index" class="btn-cancel">Cancel</a>
            <button class="btn-create" id="createBtn" type="submit" form="taskForm">
                <span class="material-symbols-outlined"
                      style="font-variation-settings:'FILL' 1; font-size:20px;">add</span>
                Create Task
            </button>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/responsible-admin-lookup.js" asp-append-version="true"></script>
    <script src="~/js/subtask-list.js" asp-append-version="true"></script>
    <script src="~/js/tasks-create.js" asp-append-version="true"></script>
    <script>
        (function () {
            var taskTypeSelect = document.getElementById('taskType');
            var subtasksGroup = document.getElementById('subtasksFieldGroup');
            if (!taskTypeSelect || !subtasksGroup) return;

            // Direct Admin: no subtasks. Whole Office: no division, Responsible
            // Admin or subtasks (it goes to everyone).
            function syncSubtaskVisibility() {
                var type = taskTypeSelect.value;
                var wholeOffice = type === 'whole-office';
                subtasksGroup.style.display = type === 'direct-admin' || wholeOffice ? 'none' : '';
                ['targetDepartmentGroup', 'responsibleAdminGroup'].forEach(function (id) {
                    var group = document.getElementById(id);
                    if (group) group.style.display = wholeOffice ? 'none' : '';
                });
                var note = document.getElementById('wholeOfficeNote');
                if (note) note.hidden = !wholeOffice;
            }

            taskTypeSelect.addEventListener('change', syncSubtaskVisibility);
            syncSubtaskVisibility();
        })();
    </script>
}
