@model DTIOneLink.Models.TaskItem
@{
    Layout = Context.Session.GetString("UserRole") == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : "~/Views/Admin/AdminLayout.cshtml";
    ViewData["Title"] = "Main Task Details";
    ViewData["LiveRefresh"] = true; // auto-refresh when data changes (live-refresh.js)
    var isOpd = Context.Session.GetString("UserRole") == "SuperAdmin";
    var isAssignedByOpd = DTIOneLink.Services.TaskTypes.IsAssignedByOpd(Model.TaskType);
    var hasStarted = ViewBag.HasStarted as bool? ?? false;

    var task = Model;
    var taskCode = $"TASK-{task.Id:D4}";
    var displayLabel = DTIOneLink.Services.TaskWorkflow.DisplayLabel(task.Status, task.DueDate);
    var displayStatus = DTIOneLink.Services.TaskWorkflow.DisplayStatus(task.Status, task.DueDate);

    var subtasks = task.Subtasks?.OrderBy(s => s.DueDate).ToList() ?? new List<DTIOneLink.Models.TaskItem>();

    // Plain-language sentence + icon per status — this page states status as
    // a full sentence first, not just a colored pill, for readers who may
    // not reliably read color alone.
    (string Sentence, string Icon) StatusSentence(string ds) => ds switch
    {
        "overdue" => ("This task is overdue.", "warning"),
        "in-progress" => ("This task is in progress.", "autorenew"),
        "for-review" => ("Waiting for review.", "fact_check"),
        "returned-for-correction" => ("Sent back for correction.", "undo"),
        "completed" => ("This task is complete.", "check_circle"),
        _ => ("Not started yet.", "radio_button_unchecked")
    };

    (string Label, string Icon) TaskTypeInfo(string? type) => type switch
    {
        DTIOneLink.Services.TaskTypes.DepartmentDirective => ("Department Directive", "campaign"),
        DTIOneLink.Services.TaskTypes.DirectAdmin => ("Direct Admin Task", "badge"),
        DTIOneLink.Services.TaskTypes.WholeOffice => ("Whole Office Task", "groups"),
        _ => ("Task", "task")
    };
    var typeInfo = TaskTypeInfo(task.TaskType);
}

@section Styles {
    <link rel="stylesheet" href="~/css/tasks-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/main-task-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notice-dialog.css" asp-append-version="true" />
}

<div class="mtd">
    @if (TempData["SuccessMessage"] is string mtdSuccess)
    {
        <div class="success-banner">
            <span class="material-symbols-outlined">check_circle</span>
            <span>@mtdSuccess</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is string mtdError)
    {
        <div class="success-banner error-banner" role="alert">
            <span class="material-symbols-outlined">error</span>
            <span>@mtdError</span>
        </div>
    }

    <nav class="mtd-breadcrumb">
        <a asp-controller="Tasks" asp-action="Index">← Back to Task Management</a>
        <span class="mtd-taskcode">@taskCode</span>
    </nav>

    <!-- Hero: identity, status said as a full sentence, progress, and every
         admin control that touches the Main Task itself (Reassign, Stop
         Repeating) — kept here rather than cut, since they're real actions
         this page already supports, not something the redesign removes. -->
    <section class="mtd-hero">
        <div class="mtd-hero-type">
            <span class="material-symbols-outlined" aria-hidden="true">@typeInfo.Icon</span>@typeInfo.Label
        </div>
        <h1 class="mtd-hero-title">@task.TaskName</h1>
        <div class="mtd-hero-dept">@task.OwningDepartment</div>
        @if (!string.IsNullOrWhiteSpace(task.Description))
        {
            <p class="mtd-hero-desc">@task.Description</p>
        }

        <div class="mtd-hero-status mtd-hero-status--@displayStatus">
            <span class="material-symbols-outlined" aria-hidden="true">@StatusSentence(displayStatus).Icon</span>
            <div>
                <div class="mtd-hero-status-line">@StatusSentence(displayStatus).Sentence</div>
                @if (displayStatus == "overdue")
                {
                    <div class="mtd-hero-status-sub">It was due on @DTIOneLink.Helpers.DisplayHelpers.FormalDate(task.DueDate).</div>
                }
                else
                {
                    <div class="mtd-hero-status-sub">Due @DTIOneLink.Helpers.DisplayHelpers.FormalDate(task.DueDate).</div>
                }
            </div>
        </div>

        <div class="mtd-hero-progress">
            <span>Progress — @(task.Progress)% @(task.Progress == 0 ? "(not started)" : task.Progress == 100 ? "(complete)" : "done")</span>
            <div class="mtd-hero-progress-row">
                <div class="mtd-hero-progress-track"><div class="mtd-hero-progress-fill mtd-hero-progress-fill--@(task.Progress == 100 ? "done" : "")" style="width:@(task.Progress)%;"></div></div>
                <strong>@task.Progress%</strong>
            </div>
        </div>

        <!-- One bordered "meta" block instead of three separately-divided
             strips — Responsible Admin/Created by, Reassign, and Repeats
             are all facts about the same thing (who's accountable for this
             task), so they read as one group, not a stack of accordions. -->
        <div class="mtd-hero-meta">
            <div class="mtd-hero-facts">
                <div>
                    <span>Responsible Admin</span>
                    <strong>@(task.ResponsibleAdmin?.FullName ?? "Unassigned")</strong>
                </div>
                <div>
                    <span>Created by</span>
                    <strong>@(task.CreatedBy?.FullName ?? "Unknown")</strong>
                </div>
            </div>

            @if (isOpd && task.TaskType != DTIOneLink.Services.TaskTypes.WholeOffice && task.ResponsibleAdminUserId.HasValue)
            {
                var responsibleAdmins = (ViewBag.ResponsibleAdmins as List<DTIOneLink.Models.User>) ?? new List<DTIOneLink.Models.User>();
                // The Responsible Admin must stay within the task's own department
                // — same rule ValidateResponsibleAdminAsync enforces at creation.
                var sameDeptAdmins = responsibleAdmins
                    .Where(a => a.Id != task.ResponsibleAdminUserId && a.Department == task.OwningDepartment)
                    .ToList();
                @if (sameDeptAdmins.Any())
                {
                    <form asp-controller="Tasks" asp-action="ReassignResponsibleAdmin" asp-route-id="@task.Id" method="post"
                          class="mtd-hero-reassign" id="mtdReassignForm" data-task-name="@task.TaskName">
                        @Html.AntiForgeryToken()
                        <select name="newResponsibleAdminUserId" class="mtd-hero-select" id="mtdReassignSelect" required>
                            <option value="">Reassign to…</option>
                            @foreach (var admin in sameDeptAdmins)
                            {
                                <option value="@admin.Id">@admin.FullName</option>
                            }
                        </select>
                        <button type="submit" class="mtd-hero-reassign-btn">Reassign</button>
                    </form>
                }
                else
                {
                    <div class="mtd-hero-reassign-empty">
                        <span class="material-symbols-outlined" aria-hidden="true">info</span>
                        No other Admin in @task.OwningDepartment to reassign this to.
                    </div>
                }
            }

            @if (task.Recurrence != null)
            {
                <div class="mtd-hero-repeats">
                    <span class="material-symbols-outlined" aria-hidden="true">autorenew</span>
                    <span>Repeats @DTIOneLink.Services.TaskRecurrence.Label(task.Recurrence)</span>
                    @if (isOpd)
                    {
                        <form asp-controller="Tasks" asp-action="StopRepeating" asp-route-id="@task.Id" method="post" id="mtdStopRepeatForm">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="mtd-hero-stop-repeat">Stop repeating</button>
                        </form>
                    }
                </div>
            }
        </div>
    </section>

    <!-- Primary actions -->
    <div class="mtd-actions">
        @* Edit only opens for an Admin assigning people to a department task
           with no subtasks; in every other case TasksController.Edit sends
           them straight back here, so the button isn't shown. *@
        @if (!isOpd && !isAssignedByOpd && !subtasks.Any())
        {
            <a asp-controller="Tasks" asp-action="Edit" asp-route-id="@task.Id" class="mtd-btn mtd-btn-outline">
                <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                Edit this task
            </a>
        }
        @if (isOpd)
        {
            @if (hasStarted)
            {
                <div class="mtd-delete-disabled">
                    <span class="material-symbols-outlined" aria-hidden="true">lock</span>
                    Deleting is turned off — work has already started on this task@(subtasks.Any() ? " or one of its subtasks" : "").
                </div>
            }
            else
            {
                <form asp-controller="Tasks" asp-action="Delete" asp-route-id="@task.Id" method="post"
                      id="mtdDeleteForm" data-has-subtasks="@Json.Serialize(subtasks.Any())">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="mtd-btn mtd-btn-danger">
                        <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                        Delete this task
                    </button>
                </form>
            }
        }
    </div>

    <p class="mtd-note">
        This task's overall status and progress come from the subtasks below —
        it only reaches For Review once every subtask has been submitted for
        review or completed, and only becomes Completed once every subtask is
        individually completed.
    </p>

    @if (!subtasks.Any() && task.Assignments != null && task.Assignments.Any())
    {
        <h2 class="mtd-section-title">Assigned Employees (@task.Assignments.Count)</h2>
        <div class="mtd-stack">
            @foreach (var a in task.Assignments.OrderByDescending(x => x.IsPrimaryAssignee).ThenBy(x => x.User?.FullName))
            {
                var aDisplayStatus = DTIOneLink.Services.TaskWorkflow.DisplayStatus(a.Status, task.DueDate);
                var pending = isOpd && DTIOneLink.Services.TaskTypes.IsAssignedByOpd(task.TaskType)
                              && DTIOneLink.Services.TaskWorkflow.Normalize(a.Status) == DTIOneLink.Services.TaskWorkflow.ForReview
                    ? task.Submissions.Where(s => s.TaskAssignmentId == a.Id && s.Decision == null)
                                      .OrderByDescending(s => s.SubmittedAt).FirstOrDefault()
                    : null;
                <div class="mtd-card">
                    <div class="mtd-card-title">
                        @(a.User?.FullName ?? "Unknown")@(a.IsPrimaryAssignee ? " (Primary)" : "")
                    </div>
                    @if (a.ReassignedFrom != null)
                    {
                        <div class="mtd-card-sub">Took over from @a.ReassignedFrom.FullName</div>
                    }
                    <div class="mtd-card-status">
                        <span class="material-symbols-outlined" aria-hidden="true">@StatusSentence(aDisplayStatus).Icon</span>
                        <span>@StatusSentence(aDisplayStatus).Sentence</span>
                    </div>
                    <div class="mtd-card-progress-row">
                        <div class="mtd-card-progress-track"><div class="mtd-card-progress-fill" style="width:@(a.Progress)%;"></div></div>
                        <strong>@a.Progress%</strong>
                    </div>
                    <div class="mtd-card-sub">Assigned by @(a.AssignedBy?.FullName ?? "Unknown")</div>
                    @if (pending != null)
                    {
                        <a asp-controller="Tasks" asp-action="Review" asp-route-id="@pending.Id" class="mtd-card-link">
                            <span class="material-symbols-outlined" aria-hidden="true">fact_check</span>
                            Review submission
                        </a>
                    }
                </div>
            }
        </div>
    }

    @* Subtasks only exist on a Department Directive — suppressing this
       whole section for the other two task types (rather than showing it
       permanently empty) is the one behavior change from the original page. *@
    @if (DTIOneLink.Services.TaskTypes.DepartmentDirective == task.TaskType)
    {
        <h2 class="mtd-section-title">Subtasks (@subtasks.Count)@(subtasks.Any() ? " — in order of due date" : "")</h2>

        @if (!subtasks.Any())
        {
            <div class="mtd-empty">
                <span class="material-symbols-outlined" aria-hidden="true">assignment</span>
                <p>No subtasks yet</p>
                @if (!isOpd && !isAssignedByOpd)
                {
                    <p class="mtd-empty-sub">Click Edit above to assign employees to this directive directly.</p>
                }
            </div>
        }
        else
        {
            <div class="mtd-timeline">
                @foreach (var sub in subtasks)
                {
                    var subDisplayStatus = DTIOneLink.Services.TaskWorkflow.DisplayStatus(sub.Status, sub.DueDate);
                    var assigneeNames = sub.Assignments != null && sub.Assignments.Any()
                        ? string.Join(", ", sub.Assignments.Select(a => (a.User?.FullName ?? "Unknown")
                            + (a.ReassignedFrom != null ? $" (took over from {a.ReassignedFrom.FullName})" : "")))
                        : null;
                    <div class="mtd-timeline-item mtd-timeline-item--@subDisplayStatus">
                        <div class="mtd-timeline-dot" aria-hidden="true"></div>
                        <div class="mtd-timeline-card">
                            <div class="mtd-timeline-due">Due @DTIOneLink.Helpers.DisplayHelpers.FormalDate(sub.DueDate)</div>
                            <div class="mtd-timeline-title">@sub.TaskName</div>
                            <div class="mtd-card-status">
                                <span class="material-symbols-outlined" aria-hidden="true">@StatusSentence(subDisplayStatus).Icon</span>
                                <span>@StatusSentence(subDisplayStatus).Sentence</span>
                            </div>
                            <div class="mtd-card-progress-row">
                                <div class="mtd-card-progress-track"><div class="mtd-card-progress-fill mtd-card-progress-fill--@(sub.Progress == 100 ? "done" : "")" style="width:@(sub.Progress)%;"></div></div>
                                <strong>@sub.Progress%</strong>
                            </div>
                            <div class="mtd-card-sub">
                                <span class="material-symbols-outlined" aria-hidden="true">@(assigneeNames == null ? "person_off" : "group")</span>
                                @(assigneeNames ?? "Not yet assigned to anyone")
                            </div>
                            <a asp-controller="Tasks" asp-action="Edit" asp-route-id="@sub.Id" class="mtd-card-link">
                                <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                                Edit this subtask
                            </a>
                        </div>
                    </div>
                }
            </div>
        }

        @* Only the OPD (SuperAdmin) creates tasks or adds subtasks — an
           Admin/Supervisor only assigns the subtasks already there. *@
        @if (isOpd)
        {
            <form asp-controller="Tasks" asp-action="AddSubtask" asp-route-id="@task.Id" method="post" class="mtd-add-subtask">
                @Html.AntiForgeryToken()
                <label for="mtdNewSubtask" class="mtd-add-subtask-label">New subtask name</label>
                <input type="text" id="mtdNewSubtask" name="subtaskName" data-capitalize="title" placeholder="e.g. Submit consolidated report" maxlength="200" required>
                <button type="submit" class="mtd-btn mtd-btn-primary">
                    <span class="material-symbols-outlined" aria-hidden="true">edit_note</span>
                    Add a new subtask
                </button>
            </form>
        }
    }
</div>

<partial name="_NoticeDialog" />

@section Scripts {
    <script src="~/js/notice-dialog.js" asp-append-version="true"></script>
    <script src="~/js/main-task-details.js" asp-append-version="true"></script>
}
