@model DTIOneLink.Models.TaskSubmission
@{
    Layout = Context.Session.GetString("UserRole") == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : "~/Views/Admin/AdminLayout.cshtml";
    ViewData["Title"] = "Review Submission";
    var task = Model.Task!;
    var submittedByName = Model.TaskAssignment?.User?.FullName ?? "this person";
    var previewableExtensions = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { ".pdf", ".jpg", ".jpeg", ".png" };
    var canPreview = previewableExtensions.Contains(System.IO.Path.GetExtension(Model.ProofFileName));
}

@section Styles {
    <link rel="stylesheet" href="~/css/tasks-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tasks-create.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tasks-review.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notice-dialog.css" asp-append-version="true" />
}

<!-- ── The real Task Management list, behind the form ───── -->
@* inert: it can't be clicked or tabbed into while the dialog is open. *@
@if (ViewBag.TaskList is DTIOneLink.Models.TaskIndexViewModel taskList)
{
    <div class="task-list-behind" inert aria-hidden="true">
        <partial name="_TaskList" model="taskList" />
    </div>
}

<!-- ── Review Submission Modal (native dialog, opened by tasks-review.js) ── -->
<dialog class="modal-overlay" id="reviewModal" aria-labelledby="reviewModalTitle"
        data-close-url="@Url.Action("Index", "Tasks")">
    <div class="modal">

        <!-- Header -->
        <div class="modal-header">
            <div>
                <h2 class="modal-title" id="reviewModalTitle">Review Submission — @task.TaskName</h2>
                <p class="modal-sub">Submitted @Model.SubmittedAt.ToString("MMM d, yyyy, h:mm tt") by @submittedByName</p>
            </div>
            <a asp-controller="Tasks" asp-action="Index" class="modal-close" aria-label="Close">
                <span class="material-symbols-outlined">close</span>
            </a>
        </div>

        <!-- Body -->
        <div class="modal-body">
            <div class="task-review">
                <div class="tr-card">
                    <p class="tr-info-row"><strong>Remarks from employee:</strong> @(string.IsNullOrWhiteSpace(Model.Remarks) ? "(none)" : Model.Remarks)</p>
                    @if (canPreview)
                    {
                        <a asp-controller="Employee" asp-action="PreviewProof" asp-route-submissionId="@Model.Id" class="tr-download" target="_blank" rel="noopener">
                            Preview submitted proof (@Model.ProofFileName)
                        </a>
                    }
                    <a asp-controller="Employee" asp-action="DownloadProof" asp-route-submissionId="@Model.Id" class="tr-download">
                        Download submitted proof (@Model.ProofFileName)
                    </a>
                </div>

                <form id="trForm" asp-controller="Tasks" asp-action="Review" method="post"
                      data-task-name="@task.TaskName" data-submitted-by="@submittedByName">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="SubmissionId" value="@Model.Id" />

                    <div asp-validation-summary="ModelOnly" class="tr-error-text"></div>

                    <div class="tr-field">
                        <label class="tr-label">
                            Admin remarks <span class="tr-required">*</span>
                            <span class="tr-hint">required if returning — shown to employee</span>
                        </label>
                        <textarea asp-for="AdminRemarks" class="tr-textarea"></textarea>
                        <span asp-validation-for="AdminRemarks" class="tr-error-text"></span>
                    </div>
                </form>
            </div>
        </div>

        <!-- Footer -->
        <div class="modal-footer">
            <a asp-controller="Tasks" asp-action="Index" class="btn-cancel">Cancel</a>
            <div class="task-review" style="display: contents;">
                <button type="submit" name="Decision" value="return" class="tr-btn tr-btn-return" form="trForm">Return for Correction</button>
                <button type="submit" name="Decision" value="approve" class="tr-btn tr-btn-approve" form="trForm">Approve — Mark Completed</button>
            </div>
        </div>

    </div>
</dialog>

<partial name="_NoticeDialog" />

@section Scripts {
    <script src="~/js/notice-dialog.js" asp-append-version="true"></script>
    <script src="~/js/tasks-review.js" asp-append-version="true"></script>
}
