@model DTIOneLink.Models.TaskEditViewModel
@{
    Layout = Context.Session.GetString("UserRole") == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : "~/Views/Admin/AdminLayout.cshtml";
    ViewData["Title"] = "Edit Task";
    var taskCode = ViewBag.TaskCode as string ?? $"TASK-{Model.Id:D4}";
    var currentStatus = ViewBag.CurrentStatus as string ?? "pending";
    var currentProgress = ViewBag.CurrentProgress as int? ?? 0;
    var createdAt = ViewBag.CreatedAt as DateTime? ?? DateTime.UtcNow;
    var assignmentSummaries = ViewBag.AssignmentSummaries as List<DTIOneLink.Models.TaskAssignmentSummaryViewModel>
        ?? new List<DTIOneLink.Models.TaskAssignmentSummaryViewModel>();
    var hasAssigneeError = ViewData.ModelState["AssigneeIds"]?.Errors.Count > 0;
    var isAssignmentOnly = ViewBag.IsAssignmentOnly as bool? ?? false;
    var opdDueDate = ViewBag.OpdDueDate as DateTime?;
    var canPassOpdDueDate = ViewBag.CanPassOpdDueDate as bool? ?? false;
    var isDirectMainTaskAssignment = ViewBag.IsDirectMainTaskAssignment as bool? ?? false;
    // False only for a Main Task that has subtasks — assignment happens at
    // the subtask level there instead, for any role including SuperAdmin.
    var showAssigneeSection = ViewBag.ShowAssigneeSection as bool? ?? true;
    var creatorLabel = ViewBag.CreatorLabel as string ?? "Unknown";
    var comments = ViewBag.Comments as List<DTIOneLink.Models.TaskComment> ?? new();
    var activities = ViewBag.Activities as List<DTIOneLink.Models.TaskActivity> ?? new();

    // A validation error always lives on either the Details fields or the
    // People (AssigneeIds) field — land on whichever tab actually has the
    // error so a rejected submit never looks like it silently did nothing.
    var defaultTab = hasAssigneeError && showAssigneeSection ? "people" : "details";

    string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "NA";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
    }
    var currentUserInitials = GetInitials(Context.Session.GetString("FullName"));

    // Same shape as _TaskDetails.cshtml's activity timeline: chronological,
    // newest first, with "Created this task" folded in by its real date
    // rather than always pinned first.
    var activityEntries = activities
        .Select(a => new
        {
            When = DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(a.OccurredAt),
            User = a.PerformedBy?.FullName ?? "Unknown",
            Details = (string?)a.Details,
            Dot = a.ActivityType switch
            {
                "validated" => (a.Details ?? "").StartsWith("Submission approved") ? "approved" : "returned",
                "proof-submitted" => "submitted",
                "status-changed" => "status",
                _ => "default"
            },
            Download = a.RelatedSubmission
        })
        .Append(new
        {
            When = DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(createdAt),
            User = creatorLabel,
            Details = (string?)"Created this task.",
            Dot = "default",
            Download = (DTIOneLink.Models.TaskSubmission?)null
        })
        .OrderByDescending(e => e.When)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/tasks-edit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/assignee-multiselect.css" asp-append-version="true" />
}

<div class="edit-task">
    <!-- Breadcrumb & Header Actions -->
    <div class="et-header">
        <div>
            <nav class="et-breadcrumb">
                <ol>
                    <li><a asp-controller="Tasks" asp-action="Index">Task Management</a></li>
                    <li><span class="et-sep">/</span></li>
                    <li><span>@taskCode</span></li>
                    <li><span class="et-sep">/</span></li>
                    <li><span class="et-current">Edit</span></li>
                </ol>
            </nav>
            <h2 class="et-title">Edit Task</h2>
        </div>
        <div class="et-header-actions">
            <a asp-controller="Tasks" asp-action="Index" class="et-btn et-btn-outline">
                Cancel
            </a>
            <button form="editTaskForm" type="submit" class="et-btn et-btn-primary">
                <span class="material-symbols-outlined">save</span>
                Save Changes
            </button>
        </div>
    </div>

    @if (isAssignmentOnly)
    {
        <p class="et-overview-note" style="margin-bottom:16px;">
            This task was issued by OPD (SuperAdmin) — you can manage who's assigned to it and adjust the due date. Task name, priority, and description are locked.
        </p>
    }

    <!-- Tabbed workspace: one card, Details/People/Discussion/History switch
         in place instead of a long two-pane scroll. Details+People stay
         inside editTaskForm (same POST as before); Discussion/History are
         read-only or their own separate form, so they sit outside it. -->
    <div class="et-workspace">
        <div class="et-tab-bar" role="tablist">
            <button type="button" class="et-tab@(defaultTab == "details" ? " active" : "")" role="tab"
                    aria-selected="@(defaultTab == "details" ? "true" : "false")" data-tab-btn="details">
                Details
            </button>
            @if (showAssigneeSection)
            {
                <button type="button" class="et-tab@(defaultTab == "people" ? " active" : "")" role="tab"
                        aria-selected="@(defaultTab == "people" ? "true" : "false")" data-tab-btn="people">
                    People <span class="et-tab-badge">@assignmentSummaries.Count</span>
                </button>
            }
            <button type="button" class="et-tab" role="tab" aria-selected="false" data-tab-btn="discussion">
                Discussion <span class="et-tab-badge">@comments.Count</span>
            </button>
            <button type="button" class="et-tab" role="tab" aria-selected="false" data-tab-btn="history">
                History <span class="et-tab-badge">@activityEntries.Count</span>
            </button>
        </div>

        <form id="editTaskForm" asp-controller="Tasks" asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="et-error-text" style="margin: 20px 28px 0;"></div>

            <!-- Details tab -->
            <div class="et-tab-panel" data-tab-panel="details" hidden="@(defaultTab == "details" ? null : "hidden")">
                <div class="et-field-grid">

                    <!-- Task Name -->
                    <div class="et-field et-field-full">
                        <label asp-for="TaskName" class="et-label">
                            Task Name <span class="et-required">*</span>
                        </label>
                        <input asp-for="TaskName" class="et-input et-input-lg" data-capitalize="title" readonly="@(isAssignmentOnly ? "readonly" : null)" />
                        <span asp-validation-for="TaskName" class="et-error-text"></span>
                    </div>

                    <!-- Due Date -->
                    <div class="et-field">
                        <label asp-for="DueDate" class="et-label">Due Date</label>
                        <input asp-for="DueDate" type="datetime-local" class="et-input"
                               max="@(canPassOpdDueDate ? null : opdDueDate?.ToString("yyyy-MM-ddTHH:mm"))" />
                        @if (opdDueDate.HasValue && canPassOpdDueDate)
                        {
                            <span class="et-ca-note">This task is due soon or overdue, so you may set a date after the OPD's deadline (@DTIOneLink.Helpers.DisplayHelpers.FormalDate(opdDueDate.Value)). The OPD will be notified.</span>
                        }
                        else if (opdDueDate.HasValue)
                        {
                            <span class="et-ca-note">No later than the OPD's deadline: @DTIOneLink.Helpers.DisplayHelpers.FormalDate(opdDueDate.Value)</span>
                        }
                        <span asp-validation-for="DueDate" class="et-error-text"></span>
                    </div>

                    <!-- Priority -->
                    <div class="et-field et-field-full">
                        <label class="et-label">Priority</label>
                        <div class="et-priority-options">
                            <label class="et-priority-pill low">
                                <input id="priorityLow" type="radio" name="Priority" value="low" checked="@(Model.Priority == "low" ? "checked" : null)" disabled="@(isAssignmentOnly ? "disabled" : null)" />
                                <span>Low</span>
                            </label>
                            <label class="et-priority-pill medium">
                                <input id="priorityMedium" type="radio" name="Priority" value="medium" checked="@(Model.Priority == "medium" ? "checked" : null)" disabled="@(isAssignmentOnly ? "disabled" : null)" />
                                <span>Medium</span>
                            </label>
                            <label class="et-priority-pill high">
                                <input id="priorityHigh" type="radio" name="Priority" value="high" checked="@(Model.Priority == "high" ? "checked" : null)" disabled="@(isAssignmentOnly ? "disabled" : null)" />
                                <span>High</span>
                            </label>
                        </div>
                        <span asp-validation-for="Priority" class="et-error-text"></span>

                        @if (!isAssignmentOnly)
                        {
                            <!-- Rule-based suggestion — never auto-applied. Admin/Supervisor must
                                 click "Use this" to accept it, or just pick a radio button directly
                                 to override it. -->
                            <div id="prioritySuggestionBox" class="et-suggestion-box">
                                <span id="prioritySuggestionText" class="et-suggestion-text">@ViewBag.SuggestedReason</span>
                                <button type="button" id="applyPrioritySuggestion" data-priority="@ViewBag.SuggestedPriority" class="et-suggestion-apply">
                                    Use this
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Description -->
                    <div class="et-field et-field-full">
                        <label asp-for="Description" class="et-label">Task Description</label>
                        <textarea asp-for="Description" rows="6" class="et-textarea" data-capitalize="sentence" readonly="@(isAssignmentOnly ? "readonly" : null)"></textarea>
                        <span asp-validation-for="Description" class="et-error-text"></span>
                    </div>
                </div>

                <!-- Overview stat row — read-only, not part of TaskEditViewModel -->
                <div class="et-stat-row">
                    <div><span>Overall Status</span><strong>@currentStatus</strong></div>
                    <div><span>Overall Progress</span><strong>@currentProgress%</strong></div>
                    <div><span>Created</span><strong>@createdAt.ToString("MMM d, yyyy")</strong></div>
                </div>
                <p class="et-overview-note" style="border-top:none; padding-top:0;">
                    @if (showAssigneeSection)
                    {
                        <text>Overall status/progress is a rollup: the task only moves to For Review once every
                        assignee on the People tab has submitted their own proof, and only becomes
                        Completed once every assignee's submission is approved.</text>
                    }
                    else
                    {
                        <text>Overall status/progress is a rollup from this directive's subtasks — it only moves
                        to For Review once every subtask has been submitted for review or completed, and only
                        becomes Completed once every subtask is individually completed. See the subtasks
                        themselves on the <a asp-controller="Tasks" asp-action="MainTaskDetails" asp-route-id="@Model.Id">Main Task page</a>.</text>
                    }
                </p>
            </div>

            <!-- People tab — never rendered for a Main Task with subtasks,
                 for any role including SuperAdmin; assignment happens at
                 the subtask level there instead. -->
            @if (showAssigneeSection)
            {
            <div class="et-tab-panel" data-tab-panel="people" hidden="@(defaultTab == "people" ? null : "hidden")">
                <label class="et-label" id="assigneeLabel">Assignees</label>
                @if (assignmentSummaries.Any())
                {
                    <a asp-controller="Tasks" asp-action="Checklist" asp-route-id="@Model.Id" class="et-ca-reassign" style="display:inline-block; margin-bottom:8px;">Manage checklists</a>
                    @* Current assignees can't be removed, only reassigned: the person
                       taking over continues from their progress, and the previous
                       person no longer sees the task. *@
                    var reassignOptions = ((Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Employees)
                        .Where(e => !Model.AssigneeIds.Contains(int.Parse(e.Value)))
                        .ToList();
                    <ul class="et-current-assignees" style="margin-top:12px;">
                        @foreach (var a in assignmentSummaries)
                        {
                            var pickedId = Model.ReassignTo.TryGetValue(a.UserId, out var picked) ? picked : null;
                            var reassigning = pickedId.HasValue;
                            <li class="et-current-assignee@(reassigning ? " is-reassigning" : "")" data-current-assignee>
                                <div class="et-ca-avatar" aria-hidden="true">@GetInitials(a.Name)</div>
                                <div class="et-ca-main">
                                    <span class="et-ca-name">@a.Name@(a.IsPrimaryAssignee ? " (Primary)" : "")</span>
                                    @if (a.ReassignedFromName != null)
                                    {
                                        <span class="et-ca-from">Took over from @a.ReassignedFromName</span>
                                    }
                                </div>
                                <span class="et-ca-progress">@a.Progress% · @DTIOneLink.Services.TaskWorkflow.DisplayLabel(a.Status, Model.DueDate)</span>
                                @if (!a.CanReassign)
                                {
                                    <span class="et-ca-locked" title="Their proof is awaiting review or already approved, so the task stays with them.">Submitted</span>
                                }
                                else
                                {
                                    <button type="button" class="et-ca-reassign" data-reassign-toggle
                                            aria-expanded="@(reassigning ? "true" : "false")">@(reassigning ? "Undo" : "Reassign")</button>
                                    <div class="et-ca-reassign-to" data-reassign-panel hidden="@(reassigning ? null : "hidden")">
                                        <label class="et-ca-reassign-label" for="reassign-@a.UserId">Give @a.Name's part (@a.Progress%) to</label>
                                        <select id="reassign-@a.UserId" name="ReassignTo[@a.UserId]" class="et-input"
                                                data-reassign-select required disabled="@(reassigning ? null : "disabled")">
                                            <option value="">Select Person</option>
                                            @foreach (var emp in reassignOptions)
                                            {
                                                <option value="@emp.Value" selected="@(pickedId?.ToString() == emp.Value ? "selected" : null)">@emp.Text</option>
                                            }
                                        </select>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                    <p class="et-ca-note">Reassigning hands over the task with its progress when you save. Adding someone below keeps everyone above.</p>
                }
                <div class="assignee-select@(hasAssigneeError ? " assignee-select-invalid" : "")" data-assignee-select>
                    <button type="button"
                            class="assignee-select-trigger"
                            id="assigneeTrigger"
                            data-assignee-trigger
                            aria-haspopup="true"
                            aria-expanded="false"
                            aria-labelledby="assigneeLabel assigneeTrigger">
                        <span class="assignee-select-label is-placeholder" data-assignee-label>@(Model.AssigneeIds.Any() ? "Add Another Person" : "Select Assignees")</span>
                        <span class="material-symbols-outlined assignee-select-chevron">expand_more</span>
                    </button>
                    <div class="assignee-select-panel" data-assignee-panel role="group" aria-label="Employees" hidden>
                        <div class="assignee-select-search-wrap">
                            <span class="material-symbols-outlined assignee-select-search-icon">search</span>
                            <input type="text" class="assignee-select-search" data-assignee-search
                                   placeholder="Search Employees..." aria-label="Search employees" />
                        </div>
                        <div class="assignee-select-options">
                            @* People already assigned are not offered again. *@
                            @foreach (var emp in ((Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Employees)
                                                 .Where(e => !Model.AssigneeIds.Contains(int.Parse(e.Value))))
                            {
                                var empId = int.Parse(emp.Value);
                                <label class="assignee-select-option" data-assignee-option
                                       data-name="@emp.Text.ToLowerInvariant()" data-display-name="@emp.Text">
                                    <input type="checkbox" name="AddAssigneeIds" value="@emp.Value"
                                           checked="@(Model.AddAssigneeIds.Contains(empId) ? "checked" : null)" />
                                    <span>@emp.Text</span>
                                </label>
                            }
                        </div>
                        <p class="assignee-select-empty" data-assignee-empty hidden>No employees found</p>
                    </div>
                </div>
                <span asp-validation-for="AssigneeIds" class="et-error-text"></span>

                @if (isDirectMainTaskAssignment)
                {
                    <!-- Adding a subtask is OPD-only (same rule as Create —
                         see AddSubtask in TasksController), so this directive
                         with no subtasks yet is only ever assigned directly,
                         right here. There used to be an "Add Subtask" box in
                         this spot, but it posted to an OPD-only action, so an
                         Admin/Supervisor who clicked it got nothing but a 403. -->
                    <p class="et-ca-note" style="margin-top:12px;">This directive has no subtasks — assign people to it directly above.</p>
                }

                @if (assignmentSummaries.Any())
                {
                    <h3 class="et-overview-title" style="margin-top:28px; padding-top:20px; border-top:1px solid var(--et-surface-container-highest);">Per-Assignee Status</h3>
                    <dl class="et-overview-list" style="margin-top:14px;">
                        @foreach (var a in assignmentSummaries)
                        {
                            <div>
                                <dt>@a.Name @(a.IsPrimaryAssignee ? " (Primary)" : "")@(a.ReassignedFromName != null ? $" — took over from {a.ReassignedFromName}" : "")</dt>
                                <dd>@a.Status — @a.Progress%</dd>
                            </div>
                        }
                    </dl>
                    <p class="et-overview-note">
                        Each assignee updates their own progress/status from their task detail page — not from here.
                    </p>
                }
            </div>
            }
        </form>

        <!-- Discussion tab -->
        <div class="et-tab-panel" data-tab-panel="discussion" hidden>
            @if (comments.Any())
            {
                <ul class="et-comment-list">
                    @foreach (var comment in comments)
                    {
                        var commentTime = DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(comment.CreatedAt);
                        <li class="et-comment">
                            <div class="et-comment-avatar" aria-hidden="true">@GetInitials(comment.Author?.FullName)</div>
                            <div class="et-comment-body">
                                <div class="et-comment-header">
                                    <span class="et-comment-author">@(comment.Author?.FullName ?? "Unknown")</span>
                                    <span class="et-comment-date">@commentTime.ToString("MMM d, yyyy, h:mm tt")</span>
                                </div>
                                <p class="et-comment-text">@comment.Text</p>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="et-overview-note" style="border-top:none; padding-top:0;">No comments yet.</p>
            }
            <form asp-controller="Employee" asp-action="AddComment" method="post" class="et-comment-form" style="margin-top:16px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskId" value="@Model.Id" />
                <div class="et-comment-avatar" aria-hidden="true">@currentUserInitials</div>
                <div class="et-comment-form-body">
                    <textarea name="text" class="et-comment-input" placeholder="Write a comment..." rows="2" required></textarea>
                    <button type="submit" class="et-btn et-btn-primary">
                        <span class="material-symbols-outlined">send</span>
                        Comment
                    </button>
                </div>
            </form>
        </div>

        <!-- History tab -->
        <div class="et-tab-panel" data-tab-panel="history" hidden>
            <ul class="et-activity-list" style="max-height:none;">
                @foreach (var entry in activityEntries)
                {
                    <li class="et-activity-item">
                        <span class="et-activity-dot et-activity-dot--@entry.Dot" aria-hidden="true"></span>
                        <div class="et-activity-content">
                            <div class="et-activity-header">
                                <span class="et-activity-user">@entry.User</span>
                                <span class="et-activity-date">@entry.When.ToString("MMM d, h:mm tt")</span>
                            </div>
                            <p class="et-activity-details">@entry.Details</p>
                            @if (entry.Download != null)
                            {
                                <a asp-controller="Employee" asp-action="DownloadProof" asp-route-submissionId="@entry.Download.Id" class="et-activity-download">
                                    @entry.Download.ProofFileName
                                </a>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/assignee-multiselect.js" asp-append-version="true"></script>
    <script>
        // Reassign / Undo for a current assignee. The select is disabled
        // (so not sent) unless the row is being reassigned.
        document.querySelectorAll('[data-reassign-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var row = btn.closest('[data-current-assignee]');
                var panel = row.querySelector('[data-reassign-panel]');
                var select = row.querySelector('[data-reassign-select]');
                var opening = panel.hidden;
                panel.hidden = !opening;
                select.disabled = !opening;
                if (!opening) select.value = '';
                row.classList.toggle('is-reassigning', opening);
                btn.textContent = opening ? 'Undo' : 'Reassign';
                btn.setAttribute('aria-expanded', opening ? 'true' : 'false');
                if (opening) select.focus();
            });
        });

        // Tabs: Details/People stay inside editTaskForm (hidden fields in a
        // hidden tab still submit — only a disabled input wouldn't), so
        // switching tabs never drops anything the user already filled in.
        document.querySelectorAll('[data-tab-btn]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var target = btn.getAttribute('data-tab-btn');
                document.querySelectorAll('[data-tab-btn]').forEach(function (b) {
                    var active = b === btn;
                    b.classList.toggle('active', active);
                    b.setAttribute('aria-selected', active ? 'true' : 'false');
                });
                document.querySelectorAll('[data-tab-panel]').forEach(function (panel) {
                    panel.hidden = panel.getAttribute('data-tab-panel') !== target;
                });
            });
        });
    </script>
    <script src="~/js/task-priority-suggestion.js" asp-append-version="true"></script>
}
