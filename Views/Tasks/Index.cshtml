@model DTIOneLink.Models.TaskIndexViewModel
@{
    Layout = Context.Session.GetString("UserRole") == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : "~/Views/Admin/AdminLayout.cshtml";
    ViewData["Title"] = "Task Management";
    ViewData["LiveRefresh"] = true; // auto-refresh when data changes (live-refresh.js)
}
@section Styles {
    <link rel="stylesheet" href="~/css/tasks-index.css" asp-append-version="true" />
}

<!-- ── Success Banner ─────────────────────────────────── -->
@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="success-banner" id="successBanner">
        <span class="material-symbols-outlined">check_circle</span>
        <span>@successMsg</span>
        <button class="success-close" onclick="this.parentElement.remove()" type="button" aria-label="Dismiss">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMsg)
{
    <div class="success-banner error-banner" role="alert">
        <span class="material-symbols-outlined">error</span>
        <span>@errorMsg</span>
        <button class="success-close" onclick="this.parentElement.remove()" type="button" aria-label="Dismiss"><span class="material-symbols-outlined">close</span></button>
    </div>
}

<partial name="_TaskList" model="Model" />


@section Scripts {
    <script src="~/js/tasks-index.js" asp-append-version="true"></script>
}
