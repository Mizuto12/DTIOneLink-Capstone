@model DTIOneLink.Models.TaskItem
@{
    Layout = Context.Session.GetString("UserRole") == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : "~/Views/Admin/AdminLayout.cshtml";
    ViewData["Title"] = "Task Checklist";
    var taskCode = $"TASK-{Model.Id:D4}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tasks-create.css" asp-append-version="true" />
}

<main class="checklist-page">
    <p class="checklist-page__code">@taskCode</p>
    <h1 class="checklist-page__title">@Model.TaskName</h1>
    <p class="modal-sub">
        Each assignee has their own checklist. The moment someone has any items, those items —
        not the progress slider — decide their progress. Up to @DTIOneLink.Services.TaskWorkflow.MaxChecklistItemsPerAssignment items per person.
    </p>

    @if (TempData["SuccessMessage"] is string success)
    {
        <p role="status" class="checklist-page__notice checklist-page__notice--ok">@success</p>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <p role="alert" class="checklist-page__notice checklist-page__notice--error">@error</p>
    }

    @if (!Model.Assignments.Any())
    {
        <p class="modal-sub">Nobody is assigned to this task yet — assign someone first, then come back here to add their checklist.</p>
    }

    @foreach (var assignment in Model.Assignments.OrderBy(a => a.User?.FullName))
    {
        <section class="checklist-page__assignee">
            <h2 class="checklist-page__assignee-name">@(assignment.User?.FullName ?? "Unknown")</h2>
            <p class="modal-sub">
                Progress: @assignment.Progress% · @DTIOneLink.Services.TaskWorkflow.DisplayLabel(assignment.Status, Model.DueDate)
            </p>

            @if (assignment.ChecklistItems.Any())
            {
                <ul class="checklist-page__list">
                    @foreach (var item in assignment.ChecklistItems.OrderBy(i => i.Id))
                    {
                        <li class="checklist-page__item @(item.IsDone ? "is-done" : "")">
                            <span class="checklist-page__item-label">
                                @item.Label <span class="checklist-page__item-weight">(weight @item.Weight)</span>
                            </span>
                            <span class="checklist-page__item-state">@(item.IsDone ? "Done" : "Not done")</span>
                            <form asp-controller="Tasks" asp-action="RemoveChecklistItem" asp-route-id="@item.Id" method="post"
                                  onsubmit="return confirm('Remove this checklist item?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-cancel checklist-page__remove-btn">Remove</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="modal-sub">No checklist items yet — progress is still set by the slider.</p>
            }

            @if (assignment.ChecklistItems.Count < DTIOneLink.Services.TaskWorkflow.MaxChecklistItemsPerAssignment)
            {
                <form asp-controller="Tasks" asp-action="AddChecklistItem" method="post" class="checklist-page__add-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="taskAssignmentId" value="@assignment.Id" />
                    <input type="text" name="label" maxlength="200" required placeholder="e.g. Draft the report" class="pill-input" />
                    <input type="number" name="weight" value="1" min="1" max="10" class="pill-input checklist-page__weight-input" title="Weight" />
                    <button type="submit" class="btn-create">Add item</button>
                </form>
            }
        </section>
    }

    <a asp-controller="Tasks" asp-action="@(Model.TaskLevel == DTIOneLink.Services.TaskLevels.Subtask && Model.ParentTaskId.HasValue ? "MainTaskDetails" : "Edit")"
       asp-route-id="@(Model.ParentTaskId ?? Model.Id)" class="btn-cancel checklist-page__back">Back to task</a>
</main>
