@model DTIOneLink.Models.TaskItem
@{
    Layout = Context.Session.GetString("UserRole") == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : "~/Views/Admin/AdminLayout.cshtml";
    ViewData["Title"] = "Task Checklist";
    var taskCode = $"TASK-{Model.Id:D4}";
}

<div style="max-width:720px; margin:0 auto; padding:24px 16px;">
    <p style="color:var(--secondary,#5a6b8c); margin-bottom:4px;">@taskCode</p>
    <h1 style="margin-top:0;">@Model.TaskName</h1>
    <p style="color:var(--secondary,#5a6b8c);">
        Each assignee has their own checklist. The moment someone has any items, those items —
        not the progress slider — decide their progress. Up to @DTIOneLink.Services.TaskWorkflow.MaxChecklistItemsPerAssignment items per person.
    </p>

    @if (TempData["SuccessMessage"] is string success)
    {
        <p role="status" style="color:#0f7a3d;">@success</p>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <p role="alert" style="color:#b3261e;">@error</p>
    }

    @if (!Model.Assignments.Any())
    {
        <p>Nobody is assigned to this task yet — assign someone first, then come back here to add their checklist.</p>
    }

    @foreach (var assignment in Model.Assignments.OrderBy(a => a.User?.FullName))
    {
        <section style="border:1px solid var(--outline-variant,#dfe3ea); border-radius:12px; padding:16px; margin:16px 0;">
            <h2 style="margin:0 0 4px; font-size:17px;">@(assignment.User?.FullName ?? "Unknown")</h2>
            <p style="margin:0 0 12px; color:var(--secondary,#5a6b8c); font-size:14px;">
                Progress: @assignment.Progress% · @DTIOneLink.Services.TaskWorkflow.DisplayLabel(assignment.Status, Model.DueDate)
            </p>

            @if (assignment.ChecklistItems.Any())
            {
                <ul style="list-style:none; padding:0; margin:0 0 12px;">
                    @foreach (var item in assignment.ChecklistItems.OrderBy(i => i.Id))
                    {
                        <li style="display:flex; align-items:center; gap:8px; padding:6px 0; border-bottom:1px solid var(--outline-variant,#eef1f6);">
                            <span style="flex:1; @(item.IsDone ? "text-decoration:line-through; color:var(--secondary,#5a6b8c);" : "")">
                                @item.Label <span style="color:var(--secondary,#5a6b8c); font-size:12px;">(weight @item.Weight)</span>
                            </span>
                            <span style="font-size:12px; color:var(--secondary,#5a6b8c);">@(item.IsDone ? "Done" : "Not done")</span>
                            <form asp-controller="Tasks" asp-action="RemoveChecklistItem" asp-route-id="@item.Id" method="post"
                                  onsubmit="return confirm('Remove this checklist item?');" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-cancel" style="padding:2px 10px; font-size:12px;">Remove</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p style="color:var(--secondary,#5a6b8c); font-size:14px;">No checklist items yet — progress is still set by the slider.</p>
            }

            @if (assignment.ChecklistItems.Count < DTIOneLink.Services.TaskWorkflow.MaxChecklistItemsPerAssignment)
            {
                <form asp-controller="Tasks" asp-action="AddChecklistItem" method="post" style="display:flex; gap:8px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="taskAssignmentId" value="@assignment.Id" />
                    <input type="text" name="label" maxlength="200" required placeholder="e.g. Draft the report" class="pill-input" style="flex:1;" />
                    <input type="number" name="weight" value="1" min="1" max="10" style="width:64px;" class="pill-input" title="Weight" />
                    <button type="submit" class="btn-create" style="white-space:nowrap;">Add item</button>
                </form>
            }
        </section>
    }

    <a asp-controller="Tasks" asp-action="@(Model.TaskLevel == DTIOneLink.Services.TaskLevels.Subtask && Model.ParentTaskId.HasValue ? "MainTaskDetails" : "Edit")"
       asp-route-id="@(Model.ParentTaskId ?? Model.Id)" class="btn-cancel" style="display:inline-block; margin-top:12px;">Back to task</a>
</div>
