@model DTIOneLink.Models.RecordsOverviewViewModel
@*
    "Records Overview" card on the Admin and SuperAdmin dashboards.
    Totals only (RecordsSummaryService): each record stays visible only to
    the person who logged it, so there are no titles or links to them here.
    Styles: ~/css/records-overview.css
*@
@{
    var s = Model.Summary;
}
<section class="records-overview" aria-labelledby="recordsOverviewTitle">
    <div class="records-overview__header">
        <div>
            <h4 class="records-overview__title" id="recordsOverviewTitle">Records Overview</h4>
            <p class="records-overview__scope">@Model.ScopeLabel</p>
        </div>
        <span class="material-symbols-outlined" aria-hidden="true">folder_open</span>
    </div>

    @if (s == null)
    {
        <p class="records-overview__unavailable">Records totals couldn't be loaded right now. Please refresh the page later.</p>
    }
    else
    {
        <div class="records-overview__grid">
            <div class="records-overview__stat">
                <span class="records-overview__value">@s.LoggedThisMonth</span>
                <span class="records-overview__label">Logged this month</span>
            </div>
            <div class="records-overview__stat records-overview__stat--soon">
                <span class="records-overview__value">@s.RetentionEndingSoon</span>
                <span class="records-overview__label">Retention ends within 6 months</span>
            </div>
            <div class="records-overview__stat records-overview__stat--ended">
                <span class="records-overview__value">@s.RetentionEnded</span>
                <span class="records-overview__label">Retention ended &mdash; review for disposal</span>
            </div>
        </div>
        <p class="records-overview__note">
            @s.Total @(s.Total == 1 ? "record" : "records") in total. Totals only &mdash; each record can be opened only by the person who logged it.
        </p>
    }

    <a class="records-overview__link" href="/Records">
        Open my records <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
    </a>
</section>
