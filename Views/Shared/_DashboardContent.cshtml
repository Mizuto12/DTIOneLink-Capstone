@model IEnumerable<DTIOneLink.Models.TaskItem>
@using System.Linq
@using DTIOneLink.Services
@*
    _DashboardContent.cshtml
    ---------------------------------------------------------------------
    Admin and Employee dashboard: Task Ledger (Gantt / Kanban toggle) +
    Top Performers (Admins only).

    Pairs with:
        ~/css/admindashboard.css   (styles, incl. Gantt/Kanban blocks)
        ~/js/dashboard.js          (view toggle, Gantt paging, card clicks)

    The controller (DashboardController.AdminDashboard) already filters
    by role/employee and passes the resulting task list straight in.
*@
@{
    var tasks = Model?.ToList() ?? new List<DTIOneLink.Models.TaskItem>();

    // ---- Employee view: only their own part of each task ---------------
    // The controller already limits an Employee to tasks they are assigned
    // to. On a shared task they still only see their own name, status and
    // progress, never a co-assignee's. Admins see the whole task.
    var viewerRole = Context.Session.GetString("UserRole");
    var viewerId = Context.Session.GetInt32("UserId");
    var isEmployeeView = string.Equals(viewerRole, "Employee", StringComparison.OrdinalIgnoreCase);

    DTIOneLink.Models.TaskAssignment? MyAssignment(DTIOneLink.Models.TaskItem t) =>
        isEmployeeView ? t.Assignments?.FirstOrDefault(a => a.UserId == viewerId) : null;
    // One of the five workflow statuses. Older free-text values ("ongoing",
    // "done"...) are mapped by keyword so no task drops off the board.
    string StatusOf(DTIOneLink.Models.TaskItem t)
    {
        var s = TaskWorkflow.Normalize(MyAssignment(t)?.Status ?? t.Status);
        if (s is TaskWorkflow.Pending or TaskWorkflow.InProgress or TaskWorkflow.ForReview
            or TaskWorkflow.ReturnedForCorrection or TaskWorkflow.Completed) return s;
        if (s.Contains("complet") || s == "done") return TaskWorkflow.Completed;
        if (s.Contains("review")) return TaskWorkflow.ForReview;
        if (s.Contains("return")) return TaskWorkflow.ReturnedForCorrection;
        if (s.Contains("progress") || s.Contains("ongoing")) return TaskWorkflow.InProgress;
        return TaskWorkflow.Pending;
    }
    int ProgressOf(DTIOneLink.Models.TaskItem t) => MyAssignment(t)?.Progress ?? t.Progress;
    string? AssigneeName(DTIOneLink.Models.TaskItem t) => MyAssignment(t)?.User?.FullName ?? t.Assignee?.FullName;

    bool IsCompleted(DTIOneLink.Models.TaskItem t) => StatusOf(t) == TaskWorkflow.Completed;
    bool IsOverdue(DTIOneLink.Models.TaskItem t) => TaskWorkflow.IsOverdue(StatusOf(t), t.DueDate);
    bool IsAtRisk(DTIOneLink.Models.TaskItem t) =>
        TaskWorkflow.DelayRisk(StatusOf(t), ProgressOf(t), t.CreatedAt, t.DueDate) is { AtRisk: true };

    // ---- Statuses, in the order work moves (Kanban columns + Gantt colors)
    var statuses = new[]
    {
        (Key: TaskWorkflow.Pending,               Label: "To Do",       Tone: "todo",      Empty: "Nothing waiting to start."),
        (Key: TaskWorkflow.InProgress,            Label: "In Progress", Tone: "progress",  Empty: "Nothing in progress."),
        (Key: TaskWorkflow.ForReview,             Label: "For Review",  Tone: "review",    Empty: "Nothing waiting for review."),
        (Key: TaskWorkflow.ReturnedForCorrection, Label: "Returned",    Tone: "returned",  Empty: "Nothing returned."),
        (Key: TaskWorkflow.Completed,             Label: "Completed",   Tone: "completed", Empty: "Nothing completed yet."),
    };
    string ToneOf(DTIOneLink.Models.TaskItem t) => statuses.FirstOrDefault(s => s.Key == StatusOf(t)).Tone ?? "todo";
    string LabelOf(DTIOneLink.Models.TaskItem t) => statuses.FirstOrDefault(s => s.Key == StatusOf(t)).Label ?? "To Do";

    string TitleCase(string? s) => string.IsNullOrWhiteSpace(s) ? "" : char.ToUpper(s.Trim()[0]) + s.Trim().Substring(1).ToLowerInvariant();

    string PriorityBadgeClass(string? priority) => (priority ?? "").Trim().ToLowerInvariant() switch
    {
        "high" => "priority-badge priority-badge--high",
        "medium" => "priority-badge priority-badge--medium",
        _ => "priority-badge priority-badge--low"
    };

    string Initials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "?";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(p => char.IsLetter(p[0])).ToArray();
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : fullName.Substring(0, Math.Min(2, fullName.Length)).ToUpper();
    }

    var today = TimeZoneHelper.PhilippineToday;
    string DueText(DateTime due)
    {
        var days = (due.Date - today).Days;
        return days switch
        {
            < -1 => $"{-days} days late",
            -1 => "1 day late",
            0 => "Due today",
            1 => "Due tomorrow",
            _ => $"Due {due:MMM d}"
        };
    }

    // ---- Gantt timeline -------------------------------------------------
    // No StartDate on the model, so each bar runs from CreatedAt (stored in
    // UTC) to the end of its DueDate. The scale covers whole months from
    // the earliest start to the latest due date, always including today.
    DateTime StartOf(DTIOneLink.Models.TaskItem t) => TimeZoneHelper.ToPhilippineTime(t.CreatedAt).Date;

    var firstDay = tasks.Any() ? tasks.Min(StartOf) : today;
    var lastDay = tasks.Any() ? tasks.Max(t => t.DueDate.Date) : today;
    if (today < firstDay) firstDay = today;
    if (today > lastDay) lastDay = today;
    var timelineStart = new DateTime(firstDay.Year, firstDay.Month, 1);
    var timelineEnd = new DateTime(lastDay.Year, lastDay.Month, 1).AddMonths(1); // exclusive
    var totalDays = Math.Max((timelineEnd - timelineStart).TotalDays, 1);

    var months = new List<(string Label, int Days)>();
    for (var m = timelineStart; m < timelineEnd; m = m.AddMonths(1))
    {
        months.Add((m.ToString("MMM yyyy"), DateTime.DaysInMonth(m.Year, m.Month)));
    }
    string Pct(double value) => value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    var todayPct = Pct(((today - timelineStart).TotalDays + 0.5) / totalDays * 100);

    // Unfinished work first (soonest due on top), completed work last.
    var ganttTasks = tasks
        .OrderBy(t => IsCompleted(t))
        .ThenBy(t => t.DueDate)
        .ToList();

    // ---- Top performers (Admins only; it ranks co-workers) --------------
    var performerAvatarColors = new[] { "performer-avatar", "performer-avatar--alt", "performer-avatar--secondary" };
    var performerMetricColors = new[] { "performer-metric--tertiary", "performer-metric--primary", "performer-metric--secondary" };

    var topPerformers = tasks
        .Where(t => !isEmployeeView && t.Assignee != null)
        .GroupBy(t => t.Assignee)
        .Select(g => new { Assignee = g.Key, Total = g.Count(), Completed = g.Count(t => IsCompleted(t)) })
        .Select(p => new { p.Assignee, p.Total, p.Completed, Efficiency = p.Total > 0 ? (int)Math.Round(p.Completed * 100.0 / p.Total) : 0 })
        .OrderByDescending(p => p.Efficiency)
        .ThenByDescending(p => p.Total)
        .Take(3)
        .ToList();
}

<div class="dashboard">

    <!-- ============================= CENTER COLUMN ============================= -->
    <div class="dashboard__center custom-scrollbar">

        <!-- Task Ledger -->
        <section class="ledger">
            <div class="ledger__header">
                <div class="ledger__title-group">
                    <span class="material-symbols-outlined">task_alt</span>
                    <div>
                        <h3 class="ledger__title">@(isEmployeeView ? "My Tasks" : "Task Ledger")</h3>
                        <p class="ledger__sub">
                            @tasks.Count task@(tasks.Count == 1 ? "" : "s") · Click any task to open it.
                        </p>
                    </div>
                </div>
                <div class="ledger__view-switcher" role="tablist" aria-label="Ledger view">
                    <button type="button" id="btnGanttView" class="view-switch-btn is-active" role="tab" aria-selected="true">Timeline</button>
                    <button type="button" id="btnKanbanView" class="view-switch-btn" role="tab" aria-selected="false">Board</button>
                </div>
            </div>

            <!-- Gantt view -->
            <div id="ganttView" class="ledger__body">
                @if (!tasks.Any())
                {
                    <div class="empty-state">No tasks to display yet.</div>
                }
                else
                {
                    <div class="gantt-legend" aria-hidden="true">
                        @foreach (var s in statuses)
                        {
                            <span><span class="gantt-legend__swatch tone-@s.Tone"></span>@s.Label</span>
                        }
                        <span><span class="gantt-legend__swatch gantt-legend__swatch--overdue"></span>Overdue</span>
                        <span><span class="gantt-legend__today"></span>Today</span>
                    </div>

                    <div class="gantt">
                        <div class="gantt-header">
                            <div class="gantt-header__task-col">Task</div>
                            <div class="gantt-header__months">
                                @foreach (var m in months)
                                {
                                    <div class="gantt-header__month" style="flex-grow:@m.Days;">@m.Label</div>
                                }
                            </div>
                        </div>

                        <div class="gantt-body">
                            @* Month gridlines and today's line, drawn behind the bars. *@
                            <div class="gantt-grid" aria-hidden="true">
                                @foreach (var m in months)
                                {
                                    <div class="gantt-grid__month" style="flex-grow:@m.Days;"></div>
                                }
                                <div class="gantt-today" style="left:@todayPct%;"><span>Today</span></div>
                            </div>

                            <div class="gantt-rows">
                                @foreach (var task in ganttTasks)
                                {
                                    var start = StartOf(task);
                                    var end = task.DueDate.Date.AddDays(1);
                                    if (end <= start) end = start.AddDays(1);
                                    var leftPct = Pct((start - timelineStart).TotalDays / totalDays * 100);
                                    var widthPct = Pct(Math.Max((end - start).TotalDays / totalDays * 100, 1.5));
                                    var overdue = IsOverdue(task);
                                    var progress = ProgressOf(task);
                                    <div class="gantt-row" data-href="@Url.Action("Details", "Dashboard", new { id = task.Id })"
                                         role="link" tabindex="0" aria-label="Open @task.TaskName">
                                        <div class="gantt-row__info">
                                            <div class="avatar-badge">@Initials(AssigneeName(task))</div>
                                            <div class="gantt-row__text">
                                                <p class="gantt-row__name" title="@task.TaskName">@task.TaskName</p>
                                                <p class="gantt-row__meta">
                                                    <span>@(AssigneeName(task) ?? "Unassigned")</span>
                                                    <span class="gantt-row__due @(overdue ? "is-late" : "")">
                                                        @(IsCompleted(task) ? $"Due {task.DueDate:MMM d}" : DueText(task.DueDate))
                                                    </span>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="gantt-row__track">
                                            <div class="gantt-bar tone-@ToneOf(task) @(overdue ? "is-overdue" : "")"
                                                 style="left:@leftPct%; width:@widthPct%;"
                                                 title="@LabelOf(task) · @progress% done · @start.ToString("MMM d") – @task.DueDate.ToString("MMM d, yyyy")">
                                                <div class="gantt-bar__fill" style="width:@progress%;"></div>
                                                <span class="gantt-bar__label">@(overdue ? "Overdue" : LabelOf(task)) · @progress%</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @* Filled in by dashboard.js — shows 4 tasks per page. *@
                    <div class="gantt-pager" id="ganttPager" hidden>
                        <span class="gantt-pager__info" id="ganttPagerInfo"></span>
                        <div class="gantt-pager__buttons">
                            <button type="button" class="btn-pill" id="ganttPrev">
                                <span class="material-symbols-outlined">chevron_left</span> Previous
                            </button>
                            <button type="button" class="btn-pill" id="ganttNext">
                                Next <span class="material-symbols-outlined">chevron_right</span>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Kanban view -->
            <div id="kanbanView" class="ledger__body is-hidden">
                <div class="kanban-board">
                    @foreach (var s in statuses)
                    {
                        var columnTasks = tasks.Where(t => StatusOf(t) == s.Key)
                            .OrderByDescending(IsOverdue)
                            .ThenBy(t => t.DueDate)
                            .ToList();
                        if (s.Key == TaskWorkflow.Completed)
                        {
                            columnTasks = columnTasks.OrderByDescending(t => t.DueDate).ToList(); // most recent first
                        }
                        <div class="kanban-column tone-@s.Tone">
                            <div class="kanban-column__header">
                                <span class="kanban-column__dot"></span>
                                <h4 class="kanban-column__title">@s.Label</h4>
                                <span class="kanban-column__count">@columnTasks.Count</span>
                            </div>
                            <div class="kanban-column__cards">
                                @if (!columnTasks.Any())
                                {
                                    <p class="kanban-column__empty">@s.Empty</p>
                                }
                                @foreach (var task in columnTasks)
                                {
                                    var overdue = IsOverdue(task);
                                    var progress = ProgressOf(task);
                                    <div class="kanban-card @(overdue ? "is-overdue" : "")" data-href="@Url.Action("Details", "Dashboard", new { id = task.Id })"
                                         role="link" tabindex="0" aria-label="Open @task.TaskName">
                                        <div class="kanban-card__top">
                                            @if (!string.IsNullOrWhiteSpace(task.Priority))
                                            {
                                                <span class="@PriorityBadgeClass(task.Priority)">@TitleCase(task.Priority)</span>
                                            }
                                            @if (overdue)
                                            {
                                                <span class="kanban-tag kanban-tag--overdue">Overdue</span>
                                            }
                                            else if (IsAtRisk(task))
                                            {
                                                <span class="kanban-tag kanban-tag--risk">At risk</span>
                                            }
                                        </div>
                                        <h5 class="kanban-card__title">@task.TaskName</h5>
                                        @if (!string.IsNullOrWhiteSpace(task.Description))
                                        {
                                            <p class="kanban-card__desc">@task.Description</p>
                                        }
                                        <div class="kanban-card__progress" title="@progress% done">
                                            <div class="kanban-card__bar"><div style="width:@progress%;"></div></div>
                                            <span>@progress%</span>
                                        </div>
                                        <div class="kanban-card__footer">
                                            <span class="kanban-card__person">
                                                <span class="avatar-badge avatar-badge--sm">@Initials(AssigneeName(task))</span>
                                                <span class="kanban-card__assignee-name">@(AssigneeName(task) ?? "Unassigned")</span>
                                            </span>
                                            <span class="kanban-card__due @(overdue ? "is-late" : "")">
                                                @(IsCompleted(task) ? $"Due {task.DueDate:MMM d}" : DueText(task.DueDate))
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        @if (!isEmployeeView)
        {
        <!-- Top Performers -->
        <section class="performers">
            <div class="performers__header">
                <h4 class="performers__title">Top Performers</h4>
                <span class="material-symbols-outlined">military_tech</span>
            </div>
            <div class="performers__grid">
                @if (!topPerformers.Any())
                {
                    <div class="empty-state">No performance data yet.</div>
                }
                @for (int i = 0; i < topPerformers.Count; i++)
                {
                    var performer = topPerformers[i];
                    <div class="performer-card">
                        <div class="performer-avatar @performerAvatarColors[i % performerAvatarColors.Length]">@Initials(performer.Assignee!.FullName)</div>
                        <div>
                            <p class="performer-name">@performer.Assignee!.FullName</p>
                            <span class="performer-metric @performerMetricColors[i % performerMetricColors.Length]">@performer.Efficiency% Efficiency</span>
                        </div>
                    </div>
                }
            </div>
        </section>
        }
    </div>
</div>
