@* Shared <head> boilerplate for the three authenticated shells (Admin,
   Employee, SuperAdmin). Each layout still opens/closes its own <head> and
   calls RenderSectionAsync("Styles", ...) itself afterward — sections
   aren't visible from inside a partial, only from the Layout page that
   actually renders them. *@
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - DTI Laguna OneLink</title>
<link rel="icon" type="image/png" href="~/images/dti-logo.png" asp-append-version="true" />
<link rel="manifest" href="~/manifest.json" />

<link rel="preload" href="/fonts/material-symbols/MaterialSymbolsOutlined.woff2?v=2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/css/fonts.css" asp-append-version="true" />
@* Hide icons until their font is ready (see fonts.css); give up after 10s. *@
<script>
    (function (root) {
        root.classList.add("icons-loading");
        var ready = function () { root.classList.remove("icons-loading"); };
        if (!document.fonts || !document.fonts.load) { ready(); return; }
        document.fonts.load("24px 'Material Symbols Outlined'").then(ready, ready);
        setTimeout(ready, 10000);
    })(document.documentElement);
</script>
<link rel="stylesheet" href="~/css/adminlayout.css" asp-append-version="true" />
