@using DTIOneLink.Helpers
@model IEnumerable<DTIOneLink.Models.UserItem>
@{
    Layout = Context.Session.GetString("UserRole") == "SuperAdmin"
        ? "~/Views/SuperAdmin/SuperAdminLayout.cshtml"
        : "~/Views/Admin/AdminLayout.cshtml";
    ViewData["Title"] = "User Management";
    ViewData["LiveRefresh"] = true; // auto-refresh when data changes (live-refresh.js)
    // Only the OPD can change someone's role or division (checked again in the controller).
    var canChangeStanding = Context.Session.GetString("UserRole") == "SuperAdmin";
    var currentUserId = Context.Session.GetInt32("UserId");
    var currentRole = Context.Session.GetString("UserRole");
    var currentDepartment = Context.Session.GetString("UserDepartment");

    // Values typed before a failed save, so the form doesn't come back empty.
    var formEmail = TempData["FormEmail"] as string;
    var formFullName = TempData["FormFullName"] as string;
    var formDepartment = TempData["FormDepartment"] as string;
    var formRole = TempData["FormRole"] as string;
    var emailError = TempData["EmailError"] as string;
    var nameError = TempData["NameError"] as string;
    var highlightUserId = TempData["HighlightUserId"] as int?;
    var openTasks = ViewData["OpenTasks"] as Dictionary<int, int> ?? new();

    // "today", "yesterday", "3 days ago", or a date (Philippine time).
    string LastSeen(DateTime utc)
    {
        var local = DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(utc);
        var days = (DTIOneLink.Services.TimeZoneHelper.PhilippineToday - local.Date).Days;
        return days <= 0 ? "today, " + local.ToString("h:mm tt")
             : days == 1 ? "yesterday"
             : days < 30 ? $"{days} days ago"
             : "on " + local.ToString("MMM d, yyyy");
    }

    // Short names used on the division buttons.
    var divisionShort = new Dictionary<string, string>
    {
        ["Business Development Division"] = "BDD",
        ["Consumer Protection Division"] = "CPD",
        ["Financial and Administrative Unit"] = "FAU",
    };

    // Plain-language meaning of each role, shown on the role choices.
    var roleHelp = new Dictionary<string, (string Title, string Help)>
    {
        ["Employee"] = ("Employee", "Works on the tasks given to them."),
        ["Admin"] = ("Admin (Division Chief)", "Assigns tasks to the employees of their division."),
        ["SuperAdmin"] = ("Super Admin (OPD)", "Gives tasks to all divisions and manages accounts."),
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/user-management.css" asp-append-version="true" />
}

<!-- ── Page Header ─────────────────────────────────────── -->

<!-- ── Module header: ties the two panes together ─────── -->
<div class="um-module-head">
    <div>
        <h2 class="um-module-title">User Management</h2>
        <p class="um-module-sub">@(canChangeStanding ? "Manage user accounts, roles, and access permissions." : "Manage user accounts and access permissions.")</p>
    </div>
</div>

<!-- ── Two-pane layout ────────────────────────────────── -->
<div class="um-layout">

    <!-- Left: Add Microsoft Account form -->
    <section class="um-pane um-form-pane">
        <div class="um-section-head">
            <div class="um-section-icon">
                <span class="material-symbols-outlined">person_add</span>
            </div>
            <div>
                <h3 class="um-section-title">Add a New Account</h3>
                <p class="um-section-desc">Fill in the details to create a staff account</p>
            </div>
        </div>

        <form id="addUserForm" asp-controller="UserManagement" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <p class="um-form-success um-notice"><span>@successMessage</span><button type="button" class="um-notice-close" aria-label="Dismiss"><span class="material-symbols-outlined">close</span></button></p>
            }
            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <p class="um-form-error um-notice"><span>@errorMessage</span><button type="button" class="um-notice-close" aria-label="Dismiss"><span class="material-symbols-outlined">close</span></button></p>
            }

            <div class="um-field-grid">
            <!-- Official Outlook -->
            <div class="um-field-group">
                <label class="um-label" for="newUserEmail">Official Outlook Email</label>
                <div class="um-input-wrap">
                    <span class="material-symbols-outlined um-input-icon">mail</span>
                    <input class="um-input@(emailError != null ? " um-input-invalid" : "")" name="Email" type="email" id="newUserEmail"
                           value="@formEmail" placeholder="official.user@outlook.com" required />
                </div>
                <p class="um-field-error" id="newUserEmailError" hidden="@(emailError == null)">@emailError</p>
            </div>

            <!-- Full Name -->
            <div class="um-field-group">
                <label class="um-label" for="newUserFullName">Full Name</label>
                <div class="um-input-wrap">
                    <span class="material-symbols-outlined um-input-icon">badge</span>
                    <input class="um-input@(nameError != null ? " um-input-invalid" : "")" name="FullName" type="text" id="newUserFullName" data-capitalize="title"
                           value="@formFullName" placeholder="Juan Dela Cruz" required />
                </div>
                <p class="um-field-error" id="newUserFullNameError" hidden="@(nameError == null)">@nameError</p>
            </div>

            <!-- Role -->
            <div class="um-field-group">
                <label class="um-label" for="newUserRole">Role</label>
                <div class="um-input-wrap um-select-wrap">
                    <span class="material-symbols-outlined um-input-icon" aria-hidden="true">manage_accounts</span>
                    <select class="um-select um-role-select" name="Role" id="newUserRole" data-help="newUserRoleHelp" required>
                        <option value="">Select Role</option>
                        @foreach (var role in roleHelp.Keys)
                        {
                            <option value="@role" data-help="@roleHelp[role].Help" selected="@(role == formRole)">@roleHelp[role].Title</option>
                        }
                    </select>
                    <span class="material-symbols-outlined um-select-caret" aria-hidden="true">expand_more</span>
                </div>
                <p class="um-role-help" id="newUserRoleHelp"></p>
            </div>

            <!-- Division -->
            <div class="um-field-group">
                <label class="um-label" for="newUserDepartment">Division</label>
                <div class="um-input-wrap um-select-wrap">
                    <span class="material-symbols-outlined um-input-icon" aria-hidden="true">group</span>
                    <select class="um-select" name="Department" id="newUserDepartment" required>
                        <option value="">Select Division</option>
                        @foreach (var division in DTIOneLink.Controllers.UserManagementController.Divisions)
                        {
                            <option value="@division" selected="@(division == formDepartment)">@division</option>
                        }
                    </select>
                    <span class="material-symbols-outlined um-select-caret" aria-hidden="true">expand_more</span>
                </div>
            </div>
            </div>

            <div class="um-form-actions">
            <p class="um-default-password-note">
                <span class="material-symbols-outlined">key</span>
                <span>They will sign in with this email and the default password <strong>@DTIOneLink.Security.AccountDefaults.DefaultPassword</strong>. On their first sign-in they confirm their email with a code and choose their own password.</span>
            </p>

            <div class="um-form-foot">
                <button class="um-btn-save" type="submit" id="saveBtn">
                    SAVE ACCOUNT
                    <span class="material-symbols-outlined">check_circle</span>
                </button>
            </div>
            </div>
        </form>
    </section>

    <!-- Right: Administrative Directory table -->
    <section class="um-pane um-table-pane">
        <div class="um-table-header">
            <div class="um-table-title-row">
                <div class="um-section-icon">
                    <span class="material-symbols-outlined">groups</span>
                </div>
                <div>
                    <h3 class="um-section-title">All Accounts</h3>
                    <p class="um-section-desc">@(canChangeStanding ? "Manage each account's role, division and access" : "Manage staff accounts and their access")</p>
                </div>
            </div>
            <div class="um-total-badge">
                <span class="um-total-label">Total:</span>
                <span class="um-total-count" id="totalUsersCount">@(Model?.Count() ?? 0) Users</span>
            </div>
        </div>

        @if (TempData["DirectoryMessage"] is string directoryMessage)
        {
            <p class="um-form-success um-directory-banner um-notice">
                <span class="material-symbols-outlined">check_circle</span>
                <span>@directoryMessage</span>
                <button type="button" class="um-notice-close" aria-label="Dismiss"><span class="material-symbols-outlined">close</span></button>
            </p>
        }
        @if (TempData["TempPassword"] is string tempPassword)
        {
            @* Shown once only: it is not stored anywhere readable. *@
            <div class="um-form-success um-directory-banner um-temp-password" role="status">
                <span class="material-symbols-outlined">key</span>
                <div>
                    <p>Temporary password for <strong>@TempData["TempPasswordFor"]</strong>:</p>
                    <p class="um-temp-password-value">@tempPassword</p>
                    <p>Give it to them in person or by phone. It is shown only this once. They must choose their own password when they log in with it.</p>
                </div>
            </div>
        }
        @if (TempData["DirectoryError"] is string directoryError)
        {
            <p class="um-form-error um-directory-banner um-notice">
                <span class="material-symbols-outlined">error</span>
                <span>@directoryError</span>
                @if (TempData["DirectoryErrorTaskLink"] is string directoryErrorTaskLink)
                {
                    <a href="@directoryErrorTaskLink" class="um-directory-banner-link">@TempData["DirectoryErrorTaskLinkLabel"]</a>
                }
                <button type="button" class="um-notice-close" aria-label="Dismiss"><span class="material-symbols-outlined">close</span></button>
            </p>
        }

        <!-- Search bar -->
        <div class="um-search-bar">
            <span class="material-symbols-outlined um-search-icon">search</span>
            <input type="search" class="um-search-input" id="userSearchInput"
                   placeholder="Search by Name, Email, Division or Role"
                   aria-label="Search accounts" />
            <button type="button" class="um-search-clear" id="userSearchClear" hidden aria-label="Clear search">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="um-table-scroll">
            <table class="um-table" id="userTable">
                @* Fixed proportional widths so long values never move the columns. *@
                <colgroup>
                    <col class="um-col-name" /><col class="um-col-email" /><col class="um-col-division" />
                    <col class="um-col-role" /><col class="um-col-status" /><col class="um-col-action" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Division</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {var initials = DisplayHelpers.GetInitials(user.FullName, user.Username);
                            var isActive = string.Equals(user.Status, "active", StringComparison.OrdinalIgnoreCase);
                            <tr class="um-row@(isActive ? "" : " um-row-disabled")@(user.Id == highlightUserId ? " um-row-highlight" : "")"
                                data-user-id="@user.Id"
                                data-name="@user.FullName" data-email="@user.Email"
                                data-role="@user.Role" data-department="@user.Department" data-active="@(isActive ? "1" : "0")"
                                data-search="@($"{user.FullName} {user.Email} {user.Department} {DTIOneLink.Controllers.UserManagementController.RoleLabel(user.Role)}".ToLowerInvariant())">
                                <td class="um-td-name">
                                    <div class="um-name-cell">
                                        <div class="um-avatar um-av-blue">@initials</div>
                                        <span class="um-ell" title="@user.FullName">@user.FullName</span>
                                    </div>
                                </td>
                                <td class="um-td-muted um-td-email" data-label="Email"><span class="um-ell" title="@user.Email">@user.Email</span></td>
                                <td class="um-td-division" data-label="Division"><span class="um-division-badge um-ell" title="@user.Department">@user.Department</span></td>
                                <td class="um-td-role" data-label="Role"><span class="um-ell" title="@DTIOneLink.Controllers.UserManagementController.RoleLabel(user.Role)">@DTIOneLink.Controllers.UserManagementController.RoleLabel(user.Role)</span></td>
                                <td class="um-td-status" data-label="Status">
                                    @* Deactivated wins; then signed in right now; then signed out (or never signed in). *@
                                    @if (!isActive)
                                    {
                                        <div class="um-status-badge um-status-disabled">
                                            <span class="um-status-dot"></span>
                                            <span>Deactivated</span>
                                        </div>
                                    }
                                    else if (user.IsSignedIn)
                                    {
                                        <div class="um-status-badge um-status-active" title="Signed in and using DTI OneLink now.">
                                            <span class="um-status-dot um-dot-pulse"></span>
                                            <span>Signed in</span>
                                        </div>
                                    }
                                    else if (user.LastLoginAtUtc != null)
                                    {
                                        var lastSeen = user.LastSeenAtUtc ?? user.LastLoginAtUtc.Value;
                                        <div class="um-status-badge um-status-pending" title="Signed out, or inactive for over 30 minutes.">
                                            <span class="um-status-dot"></span>
                                            <span>Signed out</span>
                                        </div>
                                        <span class="um-last-login" title="@DTIOneLink.Services.TimeZoneHelper.ToPhilippineTime(lastSeen).ToString("MMM d, yyyy h:mm tt")">Last active @LastSeen(lastSeen)</span>
                                    }
                                    else
                                    {
                                        <div class="um-status-badge um-status-pending" title="This account was created but the person hasn't signed in yet.">
                                            <span class="um-status-dot"></span>
                                            <span>Not signed in yet</span>
                                        </div>
                                    }
                                </td>
                                <td class="um-td-actions">
                                    @if (user.Id == currentUserId)
                                    {
                                        <span class="um-td-muted">You</span>
                                    }
                                    else
                                    {
                                        var userOpen = openTasks.TryGetValue(user.Id, out var open) ? open : 0;
                                        <div class="um-actions">
                                            @if (canChangeStanding)
                                            {
                                                <button type="button" class="um-btn-change"
                                                        data-user-id="@user.Id"
                                                        data-user-name="@user.FullName"
                                                        data-user-role="@user.Role"
                                                        data-user-department="@user.Department"
                                                        data-open-tasks="@userOpen"
                                                        aria-label="Change role or division of @user.FullName" title="Change Role">
                                                    <span class="material-symbols-outlined" aria-hidden="true">manage_accounts</span>
                                                    <span class="um-btn-txt">Change Role</span>
                                                </button>
                                            }
                                            @if (DTIOneLink.Controllers.UserManagementController.CanSetActive(currentRole, currentDepartment, currentUserId, user.Id, user.Role, user.Department))
                                            {
                                                @* Confirmed in #statusDialog (user-management.js). Deactivation
                                                   is refused while they still have unfinished work. *@
                                                <form asp-controller="UserManagement" asp-action="SetActive" method="post"
                                                      class="um-status-form"
                                                      data-action="@(isActive ? "deactivate" : "reactivate")"
                                                      data-user-name="@user.FullName"
                                                      data-open-tasks="@userOpen"
                                                      data-tasks-url="@Url.Action("Index", "Tasks", new { employeeId = user.Id })">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <input type="hidden" name="active" value="@(isActive ? "false" : "true")" />
                                                    <button type="submit" class="um-btn-status @(isActive ? "um-btn-deactivate" : "um-btn-reactivate")"
                                                            title="@(isActive ? "Deactivate" : "Reactivate")" aria-label="@(isActive ? "Deactivate" : "Reactivate") @user.FullName">
                                                        <span class="material-symbols-outlined" aria-hidden="true">@(isActive ? "person_off" : "person_check")</span>
                                                        <span class="um-btn-txt">@(isActive ? "Deactivate" : "Reactivate")</span>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    <tr id="userNoMatch" hidden>
                        <td colspan="6" class="um-empty-row">
                            <div class="um-empty-state">
                                <span class="material-symbols-outlined um-empty-icon">search_off</span>
                                <p class="um-empty-text">No accounts match your search</p>
                                <p class="um-empty-sub">Check the spelling, or clear the search to see everyone.</p>
                            </div>
                        </td>
                    </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="um-empty-row">
                                <div class="um-empty-state">
                                    <span class="material-symbols-outlined um-empty-icon">person_off</span>
                                    <p class="um-empty-text">No users found</p>
                                    <p class="um-empty-sub">Use "Add a New Account" to get started.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="um-pagination-bar">
            <span class="um-pagination-info" id="paginationInfo" aria-live="polite"></span>
            <div class="um-pagination-btns" id="paginationBtns"></div>
        </div>
    </section>

</div>

@if (canChangeStanding)
{
    <!-- Change role / division (OPD only) -->
    <dialog id="changeStandingDialog" class="um-dialog" aria-labelledby="csTitle">
        <form asp-controller="UserManagement" asp-action="ChangeStanding" method="post" id="csForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="csUserId" />
            <!-- Filled in from the division buttons (or OPD for a Super Admin). -->
            <input type="hidden" name="department" id="csDepartment" />

            <div class="um-dialog-head">
                <h3 class="um-section-title" id="csTitle">Change Role or Division</h3>
                <button type="button" class="um-dialog-close" id="csClose" aria-label="Close">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="um-dialog-person">
                <div class="um-avatar um-av-blue" id="csInitials"></div>
                <div>
                    <p class="um-dialog-name" id="csUserName"></p>
                    <p class="um-dialog-current">Currently: <strong id="csCurrent"></strong></p>
                </div>
            </div>

            <div class="um-field-group">
                <label class="um-label" for="csRole">Step 1 · Role</label>
                <select class="um-select um-role-select" name="role" id="csRole" data-help="csRoleHelp" required>
                    @foreach (var role in roleHelp.Keys)
                    {
                        <option value="@role" data-help="@roleHelp[role].Help">@roleHelp[role].Title</option>
                    }
                </select>
                <p class="um-role-help" id="csRoleHelp"></p>
            </div>

            <div class="um-field-group">
                <label class="um-label" for="csDivision">Step 2 · Division</label>
                <select class="um-select" id="csDivision" required>
                    @foreach (var division in DTIOneLink.Controllers.UserManagementController.Divisions)
                    {
                        <option value="@division">@division</option>
                    }
                </select>
            </div>
            <p class="um-dialog-opd-note" id="csOpdNote" hidden>
                <span class="material-symbols-outlined">info</span>
                <span>A Super Admin is always in the <strong>Office of the Provincial Director</strong>.</span>
            </p>

            <!-- Before -> After, and anything worth knowing before saving -->
            <div class="um-dialog-preview" id="csPreview" hidden>
                <div class="um-preview-row">
                    <span class="um-preview-box" id="csBefore"></span>
                    <span class="material-symbols-outlined um-preview-arrow">arrow_forward</span>
                    <span class="um-preview-box um-preview-after" id="csAfter"></span>
                </div>
            </div>
            <ul class="um-dialog-warnings" id="csWarnings"></ul>
            <p class="um-dialog-hint" id="csHint">Choose a new role or division above.</p>

            <div class="um-dialog-actions">
                <button type="button" class="um-btn-cancel" id="csCancel">Cancel</button>
                <button type="submit" class="um-btn-save" id="csSave" disabled>Save changes</button>
            </div>
        </form>
    </dialog>
}

<!-- Correct a mistyped email (same people you can deactivate) -->
<dialog id="editEmailDialog" class="um-dialog" aria-labelledby="eeTitle">
    <form asp-controller="UserManagement" asp-action="EditEmail" method="post" id="eeForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="eeUserId" />

        <div class="um-dialog-head">
            <h3 class="um-section-title" id="eeTitle">Edit Email</h3>
            <button type="button" class="um-dialog-close" id="eeClose" aria-label="Close">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <p class="um-dialog-name" id="eeUserName"></p>

        <div class="um-field-group">
            <label class="um-label" for="eeEmail">New email</label>
            <div class="um-input-wrap">
                <span class="material-symbols-outlined um-input-icon">mail</span>
                <input class="um-input" name="email" type="email" id="eeEmail" required maxlength="256" />
            </div>
        </div>
        <p class="um-dialog-note">They will log in with the new email and confirm it with a code at their next sign-in. They are signed out now.</p>

        <div class="um-dialog-actions">
            <button type="button" class="um-btn-cancel" id="eeCancel">Cancel</button>
            <button type="submit" class="um-btn-save" id="eeSave">Save email</button>
        </div>
    </form>
</dialog>

<!-- Deactivate / Reactivate confirmation (and "can't deactivate yet") -->
<dialog id="statusDialog" class="um-dialog um-status-dialog" aria-labelledby="sdTitle" aria-describedby="sdMessage">
    <button type="button" class="um-dialog-close um-status-close" id="sdClose" aria-label="Close">
        <span class="material-symbols-outlined">close</span>
    </button>
    <div class="um-status-heading">
        <span class="um-status-icon material-symbols-outlined" id="sdIcon" aria-hidden="true"></span>
        <h3 class="um-section-title" id="sdTitle"></h3>
    </div>

    <div class="um-dialog-person">
        <div class="um-avatar um-av-blue" id="sdInitials"></div>
        <p class="um-dialog-name" id="sdUserName"></p>
    </div>

    <p class="um-status-message" id="sdMessage"></p>
    <ul class="um-status-points" id="sdPoints"></ul>

    <div class="um-dialog-actions">
        <button type="button" class="um-btn-cancel" id="sdCancel">Cancel</button>
        <button type="button" class="um-btn-save" id="sdConfirm"></button>
        <a class="um-btn-save" id="sdTasksLink" href="#">
            <span class="material-symbols-outlined">assignment</span>
            View their tasks
        </a>
    </div>
</dialog>

@section Scripts {
    <script src="~/js/user-management.js" asp-append-version="true"></script>
}
